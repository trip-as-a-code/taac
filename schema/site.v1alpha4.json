{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taac Site",
  "description": "The deployment: which trips it serves and who may see them.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/ApiVersion"
    },
    "kind": {
      "$ref": "#/$defs/SiteKind"
    },
    "metadata": {
      "$ref": "#/$defs/SiteMetadata"
    },
    "trips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SiteTrip"
      }
    },
    "access": {
      "description": "Password-protects the whole site.",
      "anyOf": [
        {
          "$ref": "#/$defs/Access"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "description": "Where the trip files live, so the site can link each entry to its line.",
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRepo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "trips"
  ],
  "$defs": {
    "ApiVersion": {
      "type": "string",
      "enum": [
        "taac/v1alpha4"
      ]
    },
    "SiteKind": {
      "type": "string",
      "enum": [
        "Site"
      ]
    },
    "SiteMetadata": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Text": {
      "description": "Text shown in the interface: one string for every language, or one per\nlanguage (`{ en: …, ru: … }`), falling back to English, then the first.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "SiteTrip": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Trip file or directory, relative to the site file.",
          "type": "string"
        },
        "access": {
          "description": "Password-protects this trip only.",
          "anyOf": [
            {
              "$ref": "#/$defs/Access"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "Access": {
      "type": "object",
      "properties": {
        "password": {
          "description": "Worker secret holding the password.",
          "$ref": "#/$defs/Secret"
        }
      },
      "additionalProperties": false,
      "required": [
        "password"
      ]
    },
    "Secret": {
      "description": "A confidential value, resolved by name from `.env`, `secrets.yaml` or the\nenvironment. Only local builds run with `--reveal` ever see it.",
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "secret"
      ]
    },
    "SourceRepo": {
      "description": "A repository browsable on the web (GitHub, Gitea, Forgejo, GitLab:\n`<repo>/blob/<branch>/<path>#L<line>`).",
      "type": "object",
      "properties": {
        "repo": {
          "description": "Web URL of the repository, such as `https://github.com/you/trips`.",
          "type": "string"
        },
        "branch": {
          "type": "string",
          "default": "main"
        },
        "dir": {
          "description": "Directory of the site file inside the repository; empty for the root.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false,
      "required": [
        "repo"
      ]
    }
  }
}
