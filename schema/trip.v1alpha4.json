{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taac Trip",
  "description": "One YAML file of a trip. Nothing in it needs an id: people, groups and\nblockers are referred to by name or title, places by their key (which is\ntheir name). A trip is a single `kind: Trip` file, or a\ndirectory holding one `kind: Trip` file plus any number of `kind: TripPart`\nfiles whose bases, places, itinerary, ideas, tasks, passes, packing and overlays are\nmerged into it.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/ApiVersion"
    },
    "kind": {
      "$ref": "#/$defs/TripKind"
    },
    "metadata": {
      "description": "Required on `kind: Trip`, forbidden on `kind: TripPart`.",
      "anyOf": [
        {
          "$ref": "#/$defs/TripMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Member"
      }
    },
    "groups": {
      "description": "Named subsets of members travelling together (tracks).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "bases": {
      "description": "Where people are, day by day, whether or not anything is planned.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Base"
      }
    },
    "places": {
      "description": "Reusable places by name; plans, bases and ideas refer to them by it.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Place"
      }
    },
    "itinerary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "ideas": {
      "description": "Unscheduled things to pick from on the spot.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Idea"
      }
    },
    "blockers": {
      "description": "Time someone is unavailable (work, a call): whole days or a window.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Blocker"
      }
    },
    "tasks": {
      "description": "What has to get done before, during or after the trip: a visa, a\npass to pick up, expenses to file.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Task"
      }
    },
    "passes": {
      "description": "Tickets, passes and rentals for getting around an area for a while.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pass"
      }
    },
    "packing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PackingCategory"
      }
    },
    "map": {
      "anyOf": [
        {
          "$ref": "#/$defs/MapConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind"
  ],
  "$defs": {
    "ApiVersion": {
      "type": "string",
      "enum": [
        "taac/v1alpha4"
      ]
    },
    "TripKind": {
      "type": "string",
      "enum": [
        "Trip",
        "TripPart"
      ]
    },
    "TripMetadata": {
      "type": "object",
      "properties": {
        "slug": {
          "description": "URL slug; defaults to the trip's file or directory name.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "description": "BCP 47 language of the trip's own text (titles, notes), e.g. `en`, `ru`.",
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "description": "IANA time zone of the destination, e.g. `Asia/Tokyo`.",
          "type": "string"
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cover"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "timezone"
      ]
    },
    "Cover": {
      "type": "object",
      "properties": {
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "hue": {
          "description": "Hue (0–360) of the generated cover gradient.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 360
        }
      },
      "additionalProperties": false
    },
    "CurrencyConfig": {
      "type": "object",
      "properties": {
        "base": {
          "description": "ISO 4217 code totals and settlements default to. Viewers can switch\nthe website to another currency; conversion uses live ECB rates.",
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "base"
      ]
    },
    "Member": {
      "type": "object",
      "properties": {
        "name": {
          "description": "How everyone else refers to this person (`who`, `paidBy`, groups).",
          "type": "string"
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "github": {
          "description": "GitHub username: signing in with it is being this member, and their\nGitHub picture stands for them. Defaults to the username of a\n`https://github.com/<username>` link.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "currency": {
          "description": "ISO 4217 code of the money this person pays with; defaults to the\ntrip's base currency.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Group": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Usable in `who` and `paidBy` like a person's name. Without one the\ngroup still ties its members together (sections, the people lens),\nshown by their names; refer to it by listing them.",
          "type": [
            "string",
            "null"
          ]
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "description": "Member names.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "members"
      ]
    },
    "Base": {
      "description": "A stretch of days spent in one area, by everyone or some of the members.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "place": {
          "description": "Name of an area in `places`.",
          "type": "string"
        },
        "from": {
          "description": "First night here.",
          "type": "string",
          "format": "date"
        },
        "to": {
          "description": "Last night here (inclusive).",
          "type": "string",
          "format": "date"
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "place",
        "from",
        "to"
      ]
    },
    "Place": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Only for places written inline in a plan; under `places:` the key is\nthe name.",
          "type": "string"
        },
        "geo": {
          "description": "`[latitude, longitude]`, WGS 84.",
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "category": {
          "description": "Free-form; well-known values get dedicated icons: airport, station,\nstop, port, hotel, ryokan, temple, shrine, garden, nature, museum,\nshopping, food, historic, attraction, viewpoint, onsen. Trains, buses,\nferries and flights run between `station`, `stop`, `port` and\n`airport` places only.",
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "radius": {
          "description": "Makes the place an area (a city, a valley) of this many metres around\n`geo`: bases, passes and ideas' `area` need one. Without it the place\nis a single spot.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "geo"
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "description": "RFC 3339 with the local offset of where it happens. Set this, or\n`date` for plans without a fixed time.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "date": {
          "description": "A day without a time; not for lodging or transport.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "part": {
          "description": "Rough time of day for a `date`-only item.",
          "anyOf": [
            {
              "$ref": "#/$defs/DayPart"
            },
            {
              "type": "null"
            }
          ]
        },
        "places": {
          "description": "Ordered stops: origin → destination for transport, venues otherwise.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceRef"
          }
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "booking": {
          "description": "One reservation for the whole plan. Once loaded, plans with\n`bookings` get a summary here.",
          "anyOf": [
            {
              "$ref": "#/$defs/Booking"
            },
            {
              "type": "null"
            }
          ]
        },
        "bookings": {
          "description": "Several reservations for one plan (the same flight booked separately\nby different people), each with its own people and costs. Instead of\n`booking`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reservation"
          }
        },
        "costs": {
          "description": "What it costs. With `bookings`, costs go in each reservation instead.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cost"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contact"
          }
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overrides": {
          "description": "Titles of blockers this plan may run through, e.g. a train with good\nWi-Fi during work hours.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "title"
      ]
    },
    "ItemKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "flight",
            "train",
            "bus",
            "ferry",
            "transfer",
            "lodging",
            "activity",
            "meal",
            "note"
          ]
        },
        {
          "description": "On foot between two places.",
          "type": "string",
          "const": "walk"
        },
        {
          "description": "By bicycle or scooter (`transport.vehicle`), own or rented.",
          "type": "string",
          "const": "ride"
        }
      ]
    },
    "DayPart": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening"
      ]
    },
    "PlaceRef": {
      "description": "A place's name from `places`, or a place declared inline.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Place"
        }
      ]
    },
    "Transport": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "description": "Flight or train number, e.g. `AY61`, `Hikari 645`.",
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle": {
          "description": "What a `ride` is on; a rental service goes in `carrier`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Vehicle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Vehicle": {
      "type": "string",
      "enum": [
        "bicycle",
        "scooter"
      ]
    },
    "Booking": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/BookingStatus"
        },
        "deadline": {
          "description": "Book by this date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "description": "Confirmation number / PNR. Never published.",
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "BookingStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "booked",
            "notRequired",
            "cancelled"
          ]
        },
        {
          "description": "Needs a reservation that has not been made yet.",
          "type": "string",
          "const": "required"
        }
      ]
    },
    "Secret": {
      "description": "A confidential value, resolved by name from `.env`, `secrets.yaml` or the\nenvironment. Only local builds run with `--reveal` ever see it.",
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "secret"
      ]
    },
    "Reservation": {
      "description": "One of several reservations behind a plan.",
      "type": "object",
      "properties": {
        "who": {
          "description": "Names of the members and/or groups it covers; omitted means the\nplan's people.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/BookingStatus"
        },
        "deadline": {
          "description": "Book by this date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "description": "Confirmation number / PNR. Never published.",
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        },
        "costs": {
          "description": "What this reservation cost; `who` defaults to the reservation's.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cost"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "Cost": {
      "type": "object",
      "properties": {
        "amount": {
          "description": "The price, in the currency it is quoted in.",
          "type": "number",
          "format": "double"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "charged": {
          "description": "What actually left the payer's account once booked, in their own\ncurrency. Required for booked costs in a foreign currency; until then\nthe website estimates with the current rate.",
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ]
        },
        "due": {
          "description": "Booked at this price but charged later, on this date (pay at the\nproperty, a deposit's balance): until `charged` is added, what it costs\nin the payer's currency is an estimate.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "paidBy": {
          "description": "Who paid: a member, a list of members and/or groups sharing the\npayment equally, or `each` — everyone paid their own share. Omitted\nmeans nobody has paid yet: it counts as planned spend and nobody\nowes anybody for it.",
          "anyOf": [
            {
              "$ref": "#/$defs/PaidBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "who": {
          "description": "Who the cost is for; defaults to the item's participants.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "split": {
          "description": "How it divides among `who`.",
          "$ref": "#/$defs/Split",
          "default": "equal"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimate": {
          "description": "A guess rather than a quote.",
          "type": "boolean"
        },
        "owedBy": {
          "description": "The one member who pays the payer back for everyone's share (say,\nfor their partner too), instead of each person their own. Shares stay\nas they are; only who owes whom changes. Needs `settled: false`.",
          "type": [
            "string",
            "null"
          ]
        },
        "settled": {
          "description": "Whether the others have paid the payer back. Travellers usually\nsquare up on the spot, so a paid cost is settled unless this says\n`false`: only then does someone owe someone for it.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ]
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "format": "double"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ]
    },
    "PaidBy": {
      "anyOf": [
        {
          "description": "One member's (or group's) name, or `each`.",
          "type": "string"
        },
        {
          "description": "Members' and/or groups' names; they split the payment equally.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "Split": {
      "description": "How a cost is shared among the item's participants.",
      "anyOf": [
        {
          "$ref": "#/$defs/SplitKeyword"
        },
        {
          "type": "object",
          "properties": {
            "shares": {
              "description": "Proportional weights by member name.",
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "required": [
            "shares"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exact": {
              "description": "Exact amounts by member name, in the cost's currency; must sum to it.",
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "required": [
            "exact"
          ]
        }
      ]
    },
    "SplitKeyword": {
      "oneOf": [
        {
          "description": "Evenly among participants.",
          "type": "string",
          "const": "equal"
        },
        {
          "description": "Borne by the payer alone.",
          "type": "string",
          "const": "personal"
        }
      ]
    },
    "Contact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Idea": {
      "description": "A proposal: anything that could become a plan (an activity, a hotel or a\nflight option, a restaurant to reserve). It has a plan's shape, so\nchoosing it means moving it to the itinerary. A date is optional: without\none it is suggested on free days nearby; with one it shows on that day as\nproposed. It is never booked or paid; that makes it a plan.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind",
          "default": "activity"
        },
        "start": {
          "description": "When it would happen, if that is known: like a plan's `start`/`end`,\nor `date` with an optional `part`. All optional, for any kind.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "part": {
          "anyOf": [
            {
              "$ref": "#/$defs/DayPart"
            },
            {
              "type": "null"
            }
          ]
        },
        "option": {
          "description": "Alternatives for the same need share a label (`option: Kyoto stay`):\nthey are compared side by side and only the cheapest counts as\npossible spend.",
          "type": [
            "string",
            "null"
          ]
        },
        "area": {
          "description": "Name of the area (in `places`) the idea belongs to; days spent in a base\non that area surface it.",
          "type": [
            "string",
            "null"
          ]
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlaceRef"
          }
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "maybe"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdeaDuration"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "booking": {
          "description": "How to book it if chosen: `required` (with a `deadline`) or\n`notRequired`. `booked` makes it a plan.",
          "anyOf": [
            {
              "$ref": "#/$defs/Booking"
            },
            {
              "type": "null"
            }
          ]
        },
        "costs": {
          "description": "What it would cost, usually `estimate: true`: possible spend only,\nnobody has paid. Booking and paying make it a plan in the itinerary.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cost"
          }
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "must",
        "maybe"
      ]
    },
    "IdeaDuration": {
      "type": "string",
      "enum": [
        "hour",
        "halfDay",
        "day"
      ]
    },
    "Blocker": {
      "description": "Unavailable time, repeating over one or more date periods.",
      "type": "object",
      "properties": {
        "title": {
          "description": "Plans name it in `overrides`.",
          "type": "string"
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "periods": {
          "description": "Inclusive date ranges, in the blocker's time zone.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Period"
          }
        },
        "days": {
          "description": "Weekdays it applies on; omitted means every day.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Weekday"
          }
        },
        "time": {
          "description": "A daily window; omitted blocks whole days.",
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "strict": {
          "description": "Conflicts are errors rather than warnings.",
          "type": "boolean"
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "periods"
      ]
    },
    "Period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "Weekday": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "TimeWindow": {
      "type": "object",
      "properties": {
        "start": {
          "description": "`HH:MM`.",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "description": "`HH:MM`; at or before `start` means the next day (`24:00` allowed).",
          "type": "string",
          "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
        },
        "timezone": {
          "description": "IANA zone the times are in; defaults to the trip's.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "Task": {
      "description": "Something to get done, before, during or after the trip; its date says\nwhich.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "required": {
          "description": "The trip can't go ahead without it, such as a visa: due by the start at\nthe latest.",
          "type": "boolean"
        },
        "due": {
          "description": "Get it done by this date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "done": {
          "description": "When it got done; omitted means still open.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "Pass": {
      "description": "A ticket, pass or rental for getting around an area for a while: a metro\npass, a bike-share day. It pays for the legs there; it doesn't stand in\nfor them — every move between two places is still a leg of its own.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "who": {
          "description": "Names of members and/or groups, or `everyone`; omitted means everyone.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "description": "How it gets people around.",
          "$ref": "#/$defs/PassMode",
          "default": "transit"
        },
        "area": {
          "description": "The area it covers: a place with a `radius`.",
          "type": "string"
        },
        "periods": {
          "description": "The days it's used, inclusive: one stretch for a 72-hour ticket,\nseveral for a card used on each stay in the area. Each of `bookings`\nmay have its own.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Period"
          }
        },
        "provider": {
          "description": "Who sells or runs it, e.g. `Tokyo Metro`, `Luup`.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "booking": {
          "anyOf": [
            {
              "$ref": "#/$defs/Booking"
            },
            {
              "type": "null"
            }
          ]
        },
        "bookings": {
          "description": "One pass, held per party like a plan's reservations: each with its\nown people, days and costs. Not with `booking` or `costs`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PassBooking"
          }
        },
        "costs": {
          "description": "`who` defaults to the pass's people; `estimate: true` while the price\nis a guess.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cost"
          }
        },
        "notes": {
          "description": "Markdown.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "area"
      ]
    },
    "PassMode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "bicycle",
            "scooter"
          ]
        },
        {
          "description": "Public transport: metro, buses, local trains.",
          "type": "string",
          "const": "transit"
        }
      ]
    },
    "PassBooking": {
      "description": "One party's share of a pass.",
      "type": "object",
      "properties": {
        "who": {
          "description": "Names of the members and/or groups it covers; omitted means the\npass's people.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "periods": {
          "description": "Their days; omitted means the pass's.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Period"
          }
        },
        "status": {
          "description": "A card topped up as you go needs no booking.",
          "$ref": "#/$defs/BookingStatus",
          "default": "notRequired"
        },
        "deadline": {
          "description": "Book by this date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reference": {
          "description": "Confirmation number. Never published.",
          "anyOf": [
            {
              "$ref": "#/$defs/Secret"
            },
            {
              "type": "null"
            }
          ]
        },
        "costs": {
          "description": "What their share costs; `who` defaults to theirs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cost"
          }
        }
      },
      "additionalProperties": false
    },
    "PackingCategory": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "who": {
          "description": "Default for the category's items: names of members and/or groups;\nomitted means everyone packs it.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackingItem"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "items"
      ]
    },
    "PackingItem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "who": {
              "description": "Names of members and/or groups who pack it; defaults to the category's.",
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "costs": {
              "description": "What it costs to get before packing; counts in the budget. `who`\ndefaults to the item's packers.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Cost"
              }
            },
            "bought": {
              "description": "Already bought: its costs count as committed.",
              "type": "boolean"
            },
            "qty": {
              "description": "How many, when more than one.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "bag": {
              "description": "Which bag it goes in, such as `carry-on` or `suitcase`.",
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
      ]
    },
    "MapConfig": {
      "type": "object",
      "properties": {
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Overlay"
          }
        }
      },
      "additionalProperties": false
    },
    "Overlay": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "file": {
          "description": "`GeoJSON` file, relative to the trip directory.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "file"
      ]
    }
  }
}
