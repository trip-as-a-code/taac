---
import type { I18n } from '@/i18n'

interface Props {
  i18n: I18n
}

const { t } = Astro.props.i18n
---

<div class="filters" data-filters>
  <div class="segmented" role="group" aria-label={t('filter.status')} data-filter-group="status">
    <button type="button" data-value="" aria-pressed="true">
      {t('filter.all')}
    </button>
    <button type="button" data-value="required" aria-pressed="false">
      {t('filter.toBook')}
    </button>
    <button type="button" data-value="booked" aria-pressed="false">
      {t('filter.booked')}
    </button>
  </div>
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }
</style>
