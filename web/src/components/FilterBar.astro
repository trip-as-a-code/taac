---
import type { TripExport } from '@taac/core'

import Icon, { type IconName } from '@/components/Icon.astro'
import type { I18n } from '@/i18n'
import { issueGroup, type Facts } from '@/lib/facts'
import { kindIcon, type CostKind } from '@/lib/trip'
import type { Facet } from '@/scripts/filters'

interface Props {
  i18n: I18n
  trip: TripExport
  /** What is on the page; options nothing could match are left out. */
  facts: Facts[]
  facets: Facet[]
  placeholder: string
}

const { i18n, trip, facts, facets, placeholder } = Astro.props
const { t } = i18n

interface Option {
  value: string
  label: string
  icon?: IconName
  /** Whether anything on the page has it. */
  some: (f: Facts) => boolean
}

const statuses = ['required', 'booked', 'notRequired', 'cancelled'] as const
const kinds = Object.keys(kindIcon) as CostKind[]
const placeIds = [...new Set(facts.flatMap((f) => f.places))]
  .filter((id) => trip.places[id])
  .sort((a, b) => trip.places[a].name.localeCompare(trip.places[b].name))

const options: Record<Exclude<Facet, 'place'>, Option[]> = {
  focus: [
    {
      value: 'attention',
      label: t('filter.attention'),
      some: (f) => f.issues.length > 0 || f.conflict === 'open' || (f.status === 'required' && Boolean(f.deadline)),
    },
  ],
  issue: [
    { value: 'any', label: t('filter.issue.any'), some: (f) => f.issues.length > 0 },
    ...(['people', 'clash', 'booking', 'place', 'other'] as const).map((group) => ({
      value: group,
      label: t(`filter.issue.${group}`),
      some: (f: Facts) => f.issues.some((code) => issueGroup(code) === group),
    })),
  ],
  when: (['today', 'soon', 'upcoming', 'past'] as const).map((value) => ({
    value,
    label: t(`filter.when.${value}`),
    some: (f) => Boolean(f.day),
  })),
  due: [
    { value: 'overdue', label: t('filter.due.overdue'), some: (f) => Boolean(f.deadline) },
    { value: 'soon', label: t('filter.due.soon'), some: (f) => Boolean(f.deadline) },
    { value: 'none', label: t('filter.due.none'), some: (f) => f.status === 'required' && !f.deadline },
  ],
  conflict: [
    { value: 'open', label: t('filter.conflict.open'), some: (f) => f.conflict === 'open' },
    { value: 'overridden', label: t('filter.conflict.overridden'), some: (f) => f.conflict === 'overridden' },
  ],
  cost: [
    { value: 'priced', label: t('filter.cost.priced'), some: (f) => f.priced },
    { value: 'topay', label: t('filter.cost.topay'), some: (f) => f.toPay },
    { value: 'unpriced', label: t('filter.cost.unpriced'), some: (f) => !f.priced },
  ],
  status: statuses.map((value) => ({ value, label: t(`status.${value}`), some: (f) => f.status === value })),
  priority: (['must', 'maybe'] as const).map((value) => ({
    value,
    label: t(`ideas.${value}`),
    some: (f) => f.priority === value,
  })),
  kind: kinds.map((value) => ({
    value,
    label: t(`kind.${value}`),
    icon: kindIcon[value],
    some: (f) => f.kind === value,
  })),
  payer: trip.members.map((m) => ({ value: m.id, label: m.name, some: (f) => f.payers.includes(m.id) })),
  tag: [...new Set(facts.flatMap((f) => f.tags))].sort().map((tag) => ({
    value: tag,
    label: `#${tag}`,
    some: (f) => f.tags.includes(tag),
  })),
}

// A section earns its place when at least one of its options matches
// something; single options that would match everything say nothing.
const sections = facets
  .filter((key): key is Exclude<Facet, 'place'> => key !== 'place')
  .map((key) => ({ key, options: options[key].filter((o) => facts.some(o.some)) }))
  .filter((s) => s.options.length > 0 && (s.options.length > 1 || !facts.every(s.options[0].some)))
const id = 'filters-panel'
---

<div class="filters" data-filters data-timezone={trip.timezone}>
  <div class="bar">
    <label class="search">
      <Icon name="search" size={16} />
      <input type="search" data-filter-q placeholder={placeholder} aria-label={placeholder} enterkeyhint="search" />
    </label>
    <button class="button toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls={id}>
      <Icon name="sliders" size={16} />
      <span>{t('filter.filters')}</span>
      <span class="count-badge tabular" data-filter-badge hidden>
        0
      </span>
    </button>
  </div>
  <div class="panel card" id={id} data-filter-panel hidden>
    {sections.map((section) => (
      <section>
        <h3 class="footnote secondary">{t(`filter.${section.key}`)}</h3>
        <div class="chips">
          {section.options.map((o) => (
            <button
              type="button"
              class="chip"
              data-facet={section.key}
              data-value={o.value}
              data-label={o.label}
              aria-pressed="false"
            >
              {o.icon && <Icon name={o.icon} size={14} />}
              <span lang={section.key === 'tag' ? trip.locale : undefined}>{o.label}</span>
            </button>
          ))}
        </div>
      </section>
    ))}
    {facets.includes('place') && placeIds.length > 1 && (
      <section>
        <h3 class="footnote secondary">{t('filter.place')}</h3>
        <label class="select">
          <select data-facet="place" aria-label={t('filter.place')}>
            <option value="">{t('filter.anyPlace')}</option>
            {placeIds.map((p) => (
              <option value={p} lang={trip.locale}>
                {trip.places[p].name}
              </option>
            ))}
          </select>
          <Icon name="chevronDown" size={14} />
        </label>
      </section>
    )}
  </div>
  <div class="active" data-filter-active hidden>
    <div class="chips" data-filter-chips></div>
    <span class="footnote secondary tabular" data-filter-count data-template={t('filter.count')}></span>
    <button class="button button-plain clear" type="button" data-filter-clear>
      {t('filter.clear')}
    </button>
  </div>
  <template data-filter-chip>
    <button type="button" class="chip on" aria-label={t('filter.remove')}>
      <span data-text></span>
      <Icon name="close" size={12} />
    </button>
  </template>
</div>

<style>
  .filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    flex: 1 1 100%;
    gap: var(--space-3);
    width: 100%;
    min-width: 0;
  }

  .bar {
    display: flex;
    gap: var(--space-2);
  }

  .search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 420px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--label-secondary);
    background: var(--fill);
  }

  .search:focus-within {
    box-shadow: 0 0 0 3px var(--tint-soft);
  }

  .search :global(svg) {
    flex: none;
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    font: inherit;
    font-size: 15px;
    color: var(--label);
    background: transparent;
  }

  .toggle {
    flex: none;
    min-height: 36px;
    padding-inline: 14px;
    font-size: 14px;
  }

  .toggle[aria-expanded='true'] {
    color: var(--tint);
    background: var(--tint-soft);
  }

  .count-badge {
    min-width: 18px;
    padding: 0 5px;
    border-radius: 999px;
    font-size: 12px;
    line-height: 18px;
    color: var(--label-on-tint);
    background: var(--tint);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4);
    animation: open 220ms var(--ease-out);
  }

  .panel[hidden] {
    display: none;
  }

  .panel h3 {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    min-height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--label);
    background: var(--fill);
    cursor: pointer;
  }

  .chip span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip :global(svg) {
    flex: none;
  }

  .chip:hover {
    background: var(--fill-strong);
  }

  .chip[aria-pressed='true'],
  .chip.on {
    color: var(--label-on-tint);
    background: var(--tint);
  }

  /* The longest place name sets a select's width: let it give way. */
  .select {
    position: relative;
    display: flex;
    min-width: 0;
    max-width: min(100%, 420px);
  }

  .select select {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    min-height: 32px;
    padding: 0 30px 0 12px;
    border: 0;
    border-radius: 999px;
    appearance: none;
    font: inherit;
    font-size: 14px;
    color: var(--label);
    background: var(--fill);
    text-overflow: ellipsis;
  }

  .select :global(svg) {
    position: absolute;
    right: 10px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--label-secondary);
  }

  .active {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-3);
  }

  .active[hidden] {
    display: none;
  }

  .active .chips {
    flex: 1 1 100%;
    min-width: 0;
  }

  .active .chips:empty {
    display: none;
  }

  .clear {
    min-height: 30px;
    font-size: 14px;
  }

  @keyframes open {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
</style>
