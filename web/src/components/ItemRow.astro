---
import type { Item, TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Debts from '@/components/Debts.astro'
import Icon from '@/components/Icon.astro'
import ThreadButton from '@/components/ThreadButton.astro'
import Money from '@/components/Money.astro'
import LotteryEntry from '@/components/LotteryEntry.astro'
import { entryTickItem } from '@/lib/deadlines'
import Opens from '@/components/Opens.astro'
import type { I18n } from '@/i18n'
import { isLabelled, issuesOf, itemFacts } from '@/lib/facts'
import { photoOf, photoSrc } from '@/lib/photos'
import { sourceHref, sourceLabel } from '@/lib/source'
import {
  daysBetween,
  echoesPlace,
  kindIcon,
  kindTint,
  markdown,
  memberName,
  partyEmoji,
  partyLabel,
  people,
  statusTone,
  type RowItem,
  freeIdeas,
} from '@/lib/trip'

interface Props {
  trip: TripExport
  /** A plan, or a pass in a plan's shape (lib/trip `passItem`). */
  item: RowItem
  i18n: I18n
  /** The card's anchor: `item` for plans, `pass` for passes. */
  anchor?: 'item' | 'pass'
  /** Show the date instead of only the time, and link to the plan in the
   * itinerary (lists outside the day view). */
  withDate?: boolean
  /** The trip's usual UTC offset; others get a label. */
  homeOffset?: string
  /** Listed under its deadline already: the card needn't repeat it. */
  dueShown?: boolean
  /** In a section headed by exactly its people: no party pill or rail. */
  grouped?: boolean
  /** The photo URL to show, or null for none; by default its first place's. Day lists show each once. */
  photo?: string | null
}

const { trip, item, i18n, withDate, homeOffset, dueShown, grouped, photo, anchor = 'item' } = Astro.props
// A pass isn't on a day or at a point: no links into the itinerary or map.
const plan = anchor === 'item'
const days = (periods: { from: string; to: string }[]) => periods.map((p) => i18n.dateRange(p.from, p.to)).join(' · ')
const { t, money, date } = i18n
const places = item.places.map((id) => trip.places[id]).filter(Boolean)
const shownPhoto = photo === undefined ? photoOf(trip, item) : (photo ?? undefined)
// The photo is of a place: the viewer names it.
const photoPlace = places.find((p) => p.photo === shownPhoto)?.name ?? item.title
const everyone = item.members.length === trip.members.length
const members = trip.members.filter((m) => item.members.includes(m.id))
const party = partyLabel(trip, item.party, i18n.t('lens.everyone'), i18n.t('party.and'))
const emoji = partyEmoji(trip, item.party)
const endDays = item.local.endDate ? daysBetween(item.local.date, item.local.endDate) : 0
const names = (ids: string[]) => ids.map((id) => memberName(trip, id)).join(', ')
const tone = statusTone[item.booking.status]
const priceHolder = item.pricedWith ? trip.items.find((i) => i.id === item.pricedWith) : undefined
const isStay = item.kind === 'lodging'
// Free time: its ideas show under it, the nearby ones to pick from and those already proposed within it.
const free = item.kind === 'free'
const SUGGESTED = 3
const ideas = free ? freeIdeas(trip, item as Item) : undefined
const ideaHref = (id: string) => i18n.path(`/trips/${trip.slug}/ideas/#idea-${id}`)
const transport = [item.transport?.carrier, item.transport?.number].filter(Boolean).join(' ')
// Blocker clashes already have their own badge.
// One entry per kind of issue, as in the overview's list, which has the
// details; the card says what (or how many) and links there.
const issues = [...new Map(issuesOf(trip, item.id).map((d) => [d.code, d])).values()]
const worst = issues.some((d) => d.severity === 'error') ? 'error' : 'warning'
const issuesHref = i18n.path(`/trips/${trip.slug}/#issue-${item.id}`)
// No `who` means everyone, but nobody chose that: the issue says so instead.
const unassigned = issues.some((d) => d.code === 'item.unassigned')
const issueLabel = (code: string) => (isLabelled(code) ? t(`issue.${code}`) : t('issue.other'))
const hasDetails =
  withDate ||
  issues.length > 0 ||
  Boolean(item.notes) ||
  item.contacts.length > 0 ||
  item.costs.length > 0 ||
  item.booking.hasReference ||
  item.booking.hasPin ||
  (item.booking.codes?.length ?? 0) > 0 ||
  (item.booking.attachments?.length ?? 0) > 0 ||
  Boolean(item.url) ||
  places.length > 0 ||
  Boolean(sourceHref(item.source))
const offsetLabel =
  homeOffset && item.local.offset && item.local.offset !== homeOffset ? `UTC${item.local.offset}` : undefined
---

<article
  id={`${anchor}-${item.id}`}
  data-item
  data-people={people(item.members)}
  data-party={item.party}
  data-status={item.booking.status}
  data-day={item.local.date}
  data-kind={item.kind}
  data-facts={JSON.stringify(itemFacts(trip, item as Item))}
  style={`--kind:${kindTint[item.kind]}`}
  class:list={['item', { shared: everyone || grouped, 'with-photo': shownPhoto }]}
>
  <div class="when tabular">
    {withDate && (
      <span class="date">
        {date(item.local.date, {
          day: 'numeric',
          month: 'short',
          // Into the trip's next year, the year too.
          ...(item.local.date.slice(0, 4) !== trip.days[0]?.date.slice(0, 4) ? { year: '2-digit' } : {}),
        })}
      </span>
    )}
    <span class:list={['time', { loose: !item.local.time }]}>
      {item.local.time ?? t(`part.${item.local.part ?? 'anytime'}`)}
    </span>
    {item.local.endTime && !isStay && (
      <span class="end">
        {item.local.endTime}
        {endDays > 0 && <sup>{t('item.nextDay', { n: endDays })}</sup>}
      </span>
    )}
    {offsetLabel && (
      <span class="offset" title={t('item.localTime', { offset: item.local.offset ?? '' })}>
        {offsetLabel}
      </span>
    )}
  </div>
  {/* A photo takes the kind's place, its icon underneath until the photo loads (or if it can't). */}
  {shownPhoto ? (
    <button
      type="button"
      class="glyph photo"
      data-photo={photoSrc(shownPhoto, 'large')}
      data-photo-title={photoPlace}
      aria-label={`${t('photo.open')}: ${photoPlace}`}
    >
      <Icon name={kindIcon[item.kind]} size={18} />
      <img
        class="photo-img"
        src={photoSrc(shownPhoto, 'thumb')}
        alt=""
        loading="lazy"
        decoding="async"
        width="52"
        height="52"
        data-photo-img
      />
    </button>
  ) : (
    <div class="glyph" aria-hidden="true">
      <Icon name={kindIcon[item.kind]} size={18} />
    </div>
  )}
  <details class="main" open={false} data-expandable={hasDetails ? '' : undefined}>
    <summary>
      <h3 class="headline" lang={trip.locale}>
        {item.title}
      </h3>
      {places.length > 0 && !echoesPlace(item.title, places) && (
        <p class="subhead secondary place">
          <Icon name={item.kind === 'flight' || item.kind === 'train' ? 'arrowRight' : 'pin'} size={14} />
          <span>{places.map((p) => p.name).join(' → ')}</span>
        </p>
      )}
      <div class="meta">
        <span class="kind footnote" hidden={free && item.title === t('kind.free')}>
          {item.transport?.vehicle === 'bicycle'
            ? t('vehicle.bicycle')
            : item.transport?.vehicle === 'scooter'
              ? t('vehicle.scooter')
              : t(`kind.${item.kind}`)}
        </span>
        {transport && <span class="footnote secondary">{transport}</span>}
        {item.periods && <span class="footnote secondary">{days(item.periods)}</span>}
        {isStay && item.local.endDate && (
          <span class="footnote secondary">
            {t('item.until', { date: date(item.local.endDate, { day: 'numeric', month: 'short' }) })}
          </span>
        )}
        {item.bookings
          ? item.bookings.map((b, index) => {
              // Each reservation: whose it is, and where it stands.
              const id = trip.parties.find((p) => p.members.join() === b.members.join())?.id ?? b.members.join('+')
              const whose =
                `${partyEmoji(trip, id) ?? ''} ${partyLabel(trip, id, t('lens.everyone'), t('party.and'))}`.trim()
              return (
                <span class="reservation">
                  <span class="badge" data-tone={statusTone[b.status]} title={names(b.members)}>
                    <span class="ellipsis">{whose}</span>
                    <span>· {t(`status.${b.status}`)}</span>
                  </span>
                  {b.periods && <span class="footnote secondary">{days(b.periods)}</span>}
                  {b.status === 'required' && b.lottery && (
                    <LotteryEntry
                      trip={trip}
                      item={entryTickItem(`booking:${anchor}:${item.id}:${index}`)}
                      members={b.members}
                      lottery={b.lottery}
                      i18n={i18n}
                    />
                  )}
                  {b.costs.map((c) => (
                    <Money
                      display={trip.currency?.base ?? 'EUR'}
                      amount={c.amount}
                      currency={c.currency}
                      charged={c.charged}
                      lang={i18n.lang}
                      class="footnote secondary cost"
                    />
                  ))}
                </span>
              )
            })
          : tone &&
            !dueShown && (
              <span class="badge" data-tone={tone}>
                {t(`status.${item.booking.status}`)}
              </span>
            )}
        {item.booking.status === 'required' && item.booking.opens && (
          <Opens trip={trip} opens={item.booking.opens} i18n={i18n} />
        )}
        {!item.bookings && item.booking.status === 'required' && item.booking.lottery && (
          <LotteryEntry
            trip={trip}
            item={entryTickItem(`booking:${anchor}:${item.id}`)}
            members={item.members}
            lottery={item.booking.lottery}
            i18n={i18n}
          />
        )}
        {item.booking.status === 'required' && item.booking.deadline && !dueShown && (
          <time class="footnote deadline" data-relative={item.booking.deadline} data-template={t('bookings.due')} />
        )}
        {/* Priced in another plan's booking (a return flight with its outbound). */}
        {priceHolder && (
          <a class="footnote secondary priced-with" href={`#item-${priceHolder.id}`}>
            {t('item.pricedWith', { title: priceHolder.transport?.number ?? priceHolder.title })}
          </a>
        )}
        {/* Where to book, without opening the card. */}
        {item.booking.status === 'required' && item.booking.url && (
          <a class="footnote book" href={item.booking.url} target="_blank" rel="noopener noreferrer">
            {t('item.bookingLink')} ↗
          </a>
        )}
        {item.conflicts.map((c) => {
          const blocker = trip.blockers.find((b) => b.id === c.blocker)
          const title = blocker?.title ?? c.blocker
          return (
            <span
              class="badge"
              data-tone={c.overridden ? 'blue' : blocker?.strict ? 'red' : 'orange'}
              data-people={people(c.members)}
              data-conflict
              title={names(c.members)}
            >
              {c.overridden ? t('blocker.allowed', { title }) : `⛔ ${t('blocker.during', { title })}`}
            </span>
          )
        })}
        {/* With several reservations each shows its own cost. */}
        {!item.bookings &&
          item.costs.map((c) => (
            <Money
              display={trip.currency?.base ?? 'EUR'}
              amount={c.amount}
              currency={c.currency}
              charged={c.charged}
              lang={i18n.lang}
              class="footnote secondary cost"
            />
          ))}
        {grouped ? null : everyone ? (
          !unassigned && (
            <span class="who" title={members.map((m) => m.name).join(', ')}>
              <span class="party-pill">
                <span class="ellipsis">{party}</span>
              </span>
            </span>
          )
        ) : (
          <span class="who" title={members.map((m) => m.name).join(', ')}>
            <span class="party-pill">
              {emoji && <span aria-hidden="true">{emoji}</span>}
              <span class="ellipsis">{party}</span>
            </span>
            <Avatars members={members} size={20} />
          </span>
        )}
      </div>
      <Debts trip={trip} id={item.id} i18n={i18n} />
      {issues.length > 0 && (
        <p class="issues footnote" data-severity={worst}>
          <span aria-hidden="true">⚠︎</span>
          <span class="ellipsis">
            {issues.length === 1 ? issueLabel(issues[0].code) : i18n.plural('issues.count', issues.length)}
          </span>
        </p>
      )}
    </summary>
    {hasDetails && (
      <div class="details">
        {issues.length > 0 && (
          <div class="issue-details footnote">
            {/* One issue is already named on the card. */}
            {issues.length > 1 && (
              <ul>
                {issues.map((d) => (
                  <li data-severity={d.severity}>{issueLabel(d.code)}</li>
                ))}
              </ul>
            )}
            <a href={issuesHref}>{t('issues.inList')} →</a>
          </div>
        )}
        {item.notes && <div class="prose" lang={trip.locale} set:html={markdown(item.notes)} />}
        <ul class="facts footnote">
          {item.booking.hasReference && (
            <li
              class="secret-row"
              data-secret={item.booking.reference?.secret}
              data-secret-field={item.booking.reference?.field}
              data-secret-vault={item.booking.reference?.vault}
              data-secret-mask={t('item.reference')}
            >
              <Icon name="ticket" size={15} />
              {item.booking.reference ? (
                <>
                  <button type="button" class="secret-trigger" data-secret-trigger>
                    <span data-secret-value>{t('item.reference')}</span>
                  </button>
                  <button type="button" class="secret-copy" data-secret-copy hidden title={t('vault.copy')}>
                    <Icon name="copy" size={14} />
                  </button>
                </>
              ) : (
                t('item.reference')
              )}
            </li>
          )}
          {item.booking.hasPin && (
            <li
              class="secret-row"
              data-secret={item.booking.pin?.secret}
              data-secret-field={item.booking.pin?.field}
              data-secret-vault={item.booking.pin?.vault}
              data-secret-mask={t('item.pin')}
            >
              <Icon name="lock" size={15} />
              {item.booking.pin ? (
                <>
                  <button type="button" class="secret-trigger" data-secret-trigger>
                    <span data-secret-value>{t('item.pin')}</span>
                  </button>
                  <button type="button" class="secret-copy" data-secret-copy hidden title={t('vault.copy')}>
                    <Icon name="copy" size={14} />
                  </button>
                </>
              ) : (
                t('item.pin')
              )}
            </li>
          )}
          {(item.booking.codes ?? []).map((code) => (
            <li
              class="secret-row"
              data-secret={code.secret?.secret}
              data-secret-field={code.secret?.field}
              data-secret-vault={code.secret?.vault}
              data-secret-mask="••••••"
            >
              <Icon name="lock" size={15} />
              <span class="secondary">{code.label}:</span>
              {code.secret ? (
                <>
                  <button type="button" class="secret-trigger" data-secret-trigger>
                    <span data-secret-value>••••••</span>
                  </button>
                  <button type="button" class="secret-copy" data-secret-copy hidden title={t('vault.copy')}>
                    <Icon name="copy" size={14} />
                  </button>
                </>
              ) : (
                <span>••••••</span>
              )}
            </li>
          ))}
          {(item.booking.attachments ?? []).map((att) => (
            <li
              class="secret-row"
              data-secret-attachment={att.secret}
              data-secret-filename={att.attachment}
              data-secret-all={att.all ? 'true' : undefined}
              data-secret-vault={att.vault}
            >
              <Icon name="paperclip" size={15} />
              <button type="button" class="secret-trigger secret-locked-only" data-secret-trigger>
                {att.attachment ?? t('vault.attachment')} · {t('vault.unlockHint')}
              </button>
              <span class="secret-attachments" data-secret-attachment-list />
            </li>
          ))}
          {item.contacts.map((c) => (
            <li>
              <Icon name="phone" size={15} />
              {c.name}
              {c.role && <span class="secondary">· {c.role}</span>}
              {c.phone && (
                <span
                  class="secret-inline"
                  data-secret={c.phone.secret}
                  data-secret-field={c.phone.field}
                  data-secret-vault={c.phone.vault}
                  data-secret-mask="••••••"
                >
                  ·{' '}
                  <button type="button" class="secret-trigger" data-secret-trigger>
                    <span data-secret-value>••••••</span>
                  </button>
                </span>
              )}
              {c.email && (
                <span
                  class="secret-inline"
                  data-secret={c.email.secret}
                  data-secret-field={c.email.field}
                  data-secret-vault={c.email.vault}
                  data-secret-mask="••••••"
                >
                  ·{' '}
                  <button type="button" class="secret-trigger" data-secret-trigger>
                    <span data-secret-value>••••••</span>
                  </button>
                </span>
              )}
            </li>
          ))}
          {item.costs.map((c) => (
            <li class="tabular">
              <Icon name="wallet" size={15} />
              {money(c.amount, c.currency)}
              {c.charged && (
                <span class="secondary">
                  · {t('item.charged', { amount: money(c.charged.amount, c.charged.currency) })}
                </span>
              )}
              <span class="secondary">
                ·{' '}
                {c.unpaid && !c.due
                  ? t(c.estimate ? 'item.estimate' : 'item.unpaid')
                  : c.each
                    ? t('item.paidByEach')
                    : t('item.paidBy', { name: names(c.paidBy) })}
              </span>
              {c.who.join() !== item.members.join() && (
                <span class="secondary">· {t('item.for', { names: names(c.who) })}</span>
              )}
              {c.label && <span class="secondary">· {c.label}</span>}
              {/* Charged later: scheduled, then waiting for the charge to be confirmed (`charged`). */}
              {c.due && !c.charged && (
                <>
                  <span class="secondary" data-show-until={c.due}>
                    · {t('item.due', { date: date(c.due, { day: 'numeric', month: 'short' }) })}
                  </span>
                  <span class="owed" data-show-from={c.due} hidden>
                    · {t('item.dueConfirm', { date: date(c.due, { day: 'numeric', month: 'short' }) })}
                  </span>
                </>
              )}
              {!c.settled && <span class="owed">· {t('item.owed')}</span>}
            </li>
          ))}
        </ul>
        <div class="links">
          {withDate && plan && (
            <a class="button" href={i18n.path(`/trips/${trip.slug}/itinerary/#item-${item.id}`)}>
              <Icon name="itinerary" size={15} />
              <span>{t('item.inItinerary')}</span>
            </a>
          )}
          {places.length > 0 && plan && (
            <a class="button" href={i18n.path(`/trips/${trip.slug}/map/#item-${item.id}`)}>
              <Icon name="map" size={15} />
              <span>{t('item.onMap')}</span>
            </a>
          )}
          {/* The line in the trip files that says all this. */}
          {sourceHref(item.source) && (
            <a class="button" href={sourceHref(item.source)} target="_blank" rel="noopener noreferrer">
              <Icon name="code" size={15} />
              <span class="tabular">{sourceLabel(item.source!)}</span>
            </a>
          )}
          {item.url && (
            <a class="button" href={item.url} target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={15} />
              <span>{t('item.website')}</span>
            </a>
          )}
          {item.booking.url && item.booking.status === 'required' && (
            <a class="button button-primary" href={item.booking.url} target="_blank" rel="noopener noreferrer">
              <span>{t('item.bookingLink')}</span>
            </a>
          )}
          {places
            .filter((p) => p.url)
            .map((p) => (
              <a class="button" href={p.url} target="_blank" rel="noopener noreferrer" title={p.name}>
                <Icon name="external" size={15} />
                <span>{p.name}</span>
              </a>
            ))}
        </div>
      </div>
    )}
  </details>
  {ideas && (ideas.within.length > 0 || ideas.nearby.length > 0) && (
    <ul class="free-ideas footnote">
      {ideas.within.map((idea) => (
        <li>
          <a href={`#idea-${idea.id}`}>
            <Icon name="sparkle" size={14} />
            <span class="ellipsis" lang={trip.locale}>
              {idea.title}
            </span>
            <span class="secondary tabular">{idea.local!.time ?? t(`part.${idea.local!.part ?? 'anytime'}`)}</span>
          </a>
        </li>
      ))}
      {ideas.nearby.slice(0, SUGGESTED).map((idea) => (
        <li>
          <a href={ideaHref(idea.id)}>
            <Icon name="sparkle" size={14} />
            <span class="ellipsis" lang={trip.locale}>
              {idea.priority === 'must' && '★ '}
              {idea.title}
            </span>
            {idea.duration && <span class="secondary">{t(`ideas.duration.${idea.duration}`)}</span>}
          </a>
        </li>
      ))}
      {ideas.nearby.length > SUGGESTED && (
        <li>
          <a class="all" href={i18n.path(`/trips/${trip.slug}/ideas/`)}>
            {t('free.moreIdeas', { n: ideas.nearby.length - SUGGESTED })}
          </a>
        </li>
      )}
    </ul>
  )}
  {/* Outside the summary: a link inside the toggle would be a control
     within a control. Positioned beside the title. */}
  <div class="card-tools">
    <ThreadButton anchor={`${anchor}:${item.id}`} title={item.title} i18n={i18n} />
    <a
      class="anchor"
      href={`#${anchor}-${item.id}`}
      data-anchor
      aria-label={t('item.copyLink')}
      title={t('item.copyLink')}
      data-failed={t('item.copyFailed')}
    >
      <Icon name="link" size={14} class="anchor-link" />
      <Icon name="check" size={14} class="anchor-check" />
    </a>
  </div>
</article>

<style>
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 64px 36px minmax(0, 1fr);
    gap: 0 var(--space-3);
    padding: 14px var(--space-4);
    align-items: start;
  }

  /* Free time: an open slot, outlined like an open day rather than filled. */
  .item[data-kind='free'] .glyph {
    background: transparent;
    border: 1.5px dashed color-mix(in srgb, var(--kind) 55%, transparent);
  }

  .item[data-kind='free'] .headline {
    color: var(--label-secondary);
  }

  /* Under the title, in whichever column it has (phones drop the glyph's). */
  .free-ideas {
    grid-column: -2 / -1;
    list-style: none;
    display: grid;
    gap: 2px;
    margin: var(--space-2) 0 0;
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--separator-strong);
    border-radius: var(--radius);
  }

  .free-ideas a {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    max-width: 100%;
    min-height: 32px;
    font-weight: 500;
  }

  .free-ideas :global(svg),
  .free-ideas .secondary {
    flex: none;
  }

  .free-ideas .secondary {
    margin-left: auto;
    padding-left: var(--space-2);
  }

  .when {
    display: grid;
    justify-items: end;
    padding-top: 1px;
    line-height: 1.25;
  }

  .date {
    font-size: 12px;
    font-weight: 600;
