---
import type { Idea, TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import Money from '@/components/Money.astro'
import type { I18n } from '@/i18n'
import { kindIcon, kindTint, markdown, partyEmoji, partyHue, partyLabel, people } from '@/lib/trip'

interface Props {
  trip: TripExport
  idea: Idea
  i18n: I18n
}

const { trip, idea, i18n } = Astro.props
const { t } = i18n
const places = idea.places.map((id) => trip.places[id]).filter(Boolean)
const members = trip.members.filter((m) => idea.members.includes(m.id))
const everyone = members.length === trip.members.length
const party = partyLabel(trip, idea.party, i18n.t('lens.everyone'), i18n.t('party.and'))
const emoji = partyEmoji(trip, idea.party)
const hasDetails = Boolean(idea.notes || idea.url || places.some((p) => p.url))
---

<article
  id={`idea-${idea.id}`}
  data-item
  data-people={people(idea.members)}
  data-party={idea.party}
  data-status={idea.priority}
  style={`--kind:${kindTint[idea.kind]};--party-hue:${partyHue(idea.party)}`}
  class:list={['idea', { shared: everyone }]}
>
  <div class="glyph" aria-hidden="true">
    <Icon name={kindIcon[idea.kind]} size={18} />
  </div>
  <details class="main" data-expandable={hasDetails ? '' : undefined}>
    <summary>
      <h3 class="headline" lang={trip.locale}>
        {idea.title}
      </h3>
      {places.length > 0 && (
        <p class="subhead secondary place">
          <Icon name="pin" size={14} />
          <span lang={trip.locale}>{places.map((p) => p.name).join(' · ')}</span>
        </p>
      )}
      <div class="meta">
        {idea.priority === 'must' && (
          <span class="badge" data-tone="orange">
            ★ {t('ideas.must')}
          </span>
        )}
        {idea.duration && <span class="footnote secondary">{t(`ideas.duration.${idea.duration}`)}</span>}
        {idea.costs.map((c) => (
          <Money
            amount={c.amount}
            currency={c.currency}
            charged={c.charged}
            lang={i18n.lang}
            class="footnote secondary"
          />
        ))}
        {!everyone && (
          <span class="who" title={members.map((m) => m.name).join(', ')}>
            <span class="party-pill">
              {emoji && <span aria-hidden="true">{emoji}</span>}
              {party}
            </span>
            <Avatars members={members} size={20} />
          </span>
        )}
      </div>
    </summary>
    {hasDetails && (
      <div class="details">
        {idea.notes && <div class="prose" lang={trip.locale} set:html={markdown(idea.notes)} />}
        <div class="links">
          {idea.url && (
            <a class="button" href={idea.url} target="_blank" rel="noopener noreferrer">
              <Icon name="link" size={15} />
              {t('item.website')}
            </a>
          )}
          {places
            .filter((p) => p.url)
            .map((p) => (
              <a class="button" href={p.url} target="_blank" rel="noopener noreferrer">
                <Icon name="pin" size={15} />
                {p.name}
              </a>
            ))}
        </div>
      </div>
    )}
  </details>
</article>

<style>
  .idea {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 0 var(--space-3);
    padding: 14px var(--space-4);
    align-items: start;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    color: var(--kind);
    border: 1.5px dashed color-mix(in srgb, var(--kind) 55%, transparent);
  }

  .main {
    min-width: 0;
  }

  summary {
    list-style: none;
    display: grid;
    gap: 3px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  [data-expandable] > summary {
    cursor: pointer;
  }

  [data-expandable] > summary h3::after {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 8px;
    border-right: 1.6px solid var(--label-tertiary);
    border-bottom: 1.6px solid var(--label-tertiary);
    transform: translateY(-3px) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  [data-expandable][open] > summary h3::after {
    transform: translateY(0) rotate(-135deg);
  }

  h3 {
    font-size: 16px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .place {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    font-size: 14px;
  }

  .place :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--label-tertiary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 3px;
  }

  /* Plans for a subset of the trip carry their party: a rail and a pill. */
  .idea:not(.shared) {
    box-shadow: inset 3px 0 0 hsl(var(--party-hue) 65% 55%);
  }

  .party-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    color: hsl(var(--party-hue) 55% 38%);
    background: hsl(var(--party-hue) 70% 50% / 0.12);
  }

  @media (prefers-color-scheme: dark) {
    .party-pill {
      color: hsl(var(--party-hue) 80% 72%);
    }
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-size: 14px;
  }

  .details {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .links:empty {
    display: none;
  }

  .links .button {
    min-height: 32px;
    font-size: 14px;
    padding-inline: 12px;
  }
</style>
