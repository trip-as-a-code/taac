---
import type { Idea, TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import ThreadButton from '@/components/ThreadButton.astro'
import Money from '@/components/Money.astro'
import type { I18n } from '@/i18n'
import { ideaFacts, isLabelled, issuesOf } from '@/lib/facts'
import { sourceHref, sourceLabel } from '@/lib/source'
import { echoesPlace, kindIcon, kindTint, markdown, partyEmoji, partyLabel, people, statusTone } from '@/lib/trip'

interface Props {
  trip: TripExport
  idea: Idea
  i18n: I18n
  /** On an itinerary day: marked as proposed, the date already given. */
  proposed?: boolean
  /** Under its choice's heading, which names the choice already. */
  grouped?: boolean
  /** Its choice was settled by a plan, and this wasn't it. */
  notChosen?: boolean
}

const { trip, idea, i18n, proposed, grouped, notChosen } = Astro.props
const choice = trip.choices.find((c) => c.id === idea.choice)
const { t, date } = i18n
// When it is proposed for, if at all: the date (unless the day says it) and
// the time or rough part of the day.
const when = idea.local
  ? [
      proposed ? undefined : date(idea.local.date, { day: 'numeric', month: 'short' }),
      idea.local.time
        ? `${idea.local.time}${idea.local.endTime ? `–${idea.local.endTime}` : ''}`
        : idea.local.part && t(`part.${idea.local.part}`),
    ]
      .filter(Boolean)
      .join(' · ')
  : undefined
const places = idea.places.map((id) => trip.places[id]).filter(Boolean)
const members = trip.members.filter((m) => idea.members.includes(m.id))
const everyone = members.length === trip.members.length
const party = partyLabel(trip, idea.party, i18n.t('lens.everyone'), i18n.t('party.and'))
const emoji = partyEmoji(trip, idea.party)
// As on plan cards: say what's wrong (or how much), details in the list.
const issues = [...new Map(issuesOf(trip, idea.id).map((d) => [d.code, d])).values()]
const unassigned = issues.some((d) => d.code === 'item.unassigned')
const issueLabel = (code: string) => (isLabelled(code) ? t(`issue.${code}`) : t('issue.other'))
const hasDetails = Boolean(issues.length || idea.notes || idea.url || places.length || sourceHref(idea.source))
---

<article
  id={`idea-${idea.id}`}
  data-item
  data-people={people(idea.members)}
  data-party={idea.party}
  data-facts={JSON.stringify(ideaFacts(trip, idea))}
  data-status={idea.priority}
  style={`--kind:${kindTint[idea.kind]}`}
  class:list={['idea', { shared: everyone, proposed, 'not-chosen': notChosen }]}
>
  <div class="glyph" aria-hidden="true">
    <Icon name={kindIcon[idea.kind]} size={18} />
  </div>
  <details class="main" data-expandable={hasDetails ? '' : undefined}>
    <summary>
      <h3 class="headline" lang={trip.locale}>
        {idea.title}
      </h3>
      {places.length > 0 && !echoesPlace(idea.title, places) && (
        <p class="subhead secondary place">
          <Icon name="pin" size={14} />
          <span lang={trip.locale}>{places.map((p) => p.name).join(' · ')}</span>
        </p>
      )}
      <div class="meta">
        {proposed && <span class="badge proposal">{t('ideas.proposed')}</span>}
        {when && <span class="footnote secondary">{when}</span>}
        {notChosen && <span class="badge">{t('ideas.notChosen')}</span>}
        {choice && !grouped && (
          <span class="badge" title={t('ideas.choiceOf', { name: choice.name })} lang={trip.locale}>
            <span class="ellipsis">⇄ {choice.name}</span>
          </span>
        )}
        {/* Not chosen: nothing left to book or to insist on. */}
        {!notChosen && idea.booking?.status === 'required' && (
          <span class="badge" data-tone={statusTone.required}>
            {t('status.required')}
          </span>
        )}
        {!notChosen && idea.booking?.status === 'required' && idea.booking.deadline && (
          <time class="footnote deadline" data-relative={idea.booking.deadline} data-template={t('bookings.due')} />
        )}
        {!notChosen && idea.priority === 'must' && (
          <span class="badge" data-tone="orange">
            ★ {t('ideas.must')}
          </span>
        )}
        {idea.duration && <span class="footnote secondary">{t(`ideas.duration.${idea.duration}`)}</span>}
        {idea.costs.map((c) => (
          <Money
            display={trip.currency?.base ?? 'EUR'}
            amount={c.amount}
            currency={c.currency}
            charged={c.charged}
            lang={i18n.lang}
            class="footnote secondary"
          />
        ))}
        {everyone ? (
          !unassigned && (
            <span class="who" title={members.map((m) => m.name).join(', ')}>
              <span class="party-pill">
                <span class="ellipsis">{party}</span>
              </span>
            </span>
          )
        ) : (
          <span class="who" title={members.map((m) => m.name).join(', ')}>
            <span class="party-pill">
              {emoji && <span aria-hidden="true">{emoji}</span>}
              <span class="ellipsis">{party}</span>
            </span>
            <Avatars members={members} size={20} />
          </span>
        )}
      </div>
      {issues.length > 0 && (
        <p class="issues footnote">
          <span aria-hidden="true">⚠︎</span>
          <span class="ellipsis">
            {issues.length === 1 ? issueLabel(issues[0].code) : i18n.plural('issues.count', issues.length)}
          </span>
        </p>
      )}
    </summary>
    {hasDetails && (
      <div class="details">
        {issues.length > 0 && (
          <p class="issue-link footnote">
            <a href={i18n.path(`/trips/${trip.slug}/#issue-${idea.id}`)}>{t('issues.inList')} →</a>
          </p>
        )}
        {idea.notes && <div class="prose" lang={trip.locale} set:html={markdown(idea.notes)} />}
        <div class="links">
          {places.length > 0 && (
            <a class="button" href={i18n.path(`/trips/${trip.slug}/map/#item-${idea.id}`)}>
              <Icon name="map" size={15} />
              <span>{t('item.onMap')}</span>
            </a>
          )}
          {/* The line in the trip files that says all this. */}
          {sourceHref(idea.source) && (
            <a class="button" href={sourceHref(idea.source)} target="_blank" rel="noopener noreferrer">
              <Icon name="code" size={15} />
              <span class="tabular">{sourceLabel(idea.source!)}</span>
            </a>
          )}
          {idea.url && (
            <a class="button" href={idea.url} target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={15} />
              <span>{t('item.website')}</span>
            </a>
          )}
          {places
            .filter((p) => p.url)
            .map((p) => (
              <a class="button" href={p.url} target="_blank" rel="noopener noreferrer" title={p.name}>
                <Icon name="external" size={15} />
                <span>{p.name}</span>
              </a>
            ))}
        </div>
      </div>
    )}
  </details>
  {/* Outside the summary: a link inside the toggle would be a control
     within a control. Positioned beside the title. */}
  <div class="card-tools">
    <ThreadButton anchor={`idea:${idea.id}`} title={idea.title} i18n={i18n} />
    <a
      class="anchor"
      href={`#idea-${idea.id}`}
      data-anchor
      aria-label={t('item.copyLink')}
      title={t('item.copyLink')}
      data-failed={t('item.copyFailed')}
    >
      <Icon name="link" size={14} class="anchor-link" />
      <Icon name="check" size={14} class="anchor-check" />
    </a>
  </div>
</article>

<style>
  /* An alternative that lost out: still there to look at, out of the way. */
  .not-chosen {
    opacity: 0.55;
  }

  /* On an itinerary day: a dashed outline says "not decided yet". */
  .idea.proposed {
    border: 1px dashed var(--separator-strong);
    border-radius: var(--radius);
  }

  .proposal {
    color: var(--label-secondary);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--separator-strong);
  }

  .deadline {
    color: var(--orange);
    font-weight: 500;
  }

  .idea {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 0 var(--space-3);
    padding: 14px var(--space-4);
    align-items: start;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    color: var(--kind);
    border: 1.5px dashed color-mix(in srgb, var(--kind) 55%, transparent);
  }

  .main {
    min-width: 0;
  }

  summary {
    list-style: none;
    display: grid;
    gap: 3px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  [data-expandable] > summary {
    cursor: pointer;
  }

  /* The disclosure chevron sits in the corner, so it never wraps onto a
     line of its own after a long title. */
  /* The title makes room for the copy-link button and, when the card
     opens, the chevron; the rows below keep the full width. */
  summary h3 {
    padding-right: 28px;
  }

  /* And for the discussions button, once it shows. */
  .idea:has(> .card-tools :global(.thread-button:not([hidden]))) summary h3 {
    padding-right: 56px;
  }

  [data-expandable] > summary {
    position: relative;
  }

  [data-expandable] > summary h3 {
    padding-right: 50px;
  }

  .idea:has(> .card-tools :global(.thread-button:not([hidden]))) [data-expandable] > summary h3 {
    padding-right: 78px;
  }

  .card-tools {
    position: absolute;
    top: 14px;
    right: var(--space-4);
    display: flex;
    gap: 2px;
  }

  .card-tools .anchor {
    margin: 0;
  }

  [data-expandable] ~ .card-tools {
    right: calc(var(--space-4) + 22px);
  }

  [data-expandable] > summary h3::after {
    content: '';
    position: absolute;
    top: 7px;
    right: 4px;
    width: 7px;
    height: 7px;
    border-right: 1.6px solid var(--label-tertiary);
    border-bottom: 1.6px solid var(--label-tertiary);
    transform: translateY(-3px) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  [data-expandable][open] > summary h3::after {
    transform: translateY(0) rotate(-135deg);
  }

  h3 {
    font-size: 16px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .place {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    font-size: 14px;
  }

  .place :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--label-tertiary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 3px;
  }

  /* Ideas for a subset of the trip carry their party by name, not by colour. */
  .party-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    max-width: 100%;
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--label-secondary);
    background: var(--fill);
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    margin-left: auto;
    font-size: 14px;
  }

  .details {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .links:empty {
    display: none;
  }

  /* Pills stay one line: a long place name ends in an ellipsis. */
  .links .button {
    max-width: 100%;
    min-height: 32px;
    font-size: 14px;
    padding-inline: 12px;
  }

  .links .button :global(svg) {
    flex: none;
  }

  .links .button span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .idea {
      grid-template-columns: minmax(0, 1fr);
    }

    .glyph {
      display: none;
    }
  }

  .issues {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    margin: 2px 0 0;
    font-weight: 600;
    color: var(--orange);
  }

  .issue-link {
    margin: 0;
    font-weight: 600;
  }
</style>
