---
import type { TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import type { I18n } from '@/i18n'
import { tripHue } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
  locked: boolean
}

const { trip, i18n, locked } = Astro.props
const { t, plural, dateRange, path } = i18n
const hue = tripHue(trip)
---

<a class="trip-card" href={path(`/trips/${trip.slug}/`)} style={`--hue:${hue}`}>
  <div class="cover" transition:name={`cover-${trip.slug}`}>
    <span class="emoji" aria-hidden="true">
      {trip.cover?.emoji ?? '🧭'}
    </span>
    {locked && (
      <span class="lock" title={t('site.locked')}>
        <Icon name="lock" size={15} />
      </span>
    )}
  </div>
  <div class="body">
    <h2 class="title-3" lang={trip.locale}>
      {trip.title}
    </h2>
    {!locked && (
      <>
        <p class="subhead secondary">{dateRange(trip.startDate, trip.endDate)}</p>
        <div class="meta">
          <Avatars members={trip.members} size={24} />
          <span class="footnote secondary">{plural('trip.days', trip.days.length)}</span>
          {trip.startDate && (
            <time class="footnote countdown" data-relative={trip.startDate} data-template={t('trip.startsIn')} />
          )}
        </div>
      </>
    )}
    {locked && <p class="subhead secondary">{t('site.locked')}</p>}
  </div>
</a>

<style>
  .trip-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    background: var(--bg-grouped);
    box-shadow: var(--shadow-md);
    overflow: clip;
    color: inherit;
    text-decoration: none;
    transition:
      transform 360ms var(--ease),
      box-shadow 360ms var(--ease);
  }

  .trip-card:hover {
    transform: translateY(-3px) scale(1.005);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .trip-card:active {
    transform: scale(0.99);
  }

  .cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(120% 90% at 20% 10%, hsl(var(--hue) 95% 78%), transparent 60%),
      radial-gradient(120% 120% at 90% 100%, hsl(calc(var(--hue) + 40) 85% 55%), transparent 55%),
      linear-gradient(160deg, hsl(var(--hue) 80% 66%), hsl(calc(var(--hue) + 25) 75% 42%));
  }

  .emoji {
    font-size: clamp(56px, 9vw, 84px);
    filter: drop-shadow(0 10px 24px rgb(0 0 0 / 0.25));
    transition: transform 500ms var(--ease);
  }

  .trip-card:hover .emoji {
    transform: scale(1.06) rotate(-3deg);
  }

  .lock {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: white;
    background: rgb(0 0 0 / 0.28);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .body {
    display: grid;
    gap: 6px;
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .countdown {
    margin-left: auto;
    font-weight: 600;
    color: hsl(var(--hue) 70% 42%);
  }

  @media (prefers-color-scheme: dark) {
    .countdown {
      color: hsl(var(--hue) 85% 70%);
    }
  }
</style>
