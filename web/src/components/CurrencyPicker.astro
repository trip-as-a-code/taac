---
import type { TripExport } from '@taac/core'

import Select from '@/components/Select.astro'
import type { I18n } from '@/i18n'
import { rates } from '@/lib/build'

interface Props {
  trip: TripExport
  i18n: I18n
}

const { trip, i18n } = Astro.props
const base = trip.currency?.base ?? 'EUR'
// The trip's own currencies first, then everything the ECB publishes.
const own = [
  base,
  ...trip.members.map((m) => m.currency),
  ...trip.budget.lines.flatMap((l) => [l.currency, l.charged?.currency]),
].filter((c): c is string => Boolean(c))
const all = [...new Set([...own, ...Object.keys(rates?.rates ?? {})])]
const names = new Intl.DisplayNames(i18n.lang, { type: 'currency' })
---

{trip.budget.lines.length > 0 && (
  <Select
    data-currency-picker
    data-currency-default={base}
    label={i18n.t('currency.label')}
    i18n={i18n}
    variant="pill"
    class="currency"
    value={base}
    options={all.map((code) => ({ value: code, label: `${code} · ${names.of(code)}`, short: code }))}
  />
)}
<script type="application/json" id="taac-rates" set:html={JSON.stringify(rates)} />
<script>
  import { displayCurrency, initMoney, setDisplayCurrency } from '@/scripts/money'

  function setup() {
    initMoney()
    const select = document.querySelector<HTMLSelectElement>('select[data-currency-picker]')
    if (!select) return
    if (![...select.options].some((o) => o.value === displayCurrency())) {
      select.add(new Option(displayCurrency(), displayCurrency()))
    }
    select.value = displayCurrency()
    select.addEventListener('change', () => setDisplayCurrency(select.value))
  }

  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .currency {
    flex: none;
  }
</style>
