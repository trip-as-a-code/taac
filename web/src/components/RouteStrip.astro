---
import type { TripExport } from '@taac/core'

import type { I18n } from '@/i18n'
import { daysBetween, routeRows, tripHue } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
}

const { trip, i18n } = Astro.props
const { plural, dateRange, date, path } = i18n
const rows = routeRows(trip, i18n.t('party.and'))
// One shared day grid, so parallel tracks line up in time.
const start = trip.startDate ?? rows[0]?.bases[0]?.from ?? ''
const columns = trip.days.length || 1
---

<div class="route" style={`--hue:${tripHue(trip)};--columns:${columns}`}>
  <div class="grid">
    {rows.map((row) => (
      <>
        {row.label && (
          <span class="footnote secondary label" data-route-people={row.members.join(' ')}>
            {row.emoji} {row.label}
          </span>
        )}
        {row.bases.map((base, index) => (
          <a
            href={path(`/trips/${trip.slug}/itinerary/#${base.from}`)}
            class="stop"
            data-route-people={row.members.join(' ')}
            data-alt={index % 2 === 1 ? '' : undefined}
            style={`grid-column:${daysBetween(start, base.from) + 1} / span ${base.nights}`}
            title={`${base.title} · ${plural('trip.nightsShort', base.nights)} · ${dateRange(base.from, base.to)}`}
          >
            <span class="name" lang={trip.locale}>
              {base.title}
            </span>
            <span class="nights">{plural('trip.nightsShort', base.nights)}</span>
          </a>
        ))}
      </>
    ))}
  </div>
  {/* Phones: the same route as a list, one stop per line. */}
  <div class="list-view">
    {rows.map((row) => (
      <section>
        {row.label && (
          <span class="footnote secondary label" data-route-people={row.members.join(' ')}>
            {row.emoji} {row.label}
          </span>
        )}
        <ol class="card stop-list" data-route-people={row.members.join(' ')}>
          {row.bases.map((base, index) => (
            <li>
              <a href={path(`/trips/${trip.slug}/itinerary/#${base.from}`)} data-alt={index % 2 === 1 ? '' : undefined}>
                <span class="dot" aria-hidden="true" />
                <span class="name" lang={trip.locale}>
                  {base.title}
                </span>
                <span class="when footnote secondary tabular">
                  {date(base.from, { day: 'numeric', month: 'short' })} · {plural('trip.nightsShort', base.nights)}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</div>

<style>
  .route {
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .route::-webkit-scrollbar {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(26px, 1fr));
    grid-auto-flow: row;
    gap: 6px 3px;
    min-width: calc(var(--columns) * 29px);
  }

  .label {
    grid-column: 1 / -1;
    margin-top: 4px;
    font-weight: 600;
  }

  .stop {
    display: grid;
    align-content: center;
    gap: 1px;
    min-width: 0;
    min-height: 54px;
    padding: 8px 10px;
    border-radius: 12px;
    color: var(--label);
    text-decoration: none;
    background: hsl(var(--hue) 70% 50% / 0.1);
    box-shadow: inset 0 3px 0 hsl(var(--hue) 70% 55%);
    transition: background var(--duration) var(--ease);
  }

  .stop[data-alt] {
    background: hsl(calc(var(--hue) + 35) 70% 50% / 0.1);
    box-shadow: inset 0 3px 0 hsl(calc(var(--hue) + 35) 70% 55%);
  }

  .stop:hover {
    text-decoration: none;
    background: hsl(var(--hue) 70% 50% / 0.18);
  }

  .name,
  .nights {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: 15px;
    font-weight: 600;
  }

  .nights {
    font-size: 12px;
    color: var(--label-secondary);
  }

  .list-view {
    display: none;
  }

  @media (max-width: 900px) {
    .grid {
      display: none;
    }

    .list-view {
      display: grid;
      gap: var(--space-3);
    }

    .list-view section {
      display: grid;
      gap: 6px;
    }

    .stop-list {
      list-style: none;
      margin: 0;
      padding: 4px 0;
    }

    .stop-list a {
      display: grid;
      grid-template-columns: 12px minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      padding: 10px var(--space-4);
      color: var(--label);
      text-decoration: none;
    }

    .stop-list li {
      position: relative;
    }

    /* A thin line threads the stops together, like a journey. */
    .stop-list li + li::before {
      content: '';
      position: absolute;
      top: -10px;
      left: calc(var(--space-4) + 5px);
      height: 20px;
      border-left: 2px solid hsl(var(--hue) 60% 60% / 0.35);
    }

    .stop-list .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: hsl(var(--hue) 70% 55%);
      box-shadow: 0 0 0 3px hsl(var(--hue) 70% 55% / 0.18);
    }

    .stop-list a[data-alt] .dot {
      background: hsl(calc(var(--hue) + 35) 70% 55%);
      box-shadow: 0 0 0 3px hsl(calc(var(--hue) + 35) 70% 55% / 0.18);
    }

    .stop-list .name {
      font-size: 16px;
      font-weight: 600;
      white-space: normal;
    }

    .route {
      overflow: visible;
    }
  }
</style>
