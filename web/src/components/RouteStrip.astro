---
import type { TripExport } from '@taac/core'

import type { I18n } from '@/i18n'
import { daysBetween, routeRows, tripHue } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
}

const { trip, i18n } = Astro.props
const { plural, dateRange, path } = i18n
const rows = routeRows(trip)
// One shared day grid, so parallel tracks line up in time.
const start = trip.startDate ?? rows[0]?.bases[0]?.from ?? ''
const columns = trip.days.length || 1
---

<div class="route" style={`--hue:${tripHue(trip)};--columns:${columns}`}>
  <div class="grid">
    {
      rows.map((row) => (
        <>
          {row.label && (
            <span class="footnote secondary label">
              {row.emoji} {row.label}
            </span>
          )}
          {row.bases.map((base, index) => (
            <a
              href={path(`/trips/${trip.slug}/itinerary/#${base.from}`)}
              class="stop"
              data-alt={index % 2 === 1 ? '' : undefined}
              style={`grid-column:${daysBetween(start, base.from) + 1} / span ${base.nights}`}
              title={`${base.title} · ${plural('trip.nightsShort', base.nights)} · ${dateRange(base.from, base.to)}`}
            >
              <span class="name" lang={trip.locale}>
                {base.title}
              </span>
              <span class="nights">{plural('trip.nightsShort', base.nights)}</span>
            </a>
          ))}
        </>
      ))
    }
  </div>
</div>

<style>
  .route {
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .route::-webkit-scrollbar {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(26px, 1fr));
    grid-auto-flow: row;
    gap: 6px 3px;
    min-width: calc(var(--columns) * 29px);
  }

  .label {
    grid-column: 1 / -1;
    margin-top: 4px;
    font-weight: 600;
  }

  .stop {
    display: grid;
    align-content: center;
    gap: 1px;
    min-width: 0;
    min-height: 54px;
    padding: 8px 10px;
    border-radius: 12px;
    color: var(--label);
    text-decoration: none;
    background: hsl(var(--hue) 70% 50% / 0.1);
    box-shadow: inset 0 3px 0 hsl(var(--hue) 70% 55%);
    transition: background var(--duration) var(--ease);
  }

  .stop[data-alt] {
    background: hsl(calc(var(--hue) + 35) 70% 50% / 0.1);
    box-shadow: inset 0 3px 0 hsl(calc(var(--hue) + 35) 70% 55%);
  }

  .stop:hover {
    text-decoration: none;
    background: hsl(var(--hue) 70% 50% / 0.18);
  }

  .name,
  .nights {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .name {
    font-size: 15px;
    font-weight: 600;
  }

  .nights {
    font-size: 12px;
    color: var(--label-secondary);
  }
</style>
