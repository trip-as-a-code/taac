---
import { useI18n, type Locale } from '@/i18n'

interface Props {
  lang: Locale
}

const { t } = useI18n(Astro.props.lang)
---

{/* Browser notifications on this device (scripts/notifications.ts): a switch, or why there is none. */}
<ul
  class="list push-settings"
  data-push-toggle
  data-hint={t('push.hint')}
  data-denied={t('push.denied')}
  data-unsupported={t('push.unsupported')}
  data-home-screen={t('push.homeScreen')}
>
  <li class="row">
    <span class="label">
      <span id="push-title">{t('push.device')}</span>
      <span class="footnote secondary" id="push-status" data-push-status>
        {t('push.hint')}
      </span>
    </span>
    <button
      class="switch"
      type="button"
      role="switch"
      aria-checked="false"
      aria-labelledby="push-title"
      aria-describedby="push-status"
      data-push-switch
      hidden
    >
      <span class="knob"></span>
    </button>
  </li>
</ul>

<style>
  .push-settings [hidden] {
    display: none;
  }

  .label {
    display: grid;
    flex: 1;
    min-width: 0;
  }
</style>
