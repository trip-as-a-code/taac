---
import { useI18n, type Locale } from '@/i18n'

interface Props {
  lang: Locale
}

const { t } = useI18n(Astro.props.lang)
---

{/* Browser notifications on this device (scripts/notifications.ts): a switch, or why there is none, and a test. */}
<ul
  class="list push-settings"
  data-push-toggle
  data-hint={t('push.hint')}
  data-denied={t('push.denied')}
  data-unsupported={t('push.unsupported')}
  data-home-screen={t('push.homeScreen')}
  data-sent={t('push.sent')}
  data-failed={t('push.sendFailed')}
>
  <li class="row">
    <label class="label" for="push-switch">
      <span>{t('push.device')}</span>
      <span class="footnote secondary" data-push-status>
        {t('push.hint')}
      </span>
    </label>
    <button id="push-switch" class="switch" type="button" role="switch" aria-checked="false" data-push-switch hidden>
      <span class="knob"></span>
    </button>
  </li>
  <li class="row" data-push-test-row hidden>
    <span class="label">
      <span>{t('push.test')}</span>
      <span class="footnote secondary" data-push-test-status></span>
    </span>
    <button class="button" type="button" data-push-test>
      {t('push.send')}
    </button>
  </li>
</ul>

<style>
  .push-settings [hidden] {
    display: none;
  }

  .label {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  label.label {
    cursor: pointer;
  }

  /* The system switch: green when on. */
  .switch {
    position: relative;
    flex: none;
    width: 51px;
    height: 31px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--fill-strong);
    cursor: pointer;
    transition: background var(--duration) var(--ease);
  }

  .switch[aria-checked='true'] {
    background: var(--green);
  }

  .switch:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: white;
    box-shadow:
      0 3px 8px rgb(0 0 0 / 0.15),
      0 1px 1px rgb(0 0 0 / 0.16);
    transition: transform var(--duration) var(--ease);
  }

  .switch[aria-checked='true'] .knob {
    transform: translateX(20px);
  }
</style>
