---
import type { Idea, Presence, TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import Blockers from '@/components/Blockers.astro'
import IdeaRow from '@/components/IdeaRow.astro'
import ItemRow from '@/components/ItemRow.astro'
import OpenDay from '@/components/OpenDay.astro'
import Whereabouts from '@/components/Whereabouts.astro'
import type { I18n } from '@/i18n'
import { photosOnce } from '@/lib/photos'
import { isTransport, spans } from '@/lib/presence'
import { baseById, itemById, partyEmoji, partyLabel } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
  day: TripExport['days'][number]
  /** Days this stands for: more than one for a folded run. */
  span?: number
  /** Ideas proposed for this day. */
  proposals?: Idea[]
  homeOffset?: string
}

const { trip, i18n, day, span = 1, proposals = [], homeOffset } = Astro.props
const { t } = i18n
const items = itemById(trip)
const bases = baseById(trip)
const plans = day.items.map((id) => items.get(id)!)
const within = (inner: string[], outer: string[]) => inner.every((m) => outer.includes(m))
const same = (a: string[], b: string[]) => a.length === b.length && within(a, b)
const rank = (party: string) => {
  const i = trip.parties.findIndex((p) => p.id === party)
  return i < 0 ? trip.parties.length : i
}

// When the travellers go separate ways, each group gets its own section,
// headed by who they are (and where, when they're in different places): the
// heading says whose it is, so nothing depends on reading colours. Groups are
// the bases when people are in different places; else, as soon as one plan is
// for only some of the people there, the groups those plans are for plus
// everyone else (whose free day it may be).
interface Group {
  party: string
  members: string[]
  /** Their own base, when the group is in a place of its own. */
  base?: Presence
  /** Their share of a base they have in common with others. */
  open?: Presence
}
const baseSplit = !trip.basesDerived && new Set(day.bases.map((b) => b.party)).size > 1
const partyOf = (members: string[]) => trip.parties.find((p) => same(p.members, members))?.id ?? members.join('+')
// Who is here: from the bases, or (a travel day without one) from the plans and blockers.
const present = [
  ...new Set(
    day.bases.length ? day.bases.flatMap((b) => b.members) : [...plans, ...day.blockers].flatMap((x) => x.members),
  ),
]
let groups: Group[] = []
if (baseSplit) groups = day.bases.map((b) => ({ party: b.party, members: b.members, base: b }))
else {
  const parties = [...new Set(plans.filter((p) => p.party !== 'everyone').map((p) => p.party))].map((party) => ({
    party,
    members: trip.parties.find((p) => p.id === party)?.members ?? [],
  }))
  const disjoint = parties.every((a, i) =>
    parties.slice(i + 1).every((b) => !a.members.some((m) => b.members.includes(m))),
  )
  const rest = present.filter((m) => !parties.some((p) => p.members.includes(m)))
  const all = rest.length ? [...parties, { party: partyOf(rest), members: rest }] : parties
  if (all.length > 1 && disjoint) {
    const shared = !trip.basesDerived && day.bases.length === 1 ? day.bases[0] : undefined
    groups = all.map((g) => ({ ...g, open: shared && { id: shared.id, members: g.members, party: g.party } }))
  }
}
groups.sort((a, b) => rank(a.party) - rank(b.party))
const groupOf = (members: string[]) => groups.find((g) => within(members, g.members))
const mine = <T extends { members: string[] }>(list: T[], g: Group) => list.filter((x) => groupOf(x.members) === g)
const shared = <T extends { members: string[] }>(list: T[]) => list.filter((x) => !groupOf(x.members))
const label = (party: string) =>
  `${partyEmoji(trip, party) ?? ''} ${partyLabel(trip, party, t('lens.everyone'), t('party.and'))}`.trim()
const whoIn = (ids: string[]) => trip.members.filter((m) => ids.includes(m.id))
const parts = trip.basesDerived ? [] : day.bases
// Whatever ran past midnight ends today (stays aside: their beds show nightly):
// a journey arrives (home, when that ends someone's trip), anything else ends.
const arrivals = trip.items.filter(
  (i) => i.kind !== 'lodging' && i.local.endDate === day.date && i.local.endDate !== i.local.date,
)
const home = (i: (typeof arrivals)[number]) =>
  isTransport(i.kind) && i.members.some((m) => spans(trip).get(m)?.last === day.date)
const arrival = (i: (typeof arrivals)[number]) => {
  const place = isTransport(i.kind) ? (trip.places[i.places.at(-1) ?? '']?.name ?? i.title) : i.title
  const vars = { time: i.local.endTime ?? '', place }
  return home(i) ? t('trip.arriveHome', vars) : isTransport(i.kind) ? t('trip.arrive', vars) : t('trip.endsAt', vars)
}
---

{/* What concerns more than one group (or everyone) comes first. */}
<Blockers trip={trip} i18n={i18n} date={day.date} blockers={groups.length ? shared(day.blockers) : day.blockers} />
{shared(arrivals).map((a) => (
  <a class="arrival footnote" href={`#item-${a.id}`} data-presence data-people={a.members.join(' ')}>
    <Icon name={home(a) ? 'home' : isTransport(a.kind) ? 'arrowRight' : 'clock'} size={14} />
    <span class="ellipsis">{arrival(a)}</span>
    {/* Whose journey or plan this is: the day may hold others. */}
    <span class="arrival-who">
      <Avatars members={whoIn(a.members)} size={18} />
    </span>
  </a>
))}
{!baseSplit && <Whereabouts trip={trip} i18n={i18n} date={day.date} span={span} bases={day.bases} stays={day.stays} />}
{shared(plans).length > 0 && (
  <div class="card list">
    {photosOnce(trip, shared(plans)).map(([item, photo]) => (
      <div class="row-wrap">
        {/* For exactly who is here (the rest have gone home): no need to say whose. */}
        <ItemRow
          trip={trip}
          item={item}
          i18n={i18n}
          homeOffset={homeOffset}
          grouped={item.party !== 'everyone' && present.length > 0 && same(item.members, present)}
          photo={photo}
        />
      </div>
    ))}
  </div>
)}
{shared(proposals).length > 0 && (
  <div class="proposals" aria-label={t('ideas.proposed')}>
    {shared(proposals).map((idea) => (
      <IdeaRow trip={trip} idea={idea} i18n={i18n} proposed />
    ))}
  </div>
)}

{groups.length > 0 ? (
  <div class="groups">
    {groups.map((g) => (
      <section class="group" data-group aria-label={label(g.party)}>
        {g.base ? (
          <Whereabouts
            trip={trip}
            i18n={i18n}
            date={day.date}
            span={span}
            bases={[g.base]}
            stays={day.stays.filter((s) => within(s.members, g.members))}
            named
          />
        ) : (
          <header class="group-head subhead" data-presence data-people={g.members.join(' ')}>
            <span class="ellipsis">{label(g.party)}</span>
            <Avatars members={whoIn(g.members)} size={20} />
          </header>
        )}
        <Blockers trip={trip} i18n={i18n} date={day.date} blockers={mine(day.blockers, g)} />
        {mine(arrivals, g).map((a) => (
          <a class="arrival footnote" href={`#item-${a.id}`} data-presence data-people={a.members.join(' ')}>
            <Icon name={home(a) ? 'home' : isTransport(a.kind) ? 'arrowRight' : 'clock'} size={14} />
            <span class="ellipsis">{arrival(a)}</span>
            {/* Whose journey or plan this is: the day may hold others. */}
            <span class="arrival-who">
              <Avatars members={whoIn(a.members)} size={18} />
            </span>
          </a>
        ))}
        {mine(plans, g).length > 0 && (
          <div class="card list">
            {photosOnce(trip, mine(plans, g)).map(([item, photo]) => (
              <div class="row-wrap">
                <ItemRow
                  trip={trip}
                  item={item}
                  i18n={i18n}
                  homeOffset={homeOffset}
                  grouped={same(item.members, g.members)}
                  photo={photo}
                />
              </div>
            ))}
          </div>
        )}
        {mine(proposals, g).length > 0 && (
          <div class="proposals" aria-label={t('ideas.proposed')}>
            {mine(proposals, g).map((idea) => (
              <IdeaRow trip={trip} idea={idea} i18n={i18n} proposed />
            ))}
          </div>
        )}
        {(g.base ?? g.open) && (
          <OpenDay
            trip={trip}
            i18n={i18n}
            part={(g.base ?? g.open)!}
            base={bases.get((g.base ?? g.open)!.id)!}
            free={mine(plans, g).length === 0}
          />
        )}
      </section>
    ))}
  </div>
) : parts.length > 0 ? (
  parts.map((p) => (
    <OpenDay
      trip={trip}
      i18n={i18n}
      part={p}
      base={bases.get(p.id)!}
      free={!plans.some((i) => i.members.some((m) => p.members.includes(m)))}
      split={parts.length > 1}
    />
  ))
) : (
  plans.length === 0 && arrivals.length === 0 && <p class="free footnote secondary">{t('trip.freeDay')}</p>
)}

<style>
  .card.list > .row-wrap + .row-wrap {
    position: relative;
    border-top: 0;
  }

  .row-wrap + .row-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 128px;
    right: 0;
    border-top: 0.5px solid var(--separator);
  }

  .row-wrap:has([data-item][hidden]) {
    display: none;
  }

  @media (max-width: 560px) {
    .row-wrap + .row-wrap::before {
      left: 0;
    }
  }

  .card.list + .groups,
  .proposals + .groups {
    margin-top: var(--space-4);
  }

  /* Side by side where there's room, one under the other on a phone. */
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--space-5) var(--space-4);
    align-items: start;
  }

  .group {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .group[hidden] {
    display: none;
  }

  .group > :global(*) {
    margin: 0 !important;
  }

  .group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 600;
    background: var(--fill);
  }

  .group-head[hidden] {
    display: none;
  }

  /* Where yesterday's overnight line lands: the same dashed rail, then solid ground. */
  .arrival {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 var(--space-3) var(--rail, 0);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-5);
    border-left: 2px dashed var(--separator-strong);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--label);
    background: var(--fill);
    text-decoration: none;
  }

  .arrival :global(svg) {
    flex: none;
  }

  .arrival-who {
    display: flex;
    flex: none;
    margin-left: auto;
  }

  .arrival:hover {
    background: var(--fill-strong);
  }

  .arrival[hidden] {
    display: none;
  }

  /* Proposed, not planned: separate dashed cards rather than one list. */
  .proposals {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .free {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--separator-strong);
    text-align: center;
  }
</style>
