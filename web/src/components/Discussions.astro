---
import type { TripExport } from '@taac/core'

import Icon from '@/components/Icon.astro'
import type { I18n } from '@/i18n'
import { initials, memberHue } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
}

const { trip, i18n } = Astro.props
const { t } = i18n
// Authors by GitHub login: the member's name, initials and colour.
const people = Object.fromEntries(
  trip.members
    .filter((m) => m.github)
    .map((m) => [m.github!.toLowerCase(), { name: m.name, initials: initials(m), hue: memberHue(m.id) }]),
)
const strings = Object.fromEntries(
  (
    [
      'reply',
      'replyPlaceholder',
      'send',
      'resolve',
      'reopen',
      'resolvedBy',
      'resolvedCount',
      'edit',
      'save',
      'cancel',
      'delete',
      'confirm',
      'edited',
      'deleted',
      'error',
      'new',
      'newPlaceholder',
      'collapse',
      'railReplies',
    ] as const
  ).map((k) => [k, t(`comments.${k}`)]),
)
---

{/* The discussions of one thing on the trip, opened by its ThreadButton (scripts/comments.ts). */}
<dialog
  class="thread-panel"
  data-thread-panel={trip.slug}
  data-lang={i18n.lang}
  data-people={JSON.stringify(people)}
  data-strings={JSON.stringify(strings)}
  aria-labelledby="thread-panel-title"
>
  <header>
    <div class="heading">
      <span class="footnote secondary">{t('comments.title')}</span>
      <h2 id="thread-panel-title" class="headline" data-panel-title></h2>
    </div>
    <button class="nav-icon-button" type="button" data-panel-close title={t('share.close')}>
      <Icon name="close" size={18} />
      <span class="visually-hidden">{t('share.close')}</span>
    </button>
  </header>
  <div class="threads" data-panel-threads></div>
  <p class="footnote secondary" data-panel-read-only hidden>
    {t('comments.readOnly')}
  </p>
  <form class="composer" data-panel-new hidden>
    <textarea name="body" rows="2" maxlength="4000" placeholder={t('comments.newPlaceholder')} required></textarea>
    <button class="button button-primary" type="submit">
      {t('comments.new')}
    </button>
  </form>
  <p class="footnote error" data-panel-error hidden></p>
</dialog>

<style>
  .thread-panel {
    width: min(560px, calc(100vw - 24px));
    max-height: min(760px, calc(100dvh - 24px));
    padding: var(--space-5);
    border: 0;
    border-radius: 20px;
    background: var(--bg-elevated);
    color: var(--label);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
  }

  .thread-panel::backdrop {
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(2px);
  }

  header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .heading {
    display: grid;
    min-width: 0;
  }

  h2 {
    margin: 0;
  }

  .threads {
    display: grid;
    gap: var(--space-4);
  }

  .composer {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .composer .button {
    justify-self: end;
  }

  .error {
    color: var(--red, #ff453a);
  }

  /* Built by scripts/comments.ts, in this panel and in the cards beside the page. */
  :global(:is(.thread-panel, .thread-card) .thread) {
    position: relative;
    display: grid;
    gap: 12px;
    font-size: 14px;
    line-height: 1.4;
  }

  .thread-panel :global(.thread) {
    padding: var(--space-4);
    border-radius: 14px;
    background: var(--fill);
  }

  /* Resolve (and, in a card, fold) at the top right, like a document's checkmark. */
  :global(:is(.thread-panel, .thread-card) .thread-tools) {
    position: absolute;
    top: -4px;
    right: -4px;
    display: flex;
    gap: 2px;
  }

  .thread-panel :global(.thread-tools) {
    top: 10px;
    right: 10px;
  }

  :global(:is(.thread-panel, .thread-card) .comment) {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 0 10px;
  }

  :global(:is(.thread-panel, .thread-card) .comment .avatar) {
    width: 24px;
    height: 24px;
    font-size: 10px;
    box-shadow: none;
  }

  /* The first comment's line leaves room for the tools. */
  :global(:is(.thread-panel, .thread-card) .thread-tools + .comment .comment-head) {
    padding-right: 60px;
  }

  /* One line as tall as the avatar, name and time on one baseline: centred on it. */
  :global(:is(.thread-panel, .thread-card) .comment-head) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-height: 24px;
    line-height: 24px;
  }

  :global(:is(.thread-panel, .thread-card) .comment-name) {
    flex: 0 0 auto;
    max-width: 100%;
    overflow: hidden;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* The time gives way before the name does. */
  :global(:is(.thread-panel, .thread-card) .comment-when) {
    flex: 0 100 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    color: var(--label-tertiary);
  }

  :global(:is(.thread-panel, .thread-card) .comment-body) {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--label);
  }

  :global(:is(.thread-panel, .thread-card) .comment-body.gone) {
    color: var(--label-tertiary);
    font-style: italic;
  }

  /* Change or take back your own words: quiet until the comment is under the pointer. */
  :global(:is(.thread-panel, .thread-card) .comment-actions) {
    display: none;
    flex: none;
    align-self: center;
    margin-left: auto;
  }

  :global(:is(.thread-panel, .thread-card) .comment:hover .comment-actions),
  :global(:is(.thread-panel, .thread-card) .comment-actions:focus-within) {
    display: flex;
  }

  @media (hover: none) {
    :global(:is(.thread-panel, .thread-card) .comment-actions) {
      display: flex;
    }
  }

  :global(:is(.thread-panel, .thread-card) .icon-button) {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--label-secondary);
    background: transparent;
    cursor: pointer;
  }

  :global(:is(.thread-panel, .thread-card) .icon-button:hover) {
    color: var(--label);
    background: var(--fill);
  }

  :global(:is(.thread-panel, .thread-card) .thread-tools .icon-button:first-child:hover) {
    color: var(--green, #30d158);
  }

  :global(:is(.thread-panel, .thread-card) .comment-actions .icon-button) {
    width: 24px;
    height: 24px;
    color: var(--label-tertiary);
  }

  :global(:is(.thread-panel, .thread-card) .icon-button.danger:hover),
  :global(:is(.thread-panel, .thread-card) .icon-button.danger[data-armed]) {
    color: var(--red, #ff453a);
  }

  /* A message field: its send button inside, round and blue once there is something to send. */
  :global(:is(.thread-panel, .thread-card) .compose) {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    padding: 3px 3px 3px 12px;
    border: 1px solid var(--separator);
    border-radius: 18px;
    background: var(--bg);
  }

  :global(:is(.thread-panel, .thread-card) .compose:focus-within) {
    border-color: var(--tint);
  }

  :global(:is(.thread-panel, .thread-card) .compose textarea) {
    flex: 1;
    min-width: 0;
    max-height: 160px;
    padding: 5px 0;
    border: 0;
    background: transparent;
    color: var(--label);
    font: inherit;
    resize: none;
    outline: none;
  }

  :global(:is(.thread-panel, .thread-card) .compose-send) {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: var(--tint);
    cursor: pointer;
    transition: opacity var(--duration) var(--ease);
  }

  :global(:is(.thread-panel, .thread-card) .compose-send:disabled) {
    opacity: 0.3;
    cursor: default;
  }

  /* An edit in place: the field takes the comment's line. */
  :global(:is(.thread-panel, .thread-card) .comment-main .compose) {
    margin-top: 4px;
  }

  :global(:is(.thread-panel, .thread-card) .thread-note) {
    margin: 0;
    font-size: 12px;
    color: var(--label-secondary);
  }

  :global(:is(.thread-panel, .thread-card) .thread[data-resolved] .comment) {
    opacity: 0.75;
  }

  :global(:is(.thread-panel, .thread-card) .resolved-list summary) {
    cursor: pointer;
    color: var(--label-secondary);
  }

  :global(:is(.thread-panel, .thread-card) .resolved-list[open] summary) {
    margin-bottom: var(--space-3);
  }
</style>
