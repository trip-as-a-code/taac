---
import type { Pass, TripExport } from '@taac/core'

import ItemRow from '@/components/ItemRow.astro'
import type { I18n } from '@/i18n'
import { passItem, passUntil } from '@/lib/trip'

interface Props {
  trip: TripExport
  pass: Pass
  i18n: I18n
}

// A pass as a booking card, the same card as any plan's.
const { trip, pass, i18n } = Astro.props
const item = passItem(pass, i18n.date(passUntil(pass), { day: 'numeric', month: 'short' }))
---

<ItemRow trip={trip} item={item} i18n={i18n} withDate anchor="pass" />
