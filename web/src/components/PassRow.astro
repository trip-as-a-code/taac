---
import type { Pass, TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import Money from '@/components/Money.astro'
import type { I18n } from '@/i18n'
import { isLabelled, issuesOf } from '@/lib/facts'
import { kindIcon, kindTint, markdown, memberName, partyEmoji, partyLabel, people, statusTone } from '@/lib/trip'

interface Props {
  trip: TripExport
  pass: Pass
  i18n: I18n
}

// A pass as a booking card: what, where and when, its people and price,
// opening to its costs and links like a plan's.
const { trip, pass, i18n } = Astro.props
const { t, money, dateRange } = i18n
const area = trip.places[pass.area]
const members = trip.members.filter((m) => pass.members.includes(m.id))
const everyone = members.length === trip.members.length
const party = partyLabel(trip, pass.party, t('lens.everyone'), t('party.and'))
const emoji = partyEmoji(trip, pass.party)
const names = (ids: string[]) => ids.map((id) => memberName(trip, id)).join(', ')
// Held per party: each share says whose it is.
const split = pass.shares.length > 1
const costs = pass.shares.flatMap((share) => share.costs.map((c) => ({ c, share })))
const issues = [...new Map(issuesOf(trip, pass.id).map((d) => [d.code, d])).values()]
const issueLabel = (code: string) => (isLabelled(code) ? t(`issue.${code}`) : t('issue.other'))
const hasDetails = Boolean(issues.length || pass.notes || pass.url || costs.length)
---

<article
  id={`pass-${pass.id}`}
  data-presence
  data-people={people(pass.members)}
  data-party={pass.party}
  style={`--kind:${kindTint.pass}`}
  class:list={['pass', { shared: everyone }]}
>
  <div class="glyph" aria-hidden="true">
    <Icon name={kindIcon.pass} size={18} />
  </div>
  <details class="main" data-expandable={hasDetails ? '' : undefined}>
    <summary>
      <h3 class="headline" lang={trip.locale}>
        {pass.title}
      </h3>
      <p class="subhead secondary place">
        <Icon name="pin" size={14} />
        <span lang={trip.locale}>{area?.name ?? pass.area}</span>
      </p>
      <div class="meta">
        <span class="kind footnote">{t('kind.pass')}</span>
        {pass.provider && <span class="footnote secondary">{pass.provider}</span>}
        {pass.shares.map((share) => {
          // Each holder's share, like a plan's reservations: whose, when, what it costs.
          const whose =
            `${partyEmoji(trip, share.party) ?? ''} ${partyLabel(trip, share.party, t('lens.everyone'), t('party.and'))}`.trim()
          return (
            <span class="reservation">
              {split && (
                <span class="badge" data-tone={statusTone[share.status]} title={names(share.members)}>
                  <span class="ellipsis">{whose}</span>
                  {share.status !== 'notRequired' && <span>· {t(`status.${share.status}`)}</span>}
                </span>
              )}
              {!split && statusTone[share.status] && (
                <span class="badge" data-tone={statusTone[share.status]}>
                  {t(`status.${share.status}`)}
                </span>
              )}
              <span class="footnote secondary">{share.periods.map((p) => dateRange(p.from, p.to)).join(' · ')}</span>
              {share.status === 'required' && share.deadline && (
                <time class="footnote deadline" data-relative={share.deadline} data-template={t('bookings.due')} />
              )}
              {share.costs.map((c) => (
                <Money
                  display={trip.currency?.base ?? 'EUR'}
                  amount={c.amount}
                  currency={c.currency}
                  charged={c.charged}
                  lang={i18n.lang}
                  class="footnote secondary"
                />
              ))}
            </span>
          )
        })}
        <span class="who" title={members.map((m) => m.name).join(', ')}>
          <span class="party-pill">
            {!everyone && emoji && <span aria-hidden="true">{emoji}</span>}
            <span class="ellipsis">{party}</span>
          </span>
          {!everyone && <Avatars members={members} size={20} />}
        </span>
      </div>
      {issues.length > 0 && (
        <p class="issues footnote">
          <span aria-hidden="true">⚠︎</span>
          <span class="ellipsis">
            {issues.length === 1 ? issueLabel(issues[0].code) : i18n.plural('issues.count', issues.length)}
          </span>
        </p>
      )}
    </summary>
    {hasDetails && (
      <div class="details">
        {issues.length > 0 && (
          <p class="issue-link footnote">
            <a href={i18n.path(`/trips/${trip.slug}/#issues`)}>{t('issues.inList')} →</a>
          </p>
        )}
        {pass.notes && <div class="prose" lang={trip.locale} set:html={markdown(pass.notes)} />}
        {costs.length > 0 && (
          <ul class="facts footnote">
            {costs.map(({ c }) => (
              <li class="tabular">
                <Icon name="wallet" size={15} />
                {money(c.amount, c.currency)}
                {c.charged && (
                  <span class="secondary">
                    · {t('item.charged', { amount: money(c.charged.amount, c.charged.currency) })}
                  </span>
                )}
                <span class="secondary">
                  ·{' '}
                  {c.unpaid
                    ? t(c.estimate ? 'item.estimate' : 'item.unpaid')
                    : c.each
                      ? t('item.paidByEach')
                      : t('item.paidBy', { name: names(c.paidBy) })}
                </span>
                {c.who.join() !== pass.members.join() && (
                  <span class="secondary">· {t('item.for', { names: names(c.who) })}</span>
                )}
                {c.label && <span class="secondary">· {c.label}</span>}
                {!c.settled && <span class="owed">· {t('item.owed')}</span>}
              </li>
            ))}
          </ul>
        )}
        <div class="links">
          {pass.url && (
            <a class="button" href={pass.url} target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={15} />
              <span>{t('item.website')}</span>
            </a>
          )}
        </div>
      </div>
    )}
  </details>
  {/* Outside the summary: a link inside the toggle would be a control
     within a control. Positioned beside the title. */}
  <a
    class="anchor card-anchor"
    href={`#pass-${pass.id}`}
    data-anchor
    aria-label={t('item.copyLink')}
    title={t('item.copyLink')}
    data-failed={t('item.copyFailed')}
  >
    <Icon name="link" size={14} class="anchor-link" />
    <Icon name="check" size={14} class="anchor-check" />
  </a>
</article>

<style>
  .deadline {
    color: var(--orange);
    font-weight: 500;
  }

  .kind {
    font-weight: 600;
    color: var(--kind);
  }

  .reservation {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    min-width: 0;
  }

  .pass {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 0 var(--space-3);
    padding: 14px var(--space-4);
    align-items: start;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    color: var(--kind);
    background: color-mix(in srgb, var(--kind) 14%, transparent);
  }

  .main {
    min-width: 0;
  }

  summary {
    list-style: none;
    display: grid;
    gap: 3px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  [data-expandable] > summary {
    cursor: pointer;
  }

  /* The disclosure chevron sits in the corner, so it never wraps onto a
     line of its own after a long title. */
  /* The title makes room for the copy-link button and, when the card
     opens, the chevron; the rows below keep the full width. */
  summary h3 {
    padding-right: 28px;
  }

  [data-expandable] > summary {
    position: relative;
  }

  [data-expandable] > summary h3 {
    padding-right: 50px;
  }

  .card-anchor {
    position: absolute;
    top: 14px;
    right: var(--space-4);
    margin: 0;
  }

  [data-expandable] ~ .card-anchor {
    right: calc(var(--space-4) + 22px);
  }

  [data-expandable] > summary h3::after {
    content: '';
    position: absolute;
    top: 7px;
    right: 4px;
    width: 7px;
    height: 7px;
    border-right: 1.6px solid var(--label-tertiary);
    border-bottom: 1.6px solid var(--label-tertiary);
    transform: translateY(-3px) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  [data-expandable][open] > summary h3::after {
    transform: translateY(0) rotate(-135deg);
  }

  h3 {
    font-size: 16px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .place {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    font-size: 14px;
  }

  .place :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--label-tertiary);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 3px;
  }

  /* Passes for some of the trip carry their party by name, as plan cards do. */
  .party-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    max-width: 100%;
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--label-secondary);
    background: var(--fill);
  }

  .who {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    margin-left: auto;
    font-size: 14px;
  }

  .details {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .links:empty {
    display: none;
  }

  /* Pills stay one line: a long place name ends in an ellipsis. */
  .links .button {
    max-width: 100%;
    min-height: 32px;
    font-size: 14px;
    padding-inline: 12px;
  }

  .links .button :global(svg) {
    flex: none;
  }

  .links .button span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .pass {
      grid-template-columns: minmax(0, 1fr);
    }

    .glyph {
      display: none;
    }
  }

  .issues {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    margin: 2px 0 0;
    font-weight: 600;
    color: var(--orange);
  }

  .issue-link {
    margin: 0;
    font-weight: 600;
  }

  .facts {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
  }

  .facts :global(svg) {
    flex: none;
    color: var(--label-tertiary);
  }

  .owed {
    color: var(--orange);
  }
</style>
