---
import type { TripExport } from '@taac/core'

import Avatar from '@/components/Avatar.astro'
import type { I18n } from '@/i18n'
import { groupLabel } from '@/lib/trip'

interface Props {
  trip: TripExport
  i18n: I18n
  /** Plan pages offer the plans nobody was assigned to. */
  plans: boolean
}

const { trip, i18n, plans } = Astro.props
const { t } = i18n
const unassigned = plans ? trip.diagnostics.filter((d) => d.code === 'item.unassigned').length : 0
---

{trip.members.length > 1 && (
  <div
    class="lens"
    role="group"
    aria-label={t('lens.label')}
    data-lens={trip.slug}
    data-members={trip.members.map((m) => m.id).join(' ')}
    data-unassigned={unassigned ? '' : undefined}
  >
    <div class="people">
      <button type="button" class="chip everyone" data-lens-clear aria-pressed="true">
        {t('lens.everyone')}
      </button>
      {trip.members.map((m) => (
        <button type="button" class="chip" data-lens-person={m.id} aria-pressed="false">
          <Avatar member={m} hidden />
          <span>{m.name}</span>
        </button>
      ))}
      {trip.groups.map((g) => (
        <button
          type="button"
          class="chip group"
          data-lens-group={g.members.join(' ')}
          aria-pressed="false"
          title={g.description ?? groupLabel(trip, g, t('party.and'))}
        >
          {g.emoji && <span aria-hidden="true">{g.emoji}</span>}
          <span>{groupLabel(trip, g, t('party.and'))}</span>
        </button>
      ))}
      {unassigned > 0 && (
        <button type="button" class="chip unassigned" data-lens-unassigned aria-pressed="false">
          <span aria-hidden="true">⚠︎</span>
          <span>{t('lens.unassigned')}</span>
          <span class="count tabular">{unassigned}</span>
        </button>
      )}
    </div>
  </div>
)}

<script>
  import { getLens, onLens, setLens, type Lens } from '@/scripts/lens'

  let off: (() => void) | undefined

  function setup() {
    off?.()
    const root = document.querySelector<HTMLElement>('[data-lens]')
    if (!root) return
    const render = (lens: Lens) => {
      const set = new Set(lens.people)
      root.querySelector('[data-lens-clear]')?.setAttribute('aria-pressed', String(set.size === 0 && !lens.unassigned))
      root.querySelector('[data-lens-unassigned]')?.setAttribute('aria-pressed', String(Boolean(lens.unassigned)))
      for (const b of root.querySelectorAll<HTMLElement>('[data-lens-person]'))
        b.setAttribute('aria-pressed', String(set.has(b.dataset.lensPerson!)))
      for (const b of root.querySelectorAll<HTMLElement>('[data-lens-group]')) {
        const members = b.dataset.lensGroup!.split(' ')
        b.setAttribute('aria-pressed', String(members.length === set.size && members.every((m) => set.has(m))))
      }
      // Outside the scrolling row (LensMode), so it never hides off-screen.
      const mode = document.querySelector<HTMLElement>('[data-lens-mode]')
      if (!mode) return
      mode.hidden = set.size < 2
      for (const b of mode.querySelectorAll<HTMLElement>('button'))
        b.setAttribute('aria-pressed', String(b.dataset.value === lens.mode))
    }
    document.querySelector('[data-lens-mode]')?.addEventListener('click', (event) => {
      const value = (event.target as Element).closest<HTMLElement>('button')?.dataset.value
      if (value) setLens({ mode: value as Lens['mode'] })
    })
    root.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('button')
      if (!button) return
      const lens = getLens()
      if (button.hasAttribute('data-lens-clear')) setLens({ people: [], unassigned: false })
      else if (button.hasAttribute('data-lens-unassigned')) setLens({ people: [], unassigned: !lens.unassigned })
      else if (button.dataset.lensPerson) {
        const id = button.dataset.lensPerson
        setLens({
          people: lens.people.includes(id) ? lens.people.filter((p) => p !== id) : [...lens.people, id],
          unassigned: false,
        })
      } else if (button.dataset.lensGroup) {
        // A group is a shortcut: select exactly its members, together.
        setLens({ people: button.dataset.lensGroup.split(' '), mode: 'together', unassigned: false })
      }
    })
    off = onLens(render)
    render(getLens())
  }

  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .lens {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .people {
    display: flex;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .people::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 0 12px 0 4px;
    border: 0;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--label);
    background: var(--fill);
    cursor: pointer;
    transition:
      background var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .chip.everyone,
  .chip.unassigned {
    padding-left: 12px;
    color: var(--orange);
    background: color-mix(in srgb, var(--orange) 12%, transparent);
  }

  .chip.unassigned[aria-pressed='true'] {
    color: var(--label-on-tint);
    background: var(--orange);
  }

  .chip .count {
    font-weight: 600;
  }

  .chip.group {
    padding-left: 12px;
  }

  .chip :global(.avatar) {
    width: 22px;
    height: 22px;
    font-size: 10px;
    box-shadow: none;
  }

  .chip:hover {
    background: var(--fill-strong);
  }

  .chip[aria-pressed='true'] {
    color: var(--label-on-tint);
    background: var(--tint);
  }

  .chip.group {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--separator-strong);
  }

  .chip.group[aria-pressed='true'] {
    box-shadow: none;
    background: var(--tint);
  }

  /* Phones: one swipeable line with the currency switch (TripLayout scrolls it). */
  @media (max-width: 760px) {
    /* Inside the row that scrolls, take the full width of the chips rather
       than shrinking to the screen — or what follows lands on top of them. */
    .lens {
      flex: none;
      flex-wrap: nowrap;
    }

    .people {
      flex: none;
      overflow: visible;
    }
  }
</style>
