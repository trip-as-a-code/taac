---
import Icon from '@/components/Icon.astro'
import Notifications from '@/components/Notifications.astro'
import { locales, localeNames, localized, switchLocalePath, useI18n, type Locale } from '@/i18n'
import { site } from '@/lib/build'

interface Props {
  lang: Locale
  title?: string
  back?: { href: string; label: string }
}

const { lang, title, back } = Astro.props
const { t, path } = useI18n(lang)
const pathname = Astro.url.pathname
---

<header class="nav">
  <div class="nav-inner">
    <div class="nav-leading">
      {back ? (
        <a class="nav-back" href={back.href}>
          <Icon name="arrowLeft" size={16} />
          <span>{back.label}</span>
        </a>
      ) : (
        <a class="nav-brand" href={path('/')}>
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span>{localized(site.site.title, lang)}</span>
        </a>
      )}
    </div>
    <div class="nav-title" aria-hidden="true">
      {title}
    </div>
    <div class="nav-trailing">
      <Notifications lang={lang} />
      {/* On phones the rest folds into a menu; the bell stays out. */}
      <button
        class="nav-icon-button menu-toggle"
        type="button"
        data-nav-menu-toggle
        aria-expanded="false"
        aria-controls="nav-menu"
        title={t('nav.menu')}
      >
        <Icon name="menu" size={20} />
        <span class="visually-hidden">{t('nav.menu')}</span>
      </button>
      <div class="nav-menu" id="nav-menu" data-nav-menu>
        {/* Display settings for the page: a trip puts its currency here. */}
        <slot name="tools" />
        <nav class="lang" aria-label={t('nav.language')}>
          {locales.map((l) => (
            <a
              href={switchLocalePath(pathname, l)}
              hreflang={l}
              lang={l}
              data-set-lang={l}
              aria-current={l === lang ? 'true' : undefined}
              title={localeNames[l]}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </nav>
        <button class="nav-icon-button theme" type="button" data-theme-toggle title={t('nav.theme')}>
          <Icon name="moon" size={19} class="to-dark" />
          <Icon name="sun" size={19} class="to-light" />
          <span class="visually-hidden">{t('nav.theme')}</span>
        </button>
        {/* A real navigation: the view-transition router would replay the POST via fetch. */}
        <form class="logout" method="post" action="/api/logout" data-astro-reload>
          <button class="nav-icon-button" type="submit" title={t('nav.logout')}>
            <Icon name="logout" size={19} />
            <span class="visually-hidden">{t('nav.logout')}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<script>
  import { toggleTheme } from '@/scripts/theme'

  document.addEventListener('astro:page-load', () => {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme)
    // The phone menu: opens under the bar, closes on a tap elsewhere or Escape.
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]')
    const menu = document.querySelector<HTMLElement>('[data-nav-menu]')
    if (!toggle || !menu) return
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      menu.toggleAttribute('data-open', open)
    }
    toggle.addEventListener('click', (event) => {
      event.stopPropagation()
      set(!menu.hasAttribute('data-open'))
    })
    document.addEventListener('click', (event) => {
      if (menu.hasAttribute('data-open') && !menu.contains(event.target as Node)) set(false)
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') set(false)
    })
  })
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: calc(var(--nav-height) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    background: var(--material);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 0.5px solid transparent;
    transition: border-color var(--duration) var(--ease);
  }

  :global(html[data-scrolled]) .nav {
    border-bottom-color: var(--separator);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    height: var(--nav-height);
    max-width: calc(var(--content) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Flex, not a line box: an inline-flex link on a text line sits on its baseline, above centre. */
  .nav-leading {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .nav-brand,
  .nav-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    font-size: 17px;
    font-weight: 600;
    color: var(--label);
    text-decoration: none;
  }

  .nav-brand span,
  .nav-back span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The narrowest phones: the arrow alone, the label kept for screen readers. */
  @media (max-width: 359px) {
    .nav-back {
      padding: 0 8px;
    }

    .nav-back span {
      position: absolute;
      width: 1px;
      height: 1px;
      clip: rect(0 0 0 0);
    }
  }

  /* Logo and name centred on one line: no baseline gap under the image, no extra leading. */
  .nav-brand {
    line-height: 1;
  }

  .nav-brand img {
    display: block;
    flex: none;
    border-radius: 6px;
  }

  /* A quiet pill like the controls on the right, not a blue text link. */
  .nav-back {
    gap: 6px;
    height: 30px;
    padding: 0 12px 0 9px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    color: var(--label);
    background: var(--fill);
  }

  .nav-back :global(svg) {
    flex: none;
    color: var(--label-secondary);
  }

  .nav-brand:hover {
    text-decoration: none;
    opacity: 0.8;
  }

  .nav-back:hover {
    text-decoration: none;
    background: var(--fill-strong);
  }

  .nav-title {
    max-width: min(46vw, 420px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  :global(html[data-title-hidden]) .nav-title {
    opacity: 1;
    transform: none;
  }

  .nav-trailing {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .lang {
    display: inline-flex;
    padding: 2px;
    border-radius: 999px;
    background: var(--fill);
  }

  .lang a {
    min-width: 34px;
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--label-secondary);
    text-decoration: none;
  }

  .lang a[aria-current] {
    background: var(--bg-elevated);
    color: var(--label);
    box-shadow: var(--shadow-sm);
  }

  /* A view-only link shows one trip: there is no list of them to go back to. */
  :global(html[data-link]) .nav-back {
    visibility: hidden;
  }

  .logout {
    display: none;
    margin: 0;
  }

  :global(html[data-auth]) .logout {
    display: block;
  }

  /* Also the bell's and the Share button's, which live in their own components. */
  :global(.nav-icon-button) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--tint);
    cursor: pointer;
  }

  :global(.nav-icon-button:hover) {
    background: var(--tint-soft);
  }

  .menu-toggle {
    display: none;
  }

  .nav-menu {
    display: contents;
  }

  @media (max-width: 560px) {
    .nav-title {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .nav-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: var(--gutter);
      display: none;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-2);
      max-width: calc(100vw - 2 * var(--gutter));
      padding: 10px;
      border-radius: 16px;
      background: var(--bg-elevated);
      box-shadow: 0 12px 40px rgb(0 0 0 / 0.3);
    }

    .nav-menu[data-open] {
      display: flex;
    }

    .nav-inner {
      grid-template-columns: 1fr auto;
    }
  }

  .theme :global(.to-light),
  :global(:root[data-theme='dark']) .theme :global(.to-dark) {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme :global(.to-light) {
    display: block;
  }
</style>
