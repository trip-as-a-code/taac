---
import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import Select from '@/components/Select.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { ideaFacts, issuesOf, itemFacts } from '@/lib/facts'
import { tripPage, tripPaths } from '@/lib/paths'
import { photoSrc } from '@/lib/photos'
import { kindTint, placeEmoji } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, date, path, plural, number } = i18n
// Plural forms for the browser, which fills in the count as the map moves.
const rules = new Intl.PluralRules(lang)
const outsideForms = JSON.stringify(
  Object.fromEntries(
    [0, 1, 2, 5, 1.5].map((n) => [rules.select(n), plural('map.outside', n).replace(number(n), '{n}')]),
  ),
)

// Only what the map needs, inlined as JSON in the page (never in a JS bundle).
const used = new Map<string, { id: string; items: string[] }>()
for (const item of trip.items) {
  for (const id of item.places) {
    if (!used.has(id)) used.set(id, { id, items: [] })
    used.get(id)!.items.push(item.id)
  }
}
for (const idea of trip.ideas) {
  for (const id of idea.places) {
    if (!used.has(id)) used.set(id, { id, items: [] })
    used.get(id)!.items.push(idea.id)
  }
}
const itemInfo = Object.fromEntries([
  ...trip.items.map((item) => [
    item.id,
    {
      title: item.title,
      kind: item.kind,
      date: item.local.date,
      when: `${date(item.local.date, { day: 'numeric', month: 'short' })} · ${item.local.time ?? t(`part.${item.local.part ?? 'anytime'}`)}`,
      people: item.members,
      facts: itemFacts(trip, item),
      href: path(`/trips/${trip.slug}/itinerary/#item-${item.id}`),
      issues: new Set(issuesOf(trip, item.id).map((d) => d.code)).size,
      issuesHref: path(`/trips/${trip.slug}/#issue-${item.id}`),
    },
  ]),
  ...trip.ideas.map((idea) => [
    idea.id,
    {
      title: idea.title,
      kind: idea.kind,
      date: idea.local?.date ?? null,
      when: idea.local
        ? `${date(idea.local.date, { day: 'numeric', month: 'short' })} · ${t('ideas.proposed')}`
        : `${idea.priority === 'must' ? '★ ' : ''}${t('nav.ideas')}`,
      people: idea.members,
      facts: ideaFacts(trip, idea),
      href: path(`/trips/${trip.slug}/ideas/#idea-${idea.id}`),
    },
  ]),
])
const ideaIds = new Set(trip.ideas.map((i) => i.id))
const places = [...used.values()].map(({ id, items }) => {
  const place = trip.places[id]
  const idea = items.every((i) => ideaIds.has(i))
  return {
    id,
    name: place.name,
    geo: place.geo,
    emoji: placeEmoji(place.category),
    photo: place.photo ? photoSrc(place.photo, 'wide') : undefined,
    items,
    idea,
  }
})
const areas = trip.basesDerived
  ? []
  : trip.bases.map((b) => ({
      id: b.id,
      title: b.title,
      center: [trip.places[b.place].geo[1], trip.places[b.place].geo[0]],
      radius: trip.places[b.place].radius ?? 0,
      from: b.from,
      to: b.to,
      people: b.members,
    }))
const routes = trip.items
  .filter(
    (i) => ['flight', 'train', 'bus', 'ferry', 'transfer', 'walk', 'ride'].includes(i.kind) && i.places.length > 1,
  )
  .map((i) => ({
    item: i.id,
    flight: i.kind === 'flight',
    color: kindTint[i.kind],
    coords: i.places.map((id) => [trip.places[id].geo[1], trip.places[id].geo[0]]),
  }))
const overlays = trip.overlays.map((o) => ({ name: o.name, data: o.data }))
const data = { places, routes, items: itemInfo, overlays, areas }
const multiYear = new Set(trip.days.map((d) => d.date.slice(0, 4))).size > 1
---

<TripLayout trip={trip} lang={lang} section="map" bare>
  <div class="map-shell">
    <div class="map" data-map data-issues={t('issues.inList')} aria-label={t('nav.map')}></div>
    <aside class="panel" data-panel>
      <button class="grabber" type="button" data-sheet-toggle aria-expanded="false" aria-label={t('map.places')}>
        <span aria-hidden="true" />
      </button>
      <div class="panel-head">
        <Select
          data-day-filter
          label={t('filter.day')}
          i18n={i18n}
          options={[
            { value: '', label: t('filter.allDays') },
            ...trip.days.map((day, index) => ({
              value: day.date,
              // A trip that crosses a new year says which year each day is in.
              label: `${t('trip.dayN', { n: index + 1 })} · ${date(day.date, { weekday: 'short', day: 'numeric', month: 'short', ...(multiYear ? { year: 'numeric' } : {}) })}`,
            })),
          ]}
        />
        <FilterBar
          i18n={i18n}
          trip={trip}
          facts={[...trip.items.map((i) => itemFacts(trip, i)), ...trip.ideas.map((i) => ideaFacts(trip, i))]}
          facets={['focus', 'issue', 'when', 'kind', 'status', 'conflict', 'cost', 'priority', 'place', 'tag']}
          placeholder={t('filter.searchPlaces')}
        />
      </div>
      <div class="panel-title">
        <h2 class="headline">
          {t('map.places')} <span class="secondary tabular" data-place-count></span>
        </h2>
        <button class="button button-plain" type="button" data-fit>
          <Icon name="expand" size={15} />
          {t('map.fit')}
        </button>
      </div>
      <ul class="places list" data-place-list>
        {places.map((p) => (
          <li>
            <button type="button" class="row place" data-place={p.id}>
              {/* The place's photo over its emoji, once it loads. */}
              <span class:list={['emoji', { pictured: p.photo }]}>
                {p.emoji}
                {p.photo && (
                  <img
                    class="thumb"
                    src={p.photo.replace(/\/wide$/, '/thumb')}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="36"
                    height="36"
                    data-photo-img
                  />
                )}
              </span>
              <span class="subhead name" lang={trip.locale}>
                {p.name}
              </span>
              <span class="footnote place-issues" data-place-issues hidden />
              <span class="footnote tertiary tabular">{p.items.length}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="footnote secondary outside" data-outside hidden>
        <span data-outside-text data-template={outsideForms} />
        <button class="button button-plain" type="button" data-show-all>
          {t('map.showAll')}
        </button>
      </p>
      <p class="footnote secondary none" data-no-places hidden>
        {t('map.noPlaces')}
      </p>
    </aside>
  </div>
  <script type="application/json" id="map-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { setupMap } from '@/scripts/map'

  let resize: ResizeObserver | undefined

  /** The map fills what the tabs row leaves; that row wraps differently per width. */
  function fitShell() {
    resize?.disconnect()
    const shell = document.querySelector<HTMLElement>('.map-shell')
    const tabs = document.querySelector<HTMLElement>('.tabs')
    if (!shell || !tabs) return
    resize = new ResizeObserver(() => shell.style.setProperty('--tabs-height', `${tabs.offsetHeight}px`))
    resize.observe(tabs)
  }

  /** Phones: the panel is a bottom sheet; the grabber (or the title) expands it. */
  function setupSheet() {
    const panel = document.querySelector<HTMLElement>('[data-panel]')
    const toggle = panel?.querySelector<HTMLButtonElement>('[data-sheet-toggle]')
    if (!panel || !toggle) return
    const set = (open: boolean) => {
      panel.toggleAttribute('data-expanded', open)
      toggle.setAttribute('aria-expanded', String(open))
    }
    toggle.addEventListener('click', () => set(!panel.hasAttribute('data-expanded')))
    panel.querySelector('.panel-title h2')?.addEventListener('click', () => set(!panel.hasAttribute('data-expanded')))
    // Picking a place collapses the sheet so the map shows it.
    panel.querySelector('[data-place-list]')?.addEventListener('click', () => set(false))
    // A swipe on the grabber opens or closes it.
    let startY: number | undefined
    toggle.addEventListener('touchstart', (event) => (startY = event.touches[0].clientY), { passive: true })
    toggle.addEventListener(
      'touchend',
      (event) => {
        if (startY === undefined) return
        const delta = event.changedTouches[0].clientY - startY
        if (Math.abs(delta) > 24) set(delta < 0)
        startY = undefined
      },
      { passive: true },
    )
  }

  onPage('map', () => {
    fitShell()
    setupSheet()
    void setupMap()
  })
</script>

<style>
  .map-shell {
    position: relative;
    height: calc(100dvh - var(--nav-height) - env(safe-area-inset-top) - var(--tabs-height, 49px));
    min-height: 420px;
  }

  .map {
    position: absolute;
    inset: 0;
    background: var(--bg-inset);
  }

  .panel {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    bottom: var(--space-4);
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 360px;
    border-radius: var(--radius-lg);
    background: var(--material-thick);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    backdrop-filter: saturate(180%) blur(24px);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .panel-head {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-2);
  }

  .panel-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-bottom: 0.5px solid var(--separator);
  }

  .places {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .place {
    width: 100%;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    min-height: 44px;
    padding-block: 8px;
  }

  .place:hover,
  .place[aria-current='true'] {
    background: var(--fill);
  }

  .emoji {
    flex: none;
    width: 24px;
    font-size: 17px;
    text-align: center;
  }

  .emoji.pictured {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-block: -4px;
    border-radius: 9px;
    overflow: hidden;
    background: var(--fill);
  }

  .thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }

  .thumb[data-loaded] {
    opacity: 1;
  }

  .name {
    flex: 1;
    min-width: 0;
  }

  .none {
    padding: var(--space-4);
  }

  :global(.marker) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    font-size: 16px;
    background: var(--bg-elevated);
    box-shadow:
      0 2px 8px rgb(0 0 0 / 0.25),
      0 0 0 2px var(--bg-elevated);
    cursor: pointer;
    transition: transform 200ms var(--ease);
  }

  :global(.marker[data-idea]) {
    background: var(--material-thick);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
    outline: 2px dashed var(--purple);
    outline-offset: -1px;
  }

  :global(.marker:hover),
  :global(.marker[data-active]) {
    transform: scale(1.18);
  }

  :global(.maplibregl-popup-content) {
    padding: 14px 16px !important;
    border-radius: 16px !important;
    background: var(--material-thick) !important;
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    color: var(--label);
    box-shadow: var(--shadow-lg) !important;
    font-family: var(--font-sans);
  }

  :global(.maplibregl-popup-tip) {
    display: none;
  }

  /* Edge to edge across the popup's top, as a header. */
  :global(.popup-photo) {
    display: block;
    width: calc(100% + 32px);
    max-width: none;
    height: 120px;
    margin: -14px -16px 10px;
    border-radius: 16px 16px 0 0;
    object-fit: cover;
    background: var(--fill);
    cursor: zoom-in;
  }

  :global(.maplibregl-popup-close-button) {
    top: 6px !important;
    right: 8px !important;
    font-size: 18px;
    color: var(--label-tertiary);
  }

  /* Over a photo: a frosted round button on it, like Photos' and Maps' cards. */
  :global(.maplibregl-popup-content:has(.popup-photo) .maplibregl-popup-close-button) {
    z-index: 1;
    top: 8px !important;
    right: 8px !important;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    font-size: 17px;
    line-height: 1;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  :global(.maplibregl-popup-content:has(.popup-photo) .maplibregl-popup-close-button:hover) {
    background: rgb(0 0 0 / 0.6);
  }

  :global(.popup h3) {
    margin: 0 18px 6px 0;
    font-size: 15px;
    font-weight: 600;
  }

  :global(.popup-photo + h3) {
    margin-right: 0;
  }

  :global(.popup ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  :global(.popup a) {
    display: grid;
    font-size: 13px;
    color: var(--label);
  }

  :global(.popup a span:last-child) {
    color: var(--label-secondary);
  }

  :global(.maplibregl-ctrl-group) {
    border-radius: 12px !important;
    overflow: hidden;
    box-shadow: var(--shadow-md) !important;
  }

  .grabber {
    display: none;
  }

  /* Phones: the map fills the screen between the bars; places live in a
     bottom sheet that peeks and expands. */
  @media (max-width: 760px) {
    .map-shell {
      height: calc(
        100dvh - var(--nav-height) - env(safe-area-inset-top) - var(--tabs-height, 58px) - 60px -
          env(safe-area-inset-bottom)
      );
      min-height: 360px;
      overflow: hidden;
    }

    .panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: 38%;
      border-radius: 18px 18px 0 0;
      transition: height 320ms var(--ease);
    }

    .panel[data-expanded] {
      height: 88%;
    }

    .grabber {
      display: grid;
      place-items: center;
      flex: none;
      height: 32px;
      border: 0;
      background: transparent;
      cursor: grab;
      touch-action: none;
    }

    .grabber span {
      width: 36px;
      height: 5px;
      border-radius: 999px;
      background: var(--fill-strong);
    }

    .panel-head {
      padding-top: 0;
    }

    .panel-title h2 {
      cursor: pointer;
    }
  }

  .place-issues {
    flex: none;
    font-weight: 600;
    color: var(--orange);
  }

  .outside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
    margin: var(--space-2) var(--space-4) var(--space-3);
  }

  .outside[hidden] {
    display: none;
  }

  .outside .button {
    min-height: 30px;
    padding-inline: 6px;
    font-size: 13px;
  }

  :global(.popup li) {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  :global(.popup li > a:first-child) {
    flex: 1;
    min-width: 0;
  }

  :global(.popup .popup-issues) {
    flex: none;
    font-size: 12px;
    font-weight: 600;
    color: var(--orange);
    text-decoration: none;
  }
</style>
