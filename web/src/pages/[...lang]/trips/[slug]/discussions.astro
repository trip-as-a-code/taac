---
import Icon from '@/components/Icon.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { tripPage, tripPaths } from '@/lib/paths'
import { threadTargets } from '@/lib/threads'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t } = i18n
---

<TripLayout trip={trip} lang={lang} section="discussions">
  <div
    class="discussions"
    data-discussions
    data-targets={JSON.stringify(threadTargets(trip, i18n))}
    data-removed={t('comments.removed')}
    data-replies={t('comments.replies')}
    data-deleted={t('comments.deleted')}
  >
    <div class="head">
      <p class="secondary lead">{t('comments.lead')}</p>
      <button
        type="button"
        class="button button-primary"
        data-thread="trip"
        data-thread-title={t('comments.general')}
        hidden
      >
        <Icon name="chat" size={16} />
        {t('comments.new')}
        <span data-thread-count hidden></span>
      </button>
    </div>
    <section data-list="open" hidden>
      <h2 class="headline">{t('comments.openList')}</h2>
      <ul class="card list" data-items></ul>
    </section>
    <section data-list="resolved" hidden>
      <h2 class="headline">{t('comments.resolvedList')}</h2>
      <ul class="card list" data-items></ul>
    </section>
    <p class="card card-pad secondary" data-none>
      {t('comments.none')}
    </p>
  </div>
</TripLayout>

<script>
  import { nameOf, openThreads, type Thread } from '@/scripts/comments'

  document.addEventListener('taac:threads', (event) => {
    const root = document.querySelector<HTMLElement>('[data-discussions]')
    if (!root) return
    const { threads, unread } = (event as CustomEvent<{ threads: Thread[]; unread: string[] }>).detail
    const targets = JSON.parse(root.dataset.targets ?? '{}') as Record<string, { title: string; href: string }>
    const panel = document.querySelector<HTMLElement>('[data-thread-panel]')
    const people = JSON.parse(panel?.dataset.people ?? '{}') as Record<
      string,
      { name: string; initials: string; hue: number }
    >
    const lang = panel?.dataset.lang ?? 'en'
    const when = (ms: number) => new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short' }).format(ms)
    const last = (t: Thread) => t.comments.at(-1)
    // Latest activity first.
    const sorted = [...threads].sort((a, b) => (last(b)?.createdAt ?? 0) - (last(a)?.createdAt ?? 0))
    for (const kind of ['open', 'resolved'] as const) {
      const section = root.querySelector<HTMLElement>(`[data-list="${kind}"]`)!
      const these = sorted.filter((t) => (t.resolvedAt === null) === (kind === 'open'))
      section.hidden = these.length === 0
      section.querySelector('[data-items]')!.replaceChildren(
        ...these.map((thread) => {
          const target = targets[thread.anchor]
          const title = target?.title ?? root.dataset.removed!
          const item = document.createElement('li')
          item.className = 'row thread-row'
          const open = document.createElement('button')
          open.type = 'button'
          open.className = 'thread-open'
          open.toggleAttribute('data-unread', unread.includes(thread.id))
          const heading = document.createElement('span')
          heading.className = 'subhead'
          heading.textContent = title
          const comment = last(thread)
          const snippet = document.createElement('span')
          snippet.className = 'footnote secondary snippet'
          snippet.textContent = comment
            ? `${nameOf(comment.author, people)}: ${comment.deletedAt ? root.dataset.deleted : comment.body}`
            : ''
          const meta = document.createElement('span')
          meta.className = 'footnote tertiary'
          meta.textContent = `${root.dataset.replies!.replace('{n}', String(thread.comments.length))} · ${when(comment?.createdAt ?? thread.createdAt)}`
          open.append(heading, snippet, meta)
          open.addEventListener('click', () => openThreads(thread.anchor, title))
          item.append(open)
          if (target && thread.anchor !== 'trip') {
            const go = document.createElement('a')
            go.className = 'button button-plain go'
            go.href = target.href
            go.textContent = '→'
            go.title = title
            item.append(go)
          }
          return item
        }),
      )
    }
    root.querySelector<HTMLElement>('[data-none]')!.hidden = threads.length > 0
  })
</script>

<style>
  .discussions {
    display: grid;
    gap: var(--space-6);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .lead {
    flex: 1 1 320px;
    margin: 0;
  }

  .head .button[hidden],
  section[hidden],
  [data-none][hidden] {
    display: none;
  }

  section {
    display: grid;
    gap: var(--space-3);
  }

  h2 {
    margin: 0;
  }

  .discussions :global(.thread-row) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .discussions :global(.thread-open) {
    position: relative;
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--label);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .discussions :global(.thread-open .snippet) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .discussions :global(.thread-open[data-unread] .subhead::after) {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--tint);
    vertical-align: 2px;
  }
</style>
