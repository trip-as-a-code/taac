---
import Avatars from '@/components/Avatars.astro'
import DayBody from '@/components/DayBody.astro'
import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { itemFacts } from '@/lib/facts'
import { nextDay, spans } from '@/lib/presence'
import { tripPage, tripPaths } from '@/lib/paths'
import { homeOffset, kindIcon, people } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, date, plural } = i18n
// Ideas with a date show on that day as proposed, by time.
const proposals = Map.groupBy(
  trip.ideas.filter((i) => i.local).sort((a, b) => (a.local!.time ?? '').localeCompare(b.local!.time ?? '')),
  (i) => i.local!.date,
)
const offset = homeOffset(trip)

// Who is on the trip, day by day (lib/presence).
const presence = spans(trip)
const firstDay = trip.days[0]?.date
const lastDay = trip.days.at(-1)?.date
const onTrip = (day: string) =>
  trip.members.filter((m) => {
    const span = presence.get(m.id)
    return !span || (span.first <= day && day <= span.last)
  })
const joining = (day: string) => trip.members.filter((m) => day !== firstDay && presence.get(m.id)?.first === day)
const leaving = (day: string) => trip.members.filter((m) => day !== lastDay && presence.get(m.id)?.last === day)
const names = (members: { name: string }[]) => members.map((m) => m.name).join(', ')
// Plans still going at midnight (stays aside: their beds show every night).
const overnight = (day: string) =>
  trip.items.filter((i) => i.kind !== 'lodging' && i.local.date <= day && (i.local.endDate ?? i.local.date) > day)

// Runs of identical quiet days (nothing planned, nobody arriving or leaving,
// same bases, beds and blockers) fold into one block: a week of "free day in
// Tokyo" is one thing to read, not seven; so are workdays with the same hours.
type Day = (typeof trip.days)[number]
const quiet = (day: Day) =>
  !trip.basesDerived &&
  day.bases.length > 0 &&
  day.items.length === 0 &&
  !proposals.has(day.date) &&
  joining(day.date).length === 0 &&
  leaving(day.date).length === 0
const signature = (day: Day) =>
  JSON.stringify([
    day.bases.map((b) => [b.id, b.members]),
    day.stays.map((s) => [s.id, s.members]),
    day.blockers.map((b) => [b.id, b.members, b.wholeDay, b.start, b.end]),
  ])
const blocks: { days: Day[]; index: number }[] = []
trip.days.forEach((day, index) => {
  const last = blocks.at(-1)
  const prev = last?.days.at(-1)
  if (last && prev && quiet(day) && quiet(prev) && signature(day) === signature(prev)) last.days.push(day)
  else blocks.push({ days: [day], index })
})
// A bed is news the night you check in; after that the base chip says where you are.
// Short, without the year: a run never spans more than a few weeks.
const span = (from: string, to: string) =>
  `${date(from, { day: 'numeric', month: 'short' })} – ${date(to, { day: 'numeric', month: 'short' })}`
---

<TripLayout trip={trip} lang={lang} section="itinerary">
  <div class="toolbar">
    <FilterBar
      i18n={i18n}
      trip={trip}
      facts={trip.items.map((item) => itemFacts(trip, item))}
      facets={['focus', 'issue', 'when', 'conflict', 'status', 'due', 'kind', 'cost', 'payer', 'place', 'tag']}
      placeholder={t('filter.searchPlans')}
    />
  </div>

  <nav class="day-strip" aria-label={t('filter.day')}>
    {trip.days.map((day, index) => (
      <a href={`#${day.date}`} class="day-chip" data-day-link={day.date}>
        <span class="dow">{date(day.date, { weekday: 'short' })}</span>
        <span class="dom tabular">{date(day.date, { day: 'numeric' })}</span>
        <span class="visually-hidden">{t('trip.dayN', { n: index + 1 })}</span>
      </a>
    ))}
  </nav>

  <div class="days">
    {blocks.map(({ days, index }) => {
      const day = days[0]
      return days.length > 1 ? (
        <section class="day run" id={days[0].date} data-day-section>
          {days.slice(1).map((d) => (
            <span id={d.date} class="run-anchor" data-run-anchor />
          ))}
          <header class="day-header">
            <h2>
              <span class="weekday">
                {/* Free of plans either way; with blockers they aren't free time. */}
                {day.blockers.length ? plural('trip.days', days.length) : plural('trip.quietDays', days.length)}
              </span>
              <span class="date-line">
                <span class="tabular">{span(days[0].date, days.at(-1)!.date)}</span>
                <a
                  class="anchor"
                  href={`#${days[0].date}`}
                  data-anchor
                  aria-label={t('item.copyLink')}
                  title={t('item.copyLink')}
                >
                  <Icon name="link" size={15} class="anchor-link" />
                  <Icon name="check" size={15} class="anchor-check" />
                </a>
              </span>
            </h2>
            {onTrip(days[0].date).length < trip.members.length && (
              <span class="present" title={t('trip.present', { names: names(onTrip(days[0].date)) })}>
                <Avatars members={onTrip(days[0].date)} size={20} />
              </span>
            )}
            <span class="badge">{t('trip.daysN', { from: index + 1, to: index + days.length })}</span>
          </header>
          <DayBody trip={trip} i18n={i18n} day={day} span={days.length} homeOffset={offset} />
        </section>
      ) : (
        <Fragment>
          {/* Where the group changes: someone joins later, or heads home. */}
          {joining(day.date).length > 0 && (
            <p class="edge footnote" data-presence data-people={people(joining(day.date).map((m) => m.id))}>
              <Icon name="arrowRight" size={14} />
              {t('trip.joins', { names: names(joining(day.date)) })}
            </p>
          )}
          <section class="day" id={day.date} data-day-section>
            <header class="day-header">
              <h2>
                <span class="weekday">{date(day.date, { weekday: 'long' })}</span>
                {/* The link stays on the date's line. */}
                <span class="date-line">
                  <span class="tabular">{date(day.date, { day: 'numeric', month: 'long' })}</span>
                  <a
                    class="anchor"
                    href={`#${day.date}`}
                    data-anchor
                    aria-label={t('item.copyLink')}
                    title={t('item.copyLink')}
                  >
                    <Icon name="link" size={15} class="anchor-link" />
                    <Icon name="check" size={15} class="anchor-check" />
                  </a>
                </span>
              </h2>
              {/* Not everyone is here: show who is. */}
              {onTrip(day.date).length < trip.members.length && (
                <span class="present" title={t('trip.present', { names: names(onTrip(day.date)) })}>
                  <Avatars members={onTrip(day.date)} size={20} />
                </span>
              )}
              <span class="badge">{t('trip.dayN', { n: index + 1 })}</span>
            </header>
            <DayBody trip={trip} i18n={i18n} day={day} proposals={proposals.get(day.date)} homeOffset={offset} />
          </section>
          {/* Something running past midnight: a line down into the next day. */}
          {overnight(day.date).map((i) => (
            <a class="overnight footnote" href={`#item-${i.id}`} data-presence data-people={people(i.members)}>
              <Icon name={kindIcon[i.kind] ?? 'clock'} size={14} />
              <span class="ellipsis" lang={trip.locale}>
                {i.title}
              </span>
              <span class="secondary tabular">
                {t('trip.until', {
                  when: [date(i.local.endDate!, { day: 'numeric', month: 'short' }), i.local.endTime]
                    .filter(Boolean)
                    .join(' '),
                })}
              </span>
            </a>
          ))}
          {/* The last day: whoever is still here heads home. */}
          {day.date === lastDay && onTrip(day.date).length > 0 && (
            <p class="edge footnote" data-presence data-people={people(onTrip(day.date).map((m) => m.id))}>
              <Icon name="home" size={14} />
              {t('trip.ends', { names: names(onTrip(day.date)) })}
            </p>
          )}
          {leaving(day.date).length > 0 && onTrip(nextDay(day.date)).length > 0 && (
            <p class="edge footnote" data-presence data-people={people(leaving(day.date).map((m) => m.id))}>
              <Icon name="flight" size={14} />
              {t('trip.leaves', { names: names(leaving(day.date)), rest: names(onTrip(nextDay(day.date))) })}
            </p>
          )}
        </Fragment>
      )
    })}
  </div>
  <p class="empty secondary" data-filter-empty hidden>
    {t('filter.empty')}
  </p>
</TripLayout>

<script>
  import { revealTarget, setupFilters } from '@/scripts/filters'
  import { onPage, todayUTC } from '@/scripts/page'

  onPage('itinerary', () => {
    // Days the filters emptied drop out of the strip too; so do group
    // sections with nothing left in them.
    setupFilters(() => {
      for (const group of document.querySelectorAll<HTMLElement>('[data-group]'))
        group.hidden = !group.querySelector('[data-item]:not([hidden]), [data-presence]:not([hidden])')
      for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
        chip.hidden = Boolean(
          document.getElementById(chip.dataset.dayLink!)?.closest<HTMLElement>('[data-day-section]')?.hidden,
        )
    })
    revealTarget()
    // Dim past days and bring today into view while the trip is underway.
    const today = new Date(todayUTC()).toISOString().slice(0, 10)
    for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
      chip.classList.toggle('past', chip.dataset.dayLink! < today)
    document.querySelector(`[data-day-link="${today}"]`)?.scrollIntoView({ inline: 'center', block: 'nearest' })
  })
</script>

<style>
  .toolbar {
    margin-bottom: var(--space-4);
  }

  .day-strip {
    /* Contains the chips' visually-hidden labels: absolutely positioned
       without a positioned ancestor, they'd widen the whole page. */
    position: relative;
    display: flex;
    gap: 6px;
    margin: 0 calc(-1 * var(--gutter)) var(--space-6);
    padding: 2px var(--gutter) var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    /* Fades at the edge: more days to swipe to. */
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
  }

  .day-strip::-webkit-scrollbar {
    display: none;
  }

  .day-chip {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 1px;
    width: 46px;
    padding: 7px 0;
    border-radius: 14px;
    background: var(--bg-grouped);
    box-shadow: var(--shadow-sm);
    color: var(--label);
    scroll-snap-align: center;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .day-chip:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .day-chip.past {
    opacity: 0.5;
  }

  .dow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--label-secondary);
  }

  .dom {
    font-size: 19px;
    font-weight: 600;
  }

  .days {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .day {
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  /* Days folded into a run: their links land on the run. */
  .run-anchor {
    display: block;
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  .day-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .day-header h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 10px;
    min-width: 0;
    font-size: 22px;
  }

  /* The title wraps; the avatars and day badge keep their size. */
  .day-header > :not(h2) {
    flex: none;
  }

  .date-line {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .day-header .anchor {
    margin-left: 0;
  }

  .weekday {
    text-transform: capitalize;
  }

  .run .weekday {
    text-transform: none;
  }

  .day-header .tabular {
    color: var(--label-secondary);
    font-weight: 500;
  }

  .empty {
    padding: var(--space-12) 0;
    text-align: center;
  }

  /* A plan running past midnight: a dashed line down from one day into the next. */
  .overnight {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: calc(-1 * var(--space-4)) 0 0 var(--rail);
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-left: 2px dashed var(--separator-strong);
    color: var(--label-secondary);
    text-decoration: none;
  }

  /* Under the plan card's icon, on both sides of midnight (DayBody's arrival too). */
  .days {
    --rail: 91px;
  }

  @media (max-width: 560px) {
    .days {
      --rail: 74px;
    }
  }

  .overnight:hover {
    color: var(--label);
  }

  .overnight :global(svg) {
    flex: none;
  }

  /* Someone joins or heads home: a quiet line across the timeline. */
  .edge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--label-secondary);
  }

  .edge::before,
  .edge::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--separator-strong);
  }

  .edge :global(svg) {
    flex: none;
  }

  .present {
    display: inline-flex;
    margin-left: auto;
  }

  .present + .badge {
    margin-left: var(--space-2);
  }
</style>
