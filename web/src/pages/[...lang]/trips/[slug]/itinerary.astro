---
import Avatars from '@/components/Avatars.astro'
import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import IdeaRow from '@/components/IdeaRow.astro'
import OpenDay from '@/components/OpenDay.astro'
import Whereabouts from '@/components/Whereabouts.astro'
import ItemRow from '@/components/ItemRow.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { issuesOf, itemFacts } from '@/lib/facts'
import { tripPage, tripPaths } from '@/lib/paths'
import { baseById, homeOffset, itemById, partyEmoji, partyHue, partyLabel, people } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, date, plural } = i18n
const bases = baseById(trip)
// Each base a day is spent in, and whether its people have nothing planned.
// When the group is split, a free base gets a lane of its own.
const dayParts = (day: (typeof trip.days)[number]) =>
  day.bases.map((p) => {
    const free = !day.items.some((id) => items.get(id)!.members.some((m) => p.members.includes(m)))
    return { p, base: bases.get(p.id)!, free, laned: free && p.party !== 'everyone' && !trip.basesDerived }
  })
// Ideas with a date show on that day as proposed, by time.
const proposals = Map.groupBy(
  trip.ideas.filter((i) => i.local).sort((a, b) => (a.local!.time ?? '').localeCompare(b.local!.time ?? '')),
  (i) => i.local!.date,
)
const items = itemById(trip)
const offset = homeOffset(trip)

// Who is on the trip, day by day: from the bases and the plans that name
// them (a plan nobody was assigned to says nothing about it).
const nextDay = (day: string) => new Date(Date.parse(`${day}T00:00:00Z`) + 86_400_000).toISOString().slice(0, 10)
const spans = new Map<string, { first: string; last: string }>()
const extend = (member: string, from: string, to: string) => {
  const span = spans.get(member)
  spans.set(member, {
    first: span && span.first < from ? span.first : from,
    last: span && span.last > to ? span.last : to,
  })
}
for (const base of trip.bases) for (const m of base.members) extend(m, base.from, nextDay(base.to))
for (const item of trip.items)
  if (!issuesOf(trip, item.id).some((d) => d.code === 'item.unassigned'))
    for (const m of item.members) extend(m, item.local.date, item.local.endDate ?? item.local.date)
const firstDay = trip.days[0]?.date
const lastDay = trip.days.at(-1)?.date
const onTrip = (day: string) =>
  trip.members.filter((m) => {
    const span = spans.get(m.id)
    return !span || (span.first <= day && day <= span.last)
  })
const joining = (day: string) => trip.members.filter((m) => day !== firstDay && spans.get(m.id)?.first === day)
const leaving = (day: string) => trip.members.filter((m) => day !== lastDay && spans.get(m.id)?.last === day)
const names = (members: { name: string }[]) => members.map((m) => m.name).join(', ')

// Runs of identical quiet days (nothing planned, nobody arriving or leaving,
// same bases and beds) fold into one block: a week of "free day in Tokyo" is
// one thing to read, not seven.
type Day = (typeof trip.days)[number]
const quiet = (day: Day) =>
  !trip.basesDerived &&
  day.bases.length > 0 &&
  day.items.length === 0 &&
  day.blockers.length === 0 &&
  !proposals.has(day.date) &&
  joining(day.date).length === 0 &&
  leaving(day.date).length === 0
const signature = (day: Day) =>
  JSON.stringify([day.bases.map((b) => [b.id, b.members]), day.stays.map((s) => [s.id, s.members])])
const blocks: { days: Day[]; index: number }[] = []
trip.days.forEach((day, index) => {
  const last = blocks.at(-1)
  const prev = last?.days.at(-1)
  if (last && prev && quiet(day) && quiet(prev) && signature(day) === signature(prev)) last.days.push(day)
  else blocks.push({ days: [day], index })
})
// A bed is news the night you check in; after that the base chip says where you are.
// Short, without the year: a run never spans more than a few weeks.
const span = (from: string, to: string) =>
  `${date(from, { day: 'numeric', month: 'short' })} – ${date(to, { day: 'numeric', month: 'short' })}`
---

<TripLayout trip={trip} lang={lang} section="itinerary">
  <div class="toolbar">
    <FilterBar
      i18n={i18n}
      trip={trip}
      facts={trip.items.map((item) => itemFacts(trip, item))}
      facets={['focus', 'issue', 'when', 'conflict', 'status', 'due', 'kind', 'cost', 'payer', 'place', 'tag']}
      placeholder={t('filter.searchPlans')}
    />
  </div>

  <nav class="day-strip" aria-label={t('filter.day')}>
    {trip.days.map((day, index) => (
      <a href={`#${day.date}`} class="day-chip" data-day-link={day.date}>
        <span class="dow">{date(day.date, { weekday: 'short' })}</span>
        <span class="dom tabular">{date(day.date, { day: 'numeric' })}</span>
        <span class="visually-hidden">{t('trip.dayN', { n: index + 1 })}</span>
      </a>
    ))}
  </nav>

  <div class="days">
    {blocks.map(({ days, index }) => {
      const day = days[0]
      return days.length > 1 ? (
        <section class="day run" id={days[0].date} data-day-section>
          {days.slice(1).map((d) => (
            <span id={d.date} class="run-anchor" data-run-anchor />
          ))}
          <header class="day-header">
            <h2>
              <span class="weekday">{plural('trip.quietDays', days.length)}</span>
              <span class="date-line">
                <span class="tabular">{span(days[0].date, days.at(-1)!.date)}</span>
                <a
                  class="anchor"
                  href={`#${days[0].date}`}
                  data-anchor
                  aria-label={t('item.copyLink')}
                  title={t('item.copyLink')}
                >
                  <Icon name="link" size={15} class="anchor-link" />
                  <Icon name="check" size={15} class="anchor-check" />
                </a>
              </span>
            </h2>
            {onTrip(days[0].date).length < trip.members.length && (
              <span class="present" title={t('trip.present', { names: names(onTrip(days[0].date)) })}>
                <Avatars members={onTrip(days[0].date)} size={20} />
              </span>
            )}
            <span class="badge">{t('trip.daysN', { from: index + 1, to: index + days.length })}</span>
          </header>
          <Whereabouts trip={trip} i18n={i18n} date={day.date} span={days.length} bases={day.bases} stays={day.stays} />
          {dayParts(day).some((part) => part.laned) && (
            <div class="card list" data-lanes>
              {dayParts(day)
                .filter((part) => part.laned)
                .map((part) => (
                  <div class="row-wrap free-lane" data-party={part.p.party} data-free>
                    <OpenDay trip={trip} i18n={i18n} part={part.p} base={part.base} free split />
                  </div>
                ))}
            </div>
          )}
          {dayParts(day)
            .filter((part) => !part.laned)
            .map((part) => (
              <OpenDay trip={trip} i18n={i18n} part={part.p} base={part.base} free split={day.bases.length > 1} />
            ))}
        </section>
      ) : (
        <Fragment>
          {/* Where the group changes: someone joins later, or heads home. */}
          {joining(day.date).length > 0 && (
            <p class="edge footnote" data-presence data-people={people(joining(day.date).map((m) => m.id))}>
              <Icon name="arrowRight" size={14} />
              {t('trip.joins', { names: names(joining(day.date)) })}
            </p>
          )}
          <section class="day" id={day.date} data-day-section>
            <header class="day-header">
              <h2>
                <span class="weekday">{date(day.date, { weekday: 'long' })}</span>
                {/* The link stays on the date's line. */}
                <span class="date-line">
                  <span class="tabular">{date(day.date, { day: 'numeric', month: 'long' })}</span>
                  <a
                    class="anchor"
                    href={`#${day.date}`}
                    data-anchor
                    aria-label={t('item.copyLink')}
                    title={t('item.copyLink')}
                  >
                    <Icon name="link" size={15} class="anchor-link" />
                    <Icon name="check" size={15} class="anchor-check" />
                  </a>
                </span>
              </h2>
              {/* Not everyone is here: show who is. */}
              {onTrip(day.date).length < trip.members.length && (
                <span class="present" title={t('trip.present', { names: names(onTrip(day.date)) })}>
                  <Avatars members={onTrip(day.date)} size={20} />
                </span>
              )}
              <span class="badge">{t('trip.dayN', { n: index + 1 })}</span>
            </header>
            {day.blockers.length > 0 && (
              <ul class="presence">
                {day.blockers.map((b) => {
                  const blocker = trip.blockers.find((x) => x.id === b.id)!
                  const who = b.members.map((m) => trip.members.find((x) => x.id === m)?.name ?? m).join(', ')
                  const source = blocker.time?.timezone
                    ? t('blocker.source', {
                        start: blocker.time.start,
                        end: blocker.time.end,
                        zone: blocker.time.timezone.split('/').pop()!.replace(/_/g, ' '),
                      })
                    : undefined
                  return (
                    <li class="blocker footnote" data-presence data-people={people(b.members)} title={source}>
                      <span aria-hidden="true">⛔</span>
                      <span class="blocker-title chip-text">{blocker.title}</span>
                      <span class="tabular">
                        {b.wholeDay ? t('blocker.allDay') : t('blocker.window', { start: b.start, end: b.end })}
                      </span>
                      <span class="secondary chip-text">· {who}</span>
                    </li>
                  )
                })}
              </ul>
            )}
            <Whereabouts trip={trip} i18n={i18n} date={day.date} bases={day.bases} stays={day.stays} />
            {(day.items.length > 0 || dayParts(day).some((part) => part.laned)) && (
              <div class="card list" data-lanes>
                {day.items.map((id) => (
                  <div class="row-wrap" data-party={items.get(id)!.party}>
                    <ItemRow trip={trip} item={items.get(id)!} i18n={i18n} homeOffset={offset} />
                  </div>
                ))}
                {/* A group with nothing planned keeps its own lane for its free day. */}
                {dayParts(day)
                  .filter((part) => part.laned)
                  .map((part) => (
                    <div class="row-wrap free-lane" data-party={part.p.party} data-free>
                      <OpenDay trip={trip} i18n={i18n} part={part.p} base={part.base} free split />
                    </div>
                  ))}
              </div>
            )}
            {proposals.has(day.date) && (
              <div class="proposals" aria-label={t('ideas.proposed')}>
                {proposals.get(day.date)!.map((idea) => (
                  <IdeaRow trip={trip} idea={idea} i18n={i18n} proposed />
                ))}
              </div>
            )}
            {day.bases.length > 0 && !trip.basesDerived
              ? dayParts(day)
                  .filter((part) => !part.laned)
                  .map((part) => (
                    <OpenDay
                      trip={trip}
                      i18n={i18n}
                      part={part.p}
                      base={part.base}
                      free={part.free}
                      split={day.bases.length > 1}
                    />
                  ))
              : day.items.length === 0 && <p class="free footnote secondary">{t('trip.freeDay')}</p>}
          </section>
          {leaving(day.date).length > 0 && onTrip(nextDay(day.date)).length > 0 && (
            <p class="edge footnote" data-presence data-people={people(leaving(day.date).map((m) => m.id))}>
              <Icon name="flight" size={14} />
              {t('trip.leaves', { names: names(leaving(day.date)), rest: names(onTrip(nextDay(day.date))) })}
            </p>
          )}
        </Fragment>
      )
    })}
  </div>
  <script
    type="application/json"
    id="parties"
    set:html={JSON.stringify(
      Object.fromEntries(
        trip.parties.map((p) => [
          p.id,
          {
            label:
              `${partyEmoji(trip, p.id) ?? ''} ${partyLabel(trip, p.id, t('lens.everyone'), t('party.and'))}`.trim(),
            hue: partyHue(p.id),
          },
        ]),
      ),
    ).replace(/</g, '\\u003c')}
  />
  <p class="empty secondary" data-filter-empty hidden>
    {t('filter.empty')}
  </p>
</TripLayout>

<script>
  import { revealTarget, setupFilters } from '@/scripts/filters'
  import { setupLanes, type PartyInfo } from '@/scripts/lanes'
  import { onPage, todayUTC } from '@/scripts/page'

  let stopLanes: (() => void) | undefined

  onPage('itinerary', () => {
    stopLanes?.()
    const parties = JSON.parse(document.getElementById('parties')?.textContent ?? '{}') as Record<string, PartyInfo>
    stopLanes = setupLanes(parties)
    // Days the filters emptied drop out of the strip too.
    setupFilters(() => {
      for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
        chip.hidden = Boolean(
          document.getElementById(chip.dataset.dayLink!)?.closest<HTMLElement>('[data-day-section]')?.hidden,
        )
    })
    revealTarget()
    // Dim past days and bring today into view while the trip is underway.
    const today = new Date(todayUTC()).toISOString().slice(0, 10)
    for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
      chip.classList.toggle('past', chip.dataset.dayLink! < today)
    document.querySelector(`[data-day-link="${today}"]`)?.scrollIntoView({ inline: 'center', block: 'nearest' })
  })
</script>

<style>
  .toolbar {
    margin-bottom: var(--space-4);
  }

  .day-strip {
    /* Contains the chips' visually-hidden labels: absolutely positioned
       without a positioned ancestor, they'd widen the whole page. */
    position: relative;
    display: flex;
    gap: 6px;
    margin: 0 calc(-1 * var(--gutter)) var(--space-6);
    padding: 2px var(--gutter) var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .day-strip::-webkit-scrollbar {
    display: none;
  }

  .day-chip {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 1px;
    width: 46px;
    padding: 7px 0;
    border-radius: 14px;
    background: var(--bg-grouped);
    box-shadow: var(--shadow-sm);
    color: var(--label);
    scroll-snap-align: center;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .day-chip:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .day-chip.past {
    opacity: 0.5;
  }

  .dow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--label-secondary);
  }

  .dom {
    font-size: 19px;
    font-weight: 600;
  }

  .days {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .day {
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  /* Days folded into a run: their links land on the run. */
  .run-anchor {
    display: block;
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  .day-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .day-header h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 10px;
    font-size: 22px;
  }

  .date-line {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .day-header .anchor {
    margin-left: 0;
  }

  .weekday {
    text-transform: capitalize;
  }

  .run .weekday {
    text-transform: none;
  }

  .day-header .tabular {
    color: var(--label-secondary);
    font-weight: 500;
  }

  .presence {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  /* Chips stay one line; the longest text gives way with an ellipsis. */
  .presence > li {
    max-width: 100%;
    min-width: 0;
    white-space: nowrap;
  }

  .presence > li > :global(*) {
    flex: none;
  }

  .presence .chip-text {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .blocker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    border-radius: 999px;
    color: var(--label);
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--red) 9%, transparent) 0 6px,
      color-mix(in srgb, var(--red) 4%, transparent) 6px 12px
    );
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--red) 22%, transparent);
  }

  .blocker-title {
    font-weight: 600;
  }

  .card.list > .row-wrap + .row-wrap {
    position: relative;
    border-top: 0;
  }

  .row-wrap + .row-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 128px;
    right: 0;
    border-top: 0.5px solid var(--separator);
  }

  .row-wrap:has([data-item][hidden]) {
    display: none;
  }

  /* Lanes (laid out by scripts/lanes.ts on wide screens). */
  .card.list.laned {
    display: grid;
  }

  .laned > .row-wrap::before {
    display: none;
  }

  .laned > .row-wrap {
    border-top: 0.5px solid var(--separator);
  }

  .laned > .row-wrap:not([style*='-1']) + .row-wrap:not([style*='-1']) {
    box-shadow: inset 0.5px 0 0 var(--separator);
  }

  .laned > :global(.lane-head) {
    padding: 10px var(--space-4) 8px 15px;
    font-weight: 600;
    color: hsl(var(--party-hue) 55% 38%);
    background: hsl(var(--party-hue) 70% 50% / 0.08);
    box-shadow: inset 3px 0 0 hsl(var(--party-hue) 65% 55%);
  }

  :global(:root[data-theme='dark']) .laned > :global(.lane-head) {
    color: hsl(var(--party-hue) 80% 72%);
  }

  /* In lanes the column header names the party already. */
  .laned :global(.party-pill) {
    display: none;
  }

  .free {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--separator-strong);
    text-align: center;
  }

  .empty {
    padding: var(--space-12) 0;
    text-align: center;
  }

  @media (max-width: 560px) {
    .row-wrap + .row-wrap::before {
      left: 0;
    }
  }

  /* Proposed, not planned: separate dashed cards rather than one list. */
  .proposals {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* Someone joins or heads home: a quiet line across the timeline. */
  .edge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--label-secondary);
  }

  .edge::before,
  .edge::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--separator-strong);
  }

  .edge :global(svg) {
    flex: none;
  }

  .present {
    display: inline-flex;
    margin-left: auto;
  }

  .present + .badge {
    margin-left: var(--space-2);
  }
</style>
