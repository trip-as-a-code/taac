---
import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import ItemRow from '@/components/ItemRow.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { itemFacts } from '@/lib/facts'
import { tripPage, tripPaths } from '@/lib/paths'
import {
  baseById,
  daysBetween,
  homeOffset,
  ideasByArea,
  itemById,
  partyEmoji,
  partyHue,
  partyLabel,
  people,
} from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, date, path } = i18n
const bases = baseById(trip)
const areaIdeas = ideasByArea(trip)
const items = itemById(trip)
const offset = homeOffset(trip)
---

<TripLayout trip={trip} lang={lang} section="itinerary">
  <div class="toolbar">
    <FilterBar
      i18n={i18n}
      trip={trip}
      facts={trip.items.map((item) => itemFacts(trip, item))}
      facets={['focus', 'issue', 'when', 'conflict', 'status', 'due', 'kind', 'cost', 'payer', 'place', 'tag']}
      placeholder={t('filter.searchPlans')}
    />
  </div>

  <nav class="day-strip" aria-label={t('filter.day')}>
    {trip.days.map((day, index) => (
      <a href={`#${day.date}`} class="day-chip" data-day-link={day.date}>
        <span class="dow">{date(day.date, { weekday: 'short' })}</span>
        <span class="dom tabular">{date(day.date, { day: 'numeric' })}</span>
        <span class="visually-hidden">{t('trip.dayN', { n: index + 1 })}</span>
      </a>
    ))}
  </nav>

  <div class="days">
    {trip.days.map((day, index) => (
      <section class="day" id={day.date} data-day-section>
        <header class="day-header">
          <h2>
            <span class="weekday">{date(day.date, { weekday: 'long' })}</span>
            <span class="tabular">{date(day.date, { day: 'numeric', month: 'long' })}</span>
          </h2>
          <span class="badge">{t('trip.dayN', { n: index + 1 })}</span>
        </header>
        {day.blockers.length > 0 && (
          <ul class="presence">
            {day.blockers.map((b) => {
              const blocker = trip.blockers.find((x) => x.id === b.id)!
              const who = b.members.map((m) => trip.members.find((x) => x.id === m)?.name ?? m).join(', ')
              const source = blocker.time?.timezone
                ? t('blocker.source', {
                    start: blocker.time.start,
                    end: blocker.time.end,
                    zone: blocker.time.timezone.split('/').pop()!.replace(/_/g, ' '),
                  })
                : undefined
              return (
                <li class="blocker footnote" data-presence data-people={people(b.members)} title={source}>
                  <span aria-hidden="true">⛔</span>
                  <span class="blocker-title chip-text">{blocker.title}</span>
                  <span class="tabular">
                    {b.wholeDay ? t('blocker.allDay') : t('blocker.window', { start: b.start, end: b.end })}
                  </span>
                  <span class="secondary chip-text">· {who}</span>
                </li>
              )
            })}
          </ul>
        )}
        {(day.bases.length > 0 || day.stays.length > 0) && (
          <ul class="presence">
            {day.bases
              .filter(() => !trip.basesDerived)
              .map((p) => {
                const base = bases.get(p.id)!
                const emoji = partyEmoji(trip, p.party)
                const n = daysBetween(base.from, day.date) + 1
                return (
                  <li class="base subhead" data-presence data-people={people(p.members)}>
                    <Icon name="pin" size={15} />
                    <span class="base-title chip-text" lang={trip.locale} title={base.title}>
                      {base.title}
                    </span>
                    {base.nights > 1 && (
                      <span class="footnote secondary">{t('trip.baseDay', { n, total: base.nights })}</span>
                    )}
                    {p.party !== 'everyone' && (
                      <span
                        class="party-tag footnote"
                        title={partyLabel(trip, p.party, t('lens.everyone'), t('party.and'))}
                      >
                        {emoji ?? partyLabel(trip, p.party, t('lens.everyone'), t('party.and'))}
                      </span>
                    )}
                  </li>
                )
              })}
            {day.stays.map((p) => {
              const stay = items.get(p.id)!
              const night = t('trip.nightAt', { place: trip.places[stay.places[0]]?.name ?? stay.title })
              return (
                <li class="stay footnote" data-presence data-people={people(p.members)} title={night}>
                  <Icon name="lodging" size={14} />
                  <span class="chip-text" lang={trip.locale}>
                    {night}
                  </span>
                </li>
              )
            })}
          </ul>
        )}
        {day.items.length > 0 && (
          <div class="card list" data-lanes>
            {day.items.map((id) => (
              <div class="row-wrap" data-party={items.get(id)!.party}>
                <ItemRow trip={trip} item={items.get(id)!} i18n={i18n} homeOffset={offset} />
              </div>
            ))}
          </div>
        )}
        {day.bases.length > 0 && !trip.basesDerived
          ? day.bases.map((p) => {
              const base = bases.get(p.id)!
              const ideas = areaIdeas.get(base.place) ?? []
              return (
                <div
                  class="open footnote"
                  data-presence
                  data-people={people(p.members)}
                  data-open-day={day.items.length === 0 ? '' : undefined}
                >
                  {day.items.length === 0 && <span class="secondary">{t('trip.openDay')}</span>}
                  {ideas.length > 0 && (
                    <a href={path(`/trips/${trip.slug}/ideas/#area-${base.place}`)}>
                      <Icon name="sparkle" size={14} />
                      {t('trip.ideasHere', { n: ideas.length, place: trip.places[base.place]?.name ?? base.title })}
                    </a>
                  )}
                </div>
              )
            })
          : day.items.length === 0 && <p class="free footnote secondary">{t('trip.freeDay')}</p>}
      </section>
    ))}
  </div>
  <script
    type="application/json"
    id="parties"
    set:html={JSON.stringify(
      Object.fromEntries(
        trip.parties.map((p) => [
          p.id,
          {
            label:
              `${partyEmoji(trip, p.id) ?? ''} ${partyLabel(trip, p.id, t('lens.everyone'), t('party.and'))}`.trim(),
            hue: partyHue(p.id),
          },
        ]),
      ),
    ).replace(/</g, '\\u003c')}
  />
  <p class="empty secondary" data-filter-empty hidden>
    {t('filter.empty')}
  </p>
</TripLayout>

<script>
  import { setupFilters } from '@/scripts/filters'
  import { setupLanes, type PartyInfo } from '@/scripts/lanes'
  import { todayUTC } from '@/scripts/page'

  let stopLanes: (() => void) | undefined

  document.addEventListener('astro:page-load', () => {
    stopLanes?.()
    const parties = JSON.parse(document.getElementById('parties')?.textContent ?? '{}') as Record<string, PartyInfo>
    stopLanes = setupLanes(parties)
    // Days the filters emptied drop out of the strip too.
    setupFilters(() => {
      for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
        chip.hidden = Boolean(document.getElementById(chip.dataset.dayLink!)?.hidden)
    })
    // Dim past days and bring today into view while the trip is underway.
    const today = new Date(todayUTC()).toISOString().slice(0, 10)
    for (const chip of document.querySelectorAll<HTMLElement>('[data-day-link]'))
      chip.classList.toggle('past', chip.dataset.dayLink! < today)
    document.querySelector(`[data-day-link="${today}"]`)?.scrollIntoView({ inline: 'center', block: 'nearest' })
  })
</script>

<style>
  .toolbar {
    margin-bottom: var(--space-4);
  }

  .day-strip {
    /* Contains the chips' visually-hidden labels: absolutely positioned
       without a positioned ancestor, they'd widen the whole page. */
    position: relative;
    display: flex;
    gap: 6px;
    margin: 0 calc(-1 * var(--gutter)) var(--space-6);
    padding: 2px var(--gutter) var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .day-strip::-webkit-scrollbar {
    display: none;
  }

  .day-chip {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 1px;
    width: 46px;
    padding: 7px 0;
    border-radius: 14px;
    background: var(--bg-grouped);
    box-shadow: var(--shadow-sm);
    color: var(--label);
    scroll-snap-align: center;
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }

  .day-chip:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .day-chip.past {
    opacity: 0.5;
  }

  .dow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--label-secondary);
  }

  .dom {
    font-size: 19px;
    font-weight: 600;
  }

  .days {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .day {
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  .day-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .day-header h2 {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    font-size: 22px;
  }

  .weekday {
    text-transform: capitalize;
  }

  .day-header .tabular {
    color: var(--label-secondary);
    font-weight: 500;
  }

  .presence {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  /* Chips stay one line; the longest text gives way with an ellipsis. */
  .presence > li {
    max-width: 100%;
    min-width: 0;
    white-space: nowrap;
  }

  .presence > li > :global(*) {
    flex: none;
  }

  .presence .chip-text {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .base {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    border-radius: 999px;
    font-weight: 600;
    color: var(--tint);
    background: var(--tint-soft);
  }

  .base .footnote {
    font-weight: 500;
  }

  .open {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px dashed var(--separator-strong);
  }

  .open:not([data-open-day]) {
    border: 0;
    padding: 0 var(--space-4);
  }

  .open a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 500;
  }

  .blocker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    border-radius: 999px;
    color: var(--label);
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--red) 9%, transparent) 0 6px,
      color-mix(in srgb, var(--red) 4%, transparent) 6px 12px
    );
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--red) 22%, transparent);
  }

  .blocker-title {
    font-weight: 600;
  }

  .stay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--purple);
    background: color-mix(in srgb, var(--purple) 10%, transparent);
  }

  .card.list > .row-wrap + .row-wrap {
    position: relative;
    border-top: 0;
  }

  .row-wrap + .row-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    left: 128px;
    right: 0;
    border-top: 0.5px solid var(--separator);
  }

  .row-wrap:has([data-item][hidden]) {
    display: none;
  }

  /* Lanes (laid out by scripts/lanes.ts on wide screens). */
  .card.list.laned {
    display: grid;
  }

  .laned > .row-wrap::before {
    display: none;
  }

  .laned > .row-wrap {
    border-top: 0.5px solid var(--separator);
  }

  .laned > .row-wrap:not([style*='-1']) + .row-wrap:not([style*='-1']) {
    box-shadow: inset 0.5px 0 0 var(--separator);
  }

  .laned > :global(.lane-head) {
    padding: 10px var(--space-4) 8px 15px;
    font-weight: 600;
    color: hsl(var(--party-hue) 55% 38%);
    background: hsl(var(--party-hue) 70% 50% / 0.08);
    box-shadow: inset 3px 0 0 hsl(var(--party-hue) 65% 55%);
  }

  @media (prefers-color-scheme: dark) {
    .laned > :global(.lane-head) {
      color: hsl(var(--party-hue) 80% 72%);
    }
  }

  /* In lanes the column header names the party already. */
  .laned :global(.party-pill) {
    display: none;
  }

  .party-tag {
    font-weight: 600;
  }

  .free {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--separator-strong);
    text-align: center;
  }

  .empty {
    padding: var(--space-12) 0;
    text-align: center;
  }

  @media (max-width: 560px) {
    .row-wrap + .row-wrap::before {
      left: 0;
    }
  }
</style>
