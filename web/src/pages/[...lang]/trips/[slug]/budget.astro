---
import Avatar from '@/components/Avatar.astro'
import Avatars from '@/components/Avatars.astro'
import Icon from '@/components/Icon.astro'
import Money from '@/components/Money.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { tripPage, tripPaths } from '@/lib/paths'
import {
  itemById,
  kindIcon,
  kindTint,
  memberName,
  people,
  spendingIcon,
  spendingTint,
  type CostKind,
  type SpendingCategory,
} from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
// Where a line's thing lives: a packing item, a pass, or a plan.
const lineHref = (l: { kind: string; item: string }) =>
  l.kind === 'packing'
    ? `/trips/${trip.slug}/packing/#packing-${l.item}`
    : l.kind === 'pass'
      ? `/trips/${trip.slug}/bookings/#pass-${l.item}`
      : l.kind === 'spending'
        ? `/trips/${trip.slug}/budget/#${l.item}`
        : `/trips/${trip.slug}/itinerary/#item-${l.item}`
// A spending budget: what it's for, else what it is.
const lineTitle = (l: { item: string; title?: string; kind: string }) =>
  items.get(l.item)?.title ?? l.title ?? (l.kind === 'spending' ? t('kind.spending') : l.item)
const { t, date, path } = i18n
const { budget } = trip
const items = itemById(trip)
const kinds = [...new Set(budget.lines.map((l) => l.kind))] as CostKind[]
const currencies = [...new Set(budget.lines.map((l) => l.settledCurrency))]
// What's set aside is not an expense: it has its own section, by budget.
const lines = budget.lines
  .map((line, index) => ({ line, index }))
  .filter(({ line }) => line.kind !== 'spending')
  .sort((a, b) => (items.get(a.line.item)?.start ?? '').localeCompare(items.get(b.line.item)?.start ?? ''))
const reserves = [
  ...Map.groupBy(
    budget.lines.map((line, index) => ({ line, index })).filter(({ line }) => line.kind === 'spending'),
    ({ line }) => line.item,
  ),
].map(([id, parts]) => {
  const members = Object.keys(parts[0]!.line.shares)
  const group = trip.groups.find(
    (g) => g.members.length === members.length && g.members.every((m) => members.includes(m)),
  )
  return {
    id,
    parts,
    members: members.flatMap((m) => trip.members.find((x) => x.id === m) ?? []),
    name: group?.name
      ? [group.emoji, group.name].filter(Boolean).join(' ')
      : members.map((m) => memberName(trip, m)).join(', '),
    label: parts[0]!.line.label,
  }
})
const category = (l: { category?: string }) => (l.category ?? 'other') as SpendingCategory
const partTitle = (l: { title?: string; category?: string }) => l.title ?? t(`spending.${category(l)}`)
// Packing purchases have no date and sort first: they happen before the trip.
// Everything with an amount is filled in by scripts/budget.ts in the
// viewer's currency; the page ships the lines, not the totals.
const dash = '—'
---

<TripLayout trip={trip} lang={lang} section="budget">
  {budget.lines.length === 0 ? (
    <p class="card card-pad secondary">{t('budget.none')}</p>
  ) : (
    <>
      <section class="totals-wrap">
        <div class="totals" style={`--n:${2 + Number(reserves.length > 0) + Number(budget.ideas.length > 0)}`}>
          <div class="total card card-pad">
            <span class="footnote secondary label">{t('budget.planned')}</span>
            <span data-fit class="amount tabular" data-total="planned">
              {dash}
            </span>
            <span class="footnote tertiary">{t('budget.plannedHint')}</span>
          </div>
          <div class="total card card-pad">
            <span class="footnote secondary label">{t('budget.committed')}</span>
            <span data-fit class="amount tabular committed" data-total="committed">
              {dash}
            </span>
            <span class="footnote tertiary">{t('budget.committedHint')}</span>
          </div>
          {reserves.length > 0 && (
            <div class="total card card-pad">
              <span class="footnote secondary label">{t('budget.reserved')}</span>
              <span data-fit class="amount tabular reserved" data-total="reserved">
                {dash}
              </span>
              <span class="footnote tertiary">{t('budget.reservedHint')}</span>
            </div>
          )}
          {budget.ideas.length > 0 && (
            <div class="total card card-pad">
              <span class="footnote secondary label">{t('budget.possible')}</span>
              <span data-fit class="amount tabular possible" data-total="possible">
                {dash}
              </span>
              <span class="footnote tertiary">{t('budget.possibleHint')}</span>
            </div>
          )}
        </div>
      </section>
      {/* What moved in each currency: a footnote to the totals, not one of them. */}
      <p class="footnote secondary moved" data-moved-line hidden={currencies.length < 2 || undefined}>
        <span>{t('budget.byCurrency')}:</span>
        {currencies.map((code) => (
          <span class="tabular" data-moved={code} title={t('budget.inCurrency', { currency: code })}>
            {dash}
          </span>
        ))}
      </p>
      <p
        class="footnote tertiary rates"
        data-rates-note
        data-template={t('budget.ratesNote')}
        data-missing={t('budget.noRates')}
      />

      <section class="section">
        <div class="section-header">
          <h2>{t('budget.perPerson')}</h2>
        </div>
        <div class="people">
          {trip.members.map((member) => (
            <article class="person card card-pad" data-person={member.id}>
              <header>
                <Avatar member={member} />
                <span class="headline">{member.name}</span>
              </header>
              <dl class="tabular">
                <div>
                  <dt class="footnote secondary">{t('budget.paid')}</dt>
                  <dd data-fit data-person-paid>
                    {dash}
                  </dd>
                </div>
                <div>
                  <dt class="footnote secondary">{t('budget.share')}</dt>
                  <dd data-fit data-person-share>
                    {dash}
                  </dd>
                </div>
              </dl>
              <p
                class="balance subhead"
                data-person-balance
                data-even={t('budget.even')}
                data-owed={t('budget.owed', { amount: '{amount}' })}
                data-owes={t('budget.owes', { amount: '{amount}' })}
              >
                {dash}
              </p>
            </article>
          ))}
        </div>
      </section>

      <div class="columns">
        <section class="section">
          <div class="section-header">
            <h2>{t('budget.settleUp')}</h2>
          </div>
          <ul class="card list" data-settlements data-none={t('budget.settled')} />
          <template data-settlement-template>
            <li>
              <details class="debt">
                <summary class="row settlement">
                  <span class="headline" data-from />
                  <Icon name="arrowRight" size={16} class="arrow" />
                  <span class="headline" data-to />
                  <span class="tabular settle-amount" data-amount />
                </summary>
                <ul class="because footnote" aria-label={t('budget.because')} data-because />
              </details>
            </li>
          </template>
          <p class="footnote tertiary debt-hint">{t('budget.debtHint')}</p>
        </section>

        <section class="section">
          <div class="section-header">
            <h2>{t('budget.byKind')}</h2>
          </div>
          <div class="card card-pad kinds">
            <div class="stack" aria-hidden="true">
              {kinds.map((kind) => (
                <span data-kind-bar={kind} style={`--kind:${kindTint[kind]}`} title={t(`kind.${kind}`)} />
              ))}
            </div>
            <ul class="legend list">
              {kinds.map((kind) => (
                <li style={`--kind:${kindTint[kind]}`} data-kind={kind}>
                  <span class="swatch">
                    <Icon name={kindIcon[kind]} size={14} />
                  </span>
                  <span class="subhead kind-name">{t(`kind.${kind}`)}</span>
                  <span class="subhead tabular share">
                    <span data-kind-amount>{dash}</span>
                    <span class="tertiary" data-kind-pct />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>

      {reserves.length > 0 && (
        <section class="section" id="reserved">
          <div class="section-header">
            <h2>{t('budget.reserved')}</h2>
          </div>
          <p class="footnote secondary reserve-note">{t('budget.reservedNote')}</p>
          <div class="reserves">
            {reserves.map((reserve) => (
              <article
                class="reserve card card-pad"
                id={reserve.id}
                data-reserve
                data-people={JSON.stringify(reserve.members.map((m) => m.id))}
                data-each={reserve.members.length > 1 ? t('budget.reservedEach') : undefined}
              >
                <header>
                  <Avatars members={reserve.members} size={28} />
                  <span class="reserve-who">
                    <span class="headline">{reserve.name}</span>
                    {reserve.label && (
                      <span class="footnote secondary" lang={trip.locale}>
                        {reserve.label}
                      </span>
                    )}
                  </span>
                  <span class="reserve-total">
                    <span class="title-3 tabular" data-reserve-total>
                      {dash}
                    </span>
                    <span class="footnote tertiary tabular" data-reserve-each />
                  </span>
                </header>
                {/* Like a storage bar: what each part takes of the whole. */}
                <div class="reserve-bar" aria-hidden="true">
                  {reserve.parts.map(({ line }) => (
                    <span
                      style={`--part:${spendingTint[category(line)]};flex:${line.amount}`}
                      title={partTitle(line)}
                    />
                  ))}
                </div>
                <ul class="list reserve-parts">
                  {reserve.parts.map(({ line, index }) => (
                    <li
                      style={`--part:${spendingTint[category(line)]}`}
                      data-reserve-line={index}
                      data-unallocated={line.category === 'unallocated' ? '' : undefined}
                    >
                      <span class="part-icon">
                        <Icon name={spendingIcon[category(line)]} size={15} />
                      </span>
                      <span class="subhead part-name" lang={line.title ? trip.locale : undefined}>
                        {partTitle(line)}
                      </span>
                      <span class="subhead tabular part-amount">
                        <span data-part-amount>{dash}</span>
                        <span class="tertiary" data-part-pct />
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-header">
          <h2>{t('budget.expenses')}</h2>
        </div>
        <div class="card list expenses">
          {lines.map(({ line, index }) => {
            const item = items.get(line.item)
            const kind = (item?.kind ?? line.kind) as CostKind
            const packing = line.kind === 'packing'
            const spending = line.kind === 'spending'
            return (
              <a
                class="row expense"
                id={spending ? line.item : undefined}
                href={path(lineHref(line))}
                data-item
                data-line={index}
                data-people={people(Object.keys(line.shares))}
                data-status={line.committed ? 'booked' : 'required'}
                style={kindTint[kind] ? `--kind:${kindTint[kind]}` : undefined}
              >
                <span class="glyph">{kindIcon[kind] && <Icon name={kindIcon[kind]} size={16} />}</span>
                <span class="expense-main">
                  <span class="subhead expense-title" lang={trip.locale}>
                    {lineTitle(line)}
                    {line.label && <span class="secondary"> · {line.label}</span>}
                  </span>
                  <span class="footnote secondary">
                    {item
                      ? `${date(item.local.date, { day: 'numeric', month: 'short' })} · `
                      : packing || line.kind === 'pass'
                        ? `${t(packing ? 'kind.packing' : 'kind.pass')} · `
                        : ''}
                    {spending ? (
                      // Paid as it goes, by whoever buys: who it's for, not who paid.
                      [
                        line.title && t('kind.spending'),
                        Object.keys(line.shares)
                          .map((m) => memberName(trip, m))
                          .join(', '),
                      ]
                        .filter(Boolean)
                        .join(' · ')
                    ) : line.due ? (
                      <>
                        <span data-show-until={line.due}>
                          {t('item.due', { date: date(line.due, { day: 'numeric', month: 'short' }) })}
                        </span>
                        <span class="awaiting" data-show-from={line.due} hidden>
                          {t('item.dueConfirm', { date: date(line.due, { day: 'numeric', month: 'short' }) })}
                        </span>
                      </>
                    ) : line.unpaid ? (
                      t(line.estimate ? 'item.estimate' : 'item.unpaid')
                    ) : Object.keys(line.paid).length > 0 ? (
                      t('item.paidBy', {
                        name: Object.keys(line.paid)
                          .map((m) => memberName(trip, m))
                          .join(', '),
                      })
                    ) : (
                      t('item.paidByEach')
                    )}
                  </span>
                </span>
                <span class="expense-amount tabular">
                  <Money
                    display={trip.currency?.base ?? 'EUR'}
                    amount={line.amount}
                    currency={line.currency}
                    charged={line.charged}
                    lang={lang}
                    class="subhead"
                  />
                  <span class="footnote tertiary" data-line-mine />
                </span>
                <span
                  class="dot"
                  data-committed={line.committed ? '' : undefined}
                  title={line.committed ? t('budget.committed') : t('budget.planned')}
                />
              </a>
            )
          })}
        </div>
        <p class="empty secondary" data-filter-empty hidden>
          {t('filter.empty')}
        </p>
      </section>
    </>
  )}
  <script
    type="application/json"
    id="budget-data"
    set:html={JSON.stringify({
      base: budget.base,
      lines: budget.lines,
      ideas: budget.ideas,
      choices: budget.choices,
      members: trip.members.map((m) => m.id),
      links: budget.lines.map((l) => path(lineHref(l))),
      titles: budget.lines.map((l) => {
        const title = lineTitle(l)
        return l.label ? `${title} · ${l.label}` : title
      }),
      names: Object.fromEntries(trip.members.map((m) => [m.id, m.name])),
    }).replace(/</g, '\\u003c')}
  />
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { computeBudget, type BudgetData } from '@/scripts/budget'
  import { setupFilters } from '@/scripts/filters'
  import { getLens } from '@/scripts/lens'
  import { displayCurrency, format, onMoney, ratesDate } from '@/scripts/money'

  type Data = BudgetData & { members: string[]; names: Record<string, string>; titles: string[]; links: string[] }

  function render() {
    const raw = document.getElementById('budget-data')?.textContent
    if (!raw) return
    const data = JSON.parse(raw) as Data
    const lens = getLens()
    const result = computeBudget(data, lens, data.members)
    const show = (amount: number) => format(amount)
    const set = (selector: string, text: string) => {
      const el = document.querySelector(selector)
      if (el) el.textContent = text
    }
    const approx = result.estimated ? '≈ ' : ''
    set('[data-total="planned"]', approx + show(result.planned))
    set('[data-total="committed"]', (result.committedEstimated ? '≈ ' : '') + show(result.committed))
    set('[data-total="possible"]', '≈ ' + show(result.possible))
    set('[data-total="reserved"]', (result.reservedEstimated ? '≈ ' : '') + show(result.reserved))

    // Each budget set aside: hidden when the people in view have no part in it.
    const whole = new Intl.NumberFormat(document.documentElement.lang, { style: 'percent' })
    for (const card of document.querySelectorAll<HTMLElement>('[data-reserve]')) {
      const members = JSON.parse(card.dataset.people ?? '[]') as string[]
      card.hidden = lens.people.length > 0 && !members.some((m) => lens.people.includes(m))
      const rows = [...card.querySelectorAll<HTMLElement>('[data-reserve-line]')]
      const amounts = rows.map((row) => result.lines[Number(row.dataset.reserveLine)]?.total ?? 0)
      const total = amounts.reduce((sum, a) => sum + a, 0)
      card.querySelector('[data-reserve-total]')!.textContent = format(total, displayCurrency(), {
        maximumFractionDigits: 0,
      })
      card.querySelector('[data-reserve-each]')!.textContent = card.dataset.each
        ? card.dataset.each.replace(
            '{amount}',
            format(total / members.length, displayCurrency(), { maximumFractionDigits: 0 }),
          )
        : ''
      rows.forEach((row, i) => {
        row.querySelector('[data-part-amount]')!.textContent = format(amounts[i]!, displayCurrency(), {
          maximumFractionDigits: 0,
        })
        row.querySelector('[data-part-pct]')!.textContent = total ? ` · ${whole.format(amounts[i]! / total)}` : ''
      })
    }

    const moved = [...document.querySelectorAll<HTMLElement>('[data-moved]')]
    for (const el of moved) {
      const amount = result.byCurrency.get(el.dataset.moved!) ?? 0
      el.hidden = amount < 0.005
      el.textContent = format(amount, el.dataset.moved!)
    }
    // Only worth a line when money moves in more than one currency.
    const line = document.querySelector<HTMLElement>('[data-moved-line]')
    if (line) line.hidden = moved.filter((el) => !el.hidden).length < 2
    const note = document.querySelector<HTMLElement>('[data-rates-note]')
    if (note) {
      const date = ratesDate()
      note.textContent =
        result.missing || !date
          ? note.dataset.missing!
          : note.dataset.template!.replace(
              '{date}',
              new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: 'long', timeZone: 'UTC' }).format(
                new Date(`${date}T00:00:00Z`),
              ),
            )
    }

    for (const card of document.querySelectorAll<HTMLElement>('[data-person]')) {
      const id = card.dataset.person!
      const m = result.members.get(id)!
      card.hidden = (lens.people.length > 0 && !lens.people.includes(id)) || (m.paid < 0.005 && m.share < 0.005)
      card.querySelector('[data-person-paid]')!.textContent = approx + show(m.paid)
      card.querySelector('[data-person-share]')!.textContent = approx + show(m.share)
      // Only debts move the balance: unpaid and settled costs owe nothing.
      const balance = result.settlements.reduce(
        (sum, s) => sum + (s.to === id ? s.amount : s.from === id ? -s.amount : 0),
        0,
      )
      const tone = Math.abs(balance) < 0.005 ? 'even' : balance > 0 ? 'owed' : 'owes'
      card.dataset.tone = tone
      const el = card.querySelector<HTMLElement>('[data-person-balance]')!
      el.textContent =
        tone === 'even' ? el.dataset.even! : el.dataset[tone]!.replace('{amount}', approx + show(Math.abs(balance)))
    }

    const list = document.querySelector<HTMLElement>('[data-settlements]')
    const template = document.querySelector<HTMLTemplateElement>('[data-settlement-template]')
    if (list && template) {
      list.replaceChildren()
      const transfers = result.settlements.filter(
        (s) => !lens.people.length || lens.people.includes(s.from) || lens.people.includes(s.to),
      )
      if (!transfers.length) {
        const row = document.createElement('li')
        row.className = 'row secondary'
        row.textContent = list.dataset.none!
        list.append(row)
      }
      for (const s of transfers) {
        const row = template.content.cloneNode(true) as DocumentFragment
        row.querySelector('[data-from]')!.textContent = data.names[s.from] ?? s.from
        row.querySelector('[data-to]')!.textContent = data.names[s.to] ?? s.to
        row.querySelector('[data-amount]')!.textContent = approx + show(s.amount)
        // The expenses behind it: what each adds, and what offsets it.
        const because = row.querySelector('[data-because]')!
        for (const l of s.lines) {
          const li = document.createElement('li')
          const link = document.createElement('a')
          link.href = data.links[l.index] ?? '#'
          const title = document.createElement('span')
          title.textContent = title.title = data.titles[l.index] ?? ''
          const amount = document.createElement('span')
          amount.className = 'tabular'
          amount.textContent = `${l.amount < 0 ? '− ' : ''}${approx}${show(Math.abs(l.amount))}`
          li.toggleAttribute('data-offset', l.amount < 0)
          link.append(title, amount)
          li.append(link)
          because.append(li)
        }
        list.append(row)
      }
    }

    const percent = new Intl.NumberFormat(document.documentElement.lang, { style: 'percent' })
    for (const bar of document.querySelectorAll<HTMLElement>('[data-kind-bar]')) {
      const amount = result.byKind.get(bar.dataset.kindBar!) ?? 0
      bar.style.flex = String(amount)
      bar.hidden = amount <= 0
    }
    for (const row of document.querySelectorAll<HTMLElement>('[data-kind]')) {
      const amount = result.byKind.get(row.dataset.kind!) ?? 0
      row.hidden = amount <= 0
      row.querySelector('[data-kind-amount]')!.textContent = format(amount, displayCurrency(), {
        maximumFractionDigits: 0,
      })
      row.querySelector('[data-kind-pct]')!.textContent =
        ` · ${percent.format(result.planned ? amount / result.planned : 0)}`
    }

    // With people selected, each expense also shows their part of it.
    for (const row of document.querySelectorAll<HTMLElement>('[data-line]')) {
      const line = result.lines[Number(row.dataset.line)]
      const el = row.querySelector<HTMLElement>('[data-line-mine]')!
      el.textContent =
        line && lens.people.length && line.mine && Math.abs(line.mine - line.total) > 0.005 ? show(line.mine) : ''
    }
  }

  let off: (() => void) | undefined

  onPage('budget', () => {
    off?.()
    off = onMoney(render)
    setupFilters(render)
  })
</script>

<style>
  /* The totals in one row when they fit, else in pairs: never one left alone
     on a row (an odd last one takes the whole row). */
  .totals-wrap {
    container-type: inline-size;
  }

  .totals {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: var(--space-4);
  }

  @container (max-width: 760px) {
    .totals {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .totals > .total:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .moved {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    margin: var(--space-3) 0 0;
    padding-inline: 4px;
  }

  .moved [data-moved] {
    font-weight: 600;
    color: var(--label);
  }

  .total {
    display: grid;
    align-content: start;
    gap: 4px;
  }

  .label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  .amount {
    white-space: nowrap;
    font-family: var(--font-rounded);
    font-size: clamp(28px, 3.6vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .committed {
    color: var(--green);
  }

  .reserved {
    color: var(--indigo);
  }

  .reserve-note {
    margin: calc(-1 * var(--space-2)) 0 var(--space-3);
  }

  .reserves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--space-4);
  }

  .reserve {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .reserve header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reserve-who {
    display: grid;
    min-width: 0;
  }

  .reserve-who > * {
    overflow: hidden;
