---
import type { ItemKind } from '@taac/core'

import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { tripPage, tripPaths } from '@/lib/paths'
import { initials, itemById, kindIcon, kindTint, memberHue, memberName } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, money, date, path, number } = i18n
const { budget } = trip
const base = budget.base
const items = itemById(trip)
const kinds = Object.entries(budget.byKind).sort((a, b) => b[1].planned - a[1].planned) as [
  ItemKind,
  typeof budget.total,
][]
const rates = Object.entries(trip.currency?.rates ?? {})
const lineTokens = (shares: Record<string, number>) => {
  const members = Object.keys(shares)
  const groups = trip.groups.filter((g) => g.members.some((m) => members.includes(m))).map((g) => `g:${g.id}`)
  return [...members.map((m) => `m:${m}`), ...groups].join(' ')
}
const lines = [...budget.lines].sort((a, b) =>
  (items.get(a.item)?.start ?? '').localeCompare(items.get(b.item)?.start ?? ''),
)
---

<TripLayout trip={trip} lang={lang} section="budget">
  {budget.lines.length === 0 ? (
    <p class="card card-pad secondary">{t('budget.none')}</p>
  ) : (
    <>
      <section class="totals">
        <div class="total card card-pad">
          <span class="footnote secondary label">{t('budget.planned')}</span>
          <span class="amount tabular">{money(budget.total.planned, base)}</span>
          <span class="footnote tertiary">{t('budget.plannedHint')}</span>
        </div>
        <div class="total card card-pad">
          <span class="footnote secondary label">{t('budget.committed')}</span>
          <span class="amount tabular committed">{money(budget.total.committed, base)}</span>
          <span class="footnote tertiary">{t('budget.committedHint')}</span>
        </div>
        {budget.possible > 0 && (
          <div class="total card card-pad">
            <span class="footnote secondary label">{t('budget.possible')}</span>
            <span class="amount tabular possible">{money(budget.possible, base)}</span>
            <span class="footnote tertiary">{t('budget.possibleHint')}</span>
          </div>
        )}
        <div class="total card card-pad currencies">
          <span class="footnote secondary label">{t('budget.byCurrency')}</span>
          <ul class="list">
            {Object.entries(budget.byCurrency).map(([code, amounts]) => (
              <li class="currency tabular">
                <span>{money(amounts.planned, code)}</span>
              </li>
            ))}
          </ul>
          {rates.map(([quote, value]) => (
            <p class="footnote tertiary rate" data-fx={quote} data-base={base} data-template={t('budget.liveRate')}>
              {t('budget.rate', { base, value: number(1 / value, { maximumFractionDigits: 2 }), quote })}
            </p>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>{t('budget.perPerson')}</h2>
        </div>
        <div class="people">
          {budget.members.map((m) => {
            const member = trip.members.find((x) => x.id === m.member)
            const tone = Math.abs(m.balance) < 0.01 ? 'even' : m.balance > 0 ? 'owed' : 'owes'
            return (
              <article class="person card card-pad" data-tone={tone}>
                <header>
                  {member && (
                    <span class="avatar" style={`--hue:${memberHue(member.id)}`}>
                      {initials(member)}
                    </span>
                  )}
                  <span class="headline">{memberName(trip, m.member)}</span>
                </header>
                <dl class="tabular">
                  <div>
                    <dt class="footnote secondary">{t('budget.paid')}</dt>
                    <dd>{money(m.paid.planned, base)}</dd>
                  </div>
                  <div>
                    <dt class="footnote secondary">{t('budget.share')}</dt>
                    <dd>{money(m.share.planned, base)}</dd>
                  </div>
                </dl>
                <p class="balance subhead">
                  {tone === 'even'
                    ? t('budget.even')
                    : tone === 'owed'
                      ? t('budget.owed', { amount: money(m.balance, base) })
                      : t('budget.owes', { amount: money(-m.balance, base) })}
                </p>
              </article>
            )
          })}
        </div>
      </section>

      <div class="columns">
        <section class="section">
          <div class="section-header">
            <h2>{t('budget.settleUp')}</h2>
          </div>
          {budget.settlements.length === 0 ? (
            <p class="card card-pad secondary">{t('budget.settled')}</p>
          ) : (
            <ul class="card list">
              {budget.settlements.map((s) => (
                <li class="row settlement">
                  <span class="headline">{memberName(trip, s.from)}</span>
                  <Icon name="arrowRight" size={16} class="arrow" />
                  <span class="headline">{memberName(trip, s.to)}</span>
                  <span class="tabular settle-amount">{money(s.amount, base)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="section">
          <div class="section-header">
            <h2>{t('budget.byKind')}</h2>
          </div>
          <div class="card card-pad kinds">
            <div class="stack" aria-hidden="true">
              {kinds.map(([kind, amounts]) => (
                <span
                  style={`--kind:${kindTint[kind]};flex:${amounts.planned}`}
                  title={`${t(`kind.${kind}`)} · ${money(amounts.planned, base)}`}
                />
              ))}
            </div>
            <ul class="legend list">
              {kinds.map(([kind, amounts]) => (
                <li style={`--kind:${kindTint[kind]}`}>
                  <span class="swatch">
                    <Icon name={kindIcon[kind]} size={14} />
                  </span>
                  <span class="subhead">{t(`kind.${kind}`)}</span>
                  <span class="subhead tabular share">
                    {money(amounts.planned, base, { maximumFractionDigits: 0 })}
                    <span class="tertiary">
                      {' '}
                      · {number(amounts.planned / budget.total.planned, { style: 'percent' })}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>

      <section class="section">
        <div class="section-header">
          <h2>{t('budget.expenses')}</h2>
          <FilterBar trip={trip} i18n={i18n} status={false} />
        </div>
        <div class="card list expenses">
          {lines.map((line) => {
            const item = items.get(line.item)
            return (
              <a
                class="row expense"
                href={path(`/trips/${trip.slug}/itinerary/#item-${line.item}`)}
                data-item
                data-filter={lineTokens(line.shares)}
                data-status={line.committed ? 'booked' : 'required'}
                style={item ? `--kind:${kindTint[item.kind]}` : undefined}
              >
                <span class="glyph">{item && <Icon name={kindIcon[item.kind]} size={16} />}</span>
                <span class="expense-main">
                  <span class="subhead expense-title" lang={trip.locale}>
                    {item?.title ?? line.item}
                    {line.label && <span class="secondary"> · {line.label}</span>}
                  </span>
                  <span class="footnote secondary">
                    {item && date(item.local.date, { day: 'numeric', month: 'short' })} ·{' '}
                    {t('item.paidBy', { name: memberName(trip, line.paidBy) })}
                  </span>
                </span>
                <span class="expense-amount tabular">
                  <span class="subhead">{money(line.baseAmount, base)}</span>
                  {line.estimate && <span class="footnote tertiary">{t('budget.estimate')}</span>}
                  {line.currency !== base && <span class="footnote tertiary">{money(line.amount, line.currency)}</span>}
                </span>
                <span
                  class="dot"
                  data-committed={line.committed ? '' : undefined}
                  title={line.committed ? t('budget.committed') : t('budget.planned')}
                />
              </a>
            )
          })}
        </div>
        <p class="empty secondary" data-filter-empty hidden>
          {t('filter.empty')}
        </p>
      </section>
    </>
  )}
</TripLayout>

<script>
  import { setupFilters } from '@/scripts/filters'

  /** Live ECB rate next to the trip's own, through the worker's cached proxy. */
  async function liveRates() {
    const els = [...document.querySelectorAll<HTMLElement>('[data-fx]')]
    if (!els.length) return
    const base = els[0].dataset.base!
    const quotes = els.map((el) => el.dataset.fx).join(',')
    try {
      const response = await fetch(`/api/fx?base=${base}&quotes=${quotes}`)
      if (!response.ok) return
      const { rates } = (await response.json()) as { rates: Record<string, number> }
      const format = new Intl.NumberFormat(document.documentElement.lang, { maximumFractionDigits: 2 })
      for (const el of els) {
        const rate = rates[el.dataset.fx!]
        if (!rate) continue
        const live = document.createElement('p')
        live.className = 'footnote rate live'
        live.textContent = el.dataset
          .template!.replace('{base}', base)
          .replace('{value}', format.format(rate))
          .replace('{quote}', el.dataset.fx!)
        el.after(live)
      }
    } catch {
      // No worker (plain dev server) or offline: the trip's own rate stands.
    }
  }

  document.addEventListener('astro:page-load', () => {
    setupFilters()
    void liveRates()
  })
</script>

<style>
  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-4);
  }

  .total {
    display: grid;
    align-content: start;
    gap: 4px;
  }

  .label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 12px;
  }

  .amount {
    font-family: var(--font-rounded);
    font-size: clamp(28px, 3.6vw, 38px);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .committed {
    color: var(--green);
  }

  .possible {
    color: var(--purple);
  }

  .currencies .list {
    display: grid;
    gap: 2px;
  }

  .currencies .list > li + li {
    border: 0;
  }

  .currency {
    font-size: 20px;
    font-weight: 600;
  }

  .rate {
    margin-top: 2px;
  }

  :global(.rate.live) {
    color: var(--tint);
    font-weight: 500;
  }

  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: var(--space-4);
  }

  .person {
    display: grid;
    gap: var(--space-3);
  }

  .person header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin: 0;
  }

  dd {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }

  .balance {
    padding: 6px 12px;
    border-radius: 10px;
    font-weight: 600;
    background: var(--fill);
  }

  [data-tone='owed'] .balance {
    color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, transparent);
  }

  [data-tone='owes'] .balance {
    color: var(--red);
    background: color-mix(in srgb, var(--red) 11%, transparent);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 var(--space-8);
  }

  .settlement :global(.arrow) {
    color: var(--label-tertiary);
  }

  .settle-amount {
    margin-left: auto;
    font-weight: 600;
  }

  .kinds {
    display: grid;
    gap: var(--space-4);
  }

  .stack {
    display: flex;
    gap: 2px;
    height: 14px;
    border-radius: 999px;
    overflow: hidden;
  }

  .stack span {
    min-width: 4px;
    background: var(--kind);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: 8px;
  }

  .swatch {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    color: var(--kind);
    background: color-mix(in srgb, var(--kind) 14%, transparent);
  }

  .share {
    margin-left: auto;
    font-weight: 600;
  }

  .section-header {
    flex-wrap: wrap;
  }

  .expense {
    color: var(--label);
    text-decoration: none;
  }

  .expense:hover {
    background: var(--fill);
    text-decoration: none;
  }

  .glyph {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    color: var(--kind);
    background: color-mix(in srgb, var(--kind) 14%, transparent);
  }

  .expense-main {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .expense-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .expense-amount {
    display: grid;
    justify-items: end;
    font-weight: 600;
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--orange);
  }

  .dot[data-committed] {
    border-color: var(--green);
    background: var(--green);
  }

  .empty {
    padding: var(--space-8) 0;
    text-align: center;
  }

  @media (max-width: 860px) {
    .totals,
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
