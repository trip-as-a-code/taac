---
import Icon from '@/components/Icon.astro'
import ThreadButton from '@/components/ThreadButton.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { tripPaths, tripPage } from '@/lib/paths'
import { taskTickItem } from '@/lib/deadlines'
import { initials, memberHue, memberName, partyLabel, people } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, date } = i18n
// Before, during or after the trip by when it's due or got done; a
// required task with no date is due by the start.
const phases = ['before', 'during', 'after', 'undated'] as const
const phaseOf = (task: (typeof trip.tasks)[number]) => {
  const day = task.done ?? task.due
  if (!day) return task.required ? 'before' : 'undated'
  if (trip.startDate && day < trip.startDate) return 'before'
  if (trip.endDate && day > trip.endDate) return 'after'
  return 'during'
}
// Each phase: open first, soonest due; then what got done, in order.
const byPhase = phases
  .map((phase) => ({
    phase,
    tasks: [
      ...trip.tasks
        .filter((x) => phaseOf(x) === phase && !x.done)
        .sort((a, b) => (a.due ?? '9999').localeCompare(b.due ?? '9999')),
      ...trip.tasks.filter((x) => phaseOf(x) === phase && x.done).sort((a, b) => a.done!.localeCompare(b.done!)),
    ],
  }))
  .filter((p) => p.tasks.length > 0)
const tasksDone = trip.tasks.filter((x) => x.done).length
const long = (day: string) => date(day, { day: 'numeric', month: 'long' })
const example = [
  'tasks:',
  `  - title: ${t('tasks.exampleTitle')}`,
  '    who: [everyone]',
  '    required: true',
  ...(trip.startDate ? [`    due: ${trip.startDate}`] : []),
].join('\n')
---

<TripLayout trip={trip} lang={lang} section="tasks">
  {trip.tasks.length === 0 ? (
    <div class="card card-pad none">
      <p class="secondary" set:html={t('tasks.none').replace(/`([^`]+)`/g, '<code>$1</code>')} />
      <pre class="example" lang="en"><code>{example}</code></pre>
    </div>
  ) : (
    <div
      data-tasks={trip.slug}
      data-lang={i18n.lang}
      data-names={JSON.stringify(Object.fromEntries(trip.members.map((m) => [m.id, m.name])))}
      data-logins={JSON.stringify(
        Object.fromEntries(trip.members.filter((m) => m.github).map((m) => [m.github!.toLowerCase(), m.name])),
      )}
      data-member-of={JSON.stringify(
        Object.fromEntries(trip.members.filter((m) => m.github).map((m) => [m.github!.toLowerCase(), m.id])),
      )}
      data-done-template={t('tasks.done')}
      data-ticked-by={t('packing.tickedBy')}
      data-ticked-for={t('packing.tickedFor')}
      data-done-by={t('tasks.doneBy')}
      data-not-yet={t('tasks.notYet')}
    >
      <p class="lede secondary">
        {t('tasks.lede')}{' '}
        <span
          class="badge"
          data-tone={tasksDone === trip.tasks.length ? 'green' : undefined}
          data-tasks-progress
          data-template={t('tasks.progress')}
        >
          {t('tasks.progress', { done: tasksDone, all: trip.tasks.length })}
        </span>
      </p>
      {byPhase.map(({ phase, tasks }) => (
        <section class="section" id={`tasks-${phase}`} data-day-section>
          <div class="section-header">
            <h2>{t(`tasks.${phase}`)}</h2>
          </div>
          <ul class="card list">
            {tasks.map((task) => (
              <li
                id={`task-${task.id}`}
                class="row task"
                data-presence
                data-people={people(task.members)}
                data-done={task.done ? '' : undefined}
                data-task-row={taskTickItem(task.id)}
                data-members={task.members.join(' ')}
                data-each={task.each ? '' : undefined}
                data-in-file={task.done ? '' : undefined}
                data-required-task={task.required ? '' : undefined}
              >
                {/* Done in the trip files stays done; otherwise a tick on the site, shared like packing. */}
                <button
                  type="button"
                  class="task-mark"
                  role="checkbox"
                  aria-checked={task.done ? 'true' : 'false'}
                  aria-label={task.title}
                  title={task.done ? t('tasks.inFile') : undefined}
                  disabled={Boolean(task.done)}
                  data-task-mark
                  data-required={task.required && !task.done ? '' : undefined}
                >
                  <Icon name="check" size={13} />
                </button>
                <span class="task-text">
                  <span class="subhead" lang={trip.locale}>
                    {task.title}
                  </span>
                  <span class="footnote secondary">
                    {partyLabel(trip, task.party, t('lens.everyone'), t('party.and'))}
                    {' · '}
                    <span data-task-status>
                      {task.done
                        ? t('tasks.done', { date: long(task.done) })
                        : task.due
                          ? t('tasks.due', { date: long(task.due) })
                          : task.required
                            ? t('tasks.beforeStart')
                            : t('tasks.open')}
                    </span>
                  </span>
                  <span class="footnote tertiary" data-task-by hidden />
                  {/* Each does it for themselves: who has, and a tap to tick for anyone. */}
                  {task.each && task.members.length > 1 && !task.done && (
                    <span class="doers">
                      {task.members.map((m) => (
                        <button
                          type="button"
                          class="doer"
                          data-doer={m}
                          aria-pressed="false"
                          style={`--hue:${memberHue(m)}`}
                          title={memberName(trip, m)}
                        >
                          {initials(trip.members.find((x) => x.id === m)!)}
                        </button>
                      ))}
                    </span>
                  )}
                  {task.notes && (
                    <span class="footnote secondary" lang={trip.locale}>
                      {task.notes}
                    </span>
                  )}
                </span>
                <ThreadButton anchor={`task:${task.id}`} title={task.title} i18n={i18n} />
                {task.required && (
                  <span class="badge" data-tone={task.done ? undefined : 'orange'} title={t('tasks.requiredHint')}>
                    {t('tasks.required')}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { revealTarget, setupFilters } from '@/scripts/filters'
  import { PackingStore } from '@/scripts/packing'
  import { me } from '@/scripts/session'

  const SHARED = '_'
  let stop: (() => void) | undefined

  /**
   * Ticks on the site, kept with the packing ticks: a shared task is done
   * with one tick (member `_`) by any of its people; one each does is done
   * once all have ticked theirs. Done in the trip files stays done.
   */
  function setupTicks() {
    stop?.()
    const root = document.querySelector<HTMLElement>('[data-tasks]')
    if (!root) return
    const d = root.dataset
    const names = JSON.parse(d.names ?? '{}') as Record<string, string>
    const logins = JSON.parse(d.logins ?? '{}') as Record<string, string>
    const memberOf = JSON.parse(d.memberOf ?? '{}') as Record<string, string>
    const ticker = (login: string) => logins[login] ?? `@${login}`
    const day = (at: number) => new Intl.DateTimeFormat(d.lang, { day: 'numeric', month: 'long' }).format(at)
    const rows = [...root.querySelectorAll<HTMLElement>('[data-task-row]')]
    const store = new PackingStore(d.tasks!, () => render())
    const statusText = new Map(rows.map((row) => [row, row.querySelector('[data-task-status]')!.textContent ?? '']))
    const membersOf = (row: HTMLElement) => row.dataset.members!.split(' ')
    // Whose tick the box is: everyone's on a shared task; on one each does,
    // the signed-in member's if it's theirs, else the only member's.
    const owner = (row: HTMLElement) => {
      if (!row.hasAttribute('data-each')) return SHARED
      const members = membersOf(row)
      const mine = store.login ? memberOf[store.login.toLowerCase()] : undefined
      if (mine && members.includes(mine)) return mine
      return members.length === 1 ? members[0] : undefined
    }
    const doneBy = (row: HTMLElement) => {
      const item = row.dataset.taskRow!
      return row.hasAttribute('data-each')
        ? membersOf(row).every((m) => store.packed(item, m))
        : store.packed(item, SHARED)
    }

    function render() {
      let done = 0
      for (const row of rows) {
        const item = row.dataset.taskRow!
        const inFile = row.hasAttribute('data-in-file')
        const isDone = inFile || doneBy(row)
        if (isDone) done++
        row.toggleAttribute('data-done', isDone)
        if (inFile) continue
        const mark = row.querySelector<HTMLButtonElement>('[data-task-mark]')!
        const who = owner(row)
        mark.disabled = !who || !store.available || !store.writable
        mark.setAttribute('aria-checked', String(who ? store.packed(item, who) : isDone))
        mark.toggleAttribute('data-required', row.hasAttribute('data-required-task') && !isDone)
        // When and by whom: the latest tick that did it.
        const keys = row.hasAttribute('data-each') ? membersOf(row) : [SHARED]
        const ticks = keys.flatMap((m) => {
          const tick = store.ticks[`${item}|${m}`]
          return tick ? [{ m, ...tick }] : []
        })
        const last = ticks.filter((x) => x.packed).sort((a, b) => b.at - a.at)[0]
        row.querySelector('[data-task-status]')!.textContent =
          isDone && last ? d.doneTemplate!.replace('{date}', day(last.at)) : statusText.get(row)!
        const by = row.querySelector<HTMLElement>('[data-task-by]')!
        by.textContent = ticks
          .filter((x) => x.by)
          .map((x) =>
            x.m === SHARED
              ? d.tickedBy!.replace('{by}', ticker(x.by!))
              : // Their own: just that it's done; for someone else: who ticked it.
                memberOf[x.by!.toLowerCase()] === x.m
                ? (x.packed ? d.doneBy! : d.notYet!).replace('{name}', names[x.m] ?? x.m)
                : d.tickedFor!.replace('{name}', names[x.m] ?? x.m).replace('{by}', ticker(x.by!)),
          )
          .join(' · ')
        by.hidden = !by.textContent
        for (const button of row.querySelectorAll<HTMLButtonElement>('[data-doer]')) {
          const m = button.dataset.doer!
          const ticked = store.packed(item, m)
          button.setAttribute('aria-pressed', String(ticked))
          button.disabled = !store.available || !store.writable
          button.setAttribute('aria-label', (ticked ? d.doneBy! : d.notYet!).replace('{name}', names[m] ?? m))
        }
      }
      const progress = root!.querySelector<HTMLElement>('[data-tasks-progress]')
      if (progress) {
        progress.textContent = progress.dataset
          .template!.replace('{done}', String(done))
          .replace('{all}', String(rows.length))
        progress.dataset.tone = done === rows.length ? 'green' : ''
      }
    }

    for (const row of rows) {
      const item = row.dataset.taskRow!
      row.querySelector<HTMLButtonElement>('[data-task-mark]')!.addEventListener('click', () => {
        const who = owner(row)
        if (who) store.set(item, who, !store.packed(item, who))
      })
      for (const button of row.querySelectorAll<HTMLButtonElement>('[data-doer]'))
        button.addEventListener('click', () =>
          store.set(item, button.dataset.doer!, !store.packed(item, button.dataset.doer!)),
        )
    }
    // Others tick too: catch up when the page comes back into view or online.
    const refresh = () => {
      if (document.visibilityState === 'visible') void store.sync()
    }
    document.addEventListener('visibilitychange', refresh)
    addEventListener('online', refresh)
    const timer = setInterval(refresh, 30_000)
    stop = () => {
      document.removeEventListener('visibilitychange', refresh)
      removeEventListener('online', refresh)
      clearInterval(timer)
    }
    render()
    void me().then((session) => {
      if (!session) return
      store.login = session.login
      store.writable = session.packing.includes(d.tasks!)
      render()
    })
    void store.sync()
  }

  onPage('tasks', () => {
    setupFilters(() => {})
    setupTicks()
    revealTarget()
  })
</script>

<style>
  .none {
    display: grid;
    gap: var(--space-3);
  }

  .example {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    background: var(--fill);
  }

  .lede {
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .task {
    gap: var(--space-3);
  }

  .task-text {
    display: grid;
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* A round checkbox, as a task's done mark: a finger-sized target around it. */
  .task-mark {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    color: transparent;
    background: transparent;
    border: 1.5px solid var(--separator-strong);
    border-radius: 50%;
    cursor: pointer;
  }

  .task-mark::after {
    content: '';
    position: absolute;
    inset: -11px;
  }

  .task-mark:disabled {
    cursor: default;
  }

  .task-mark:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--tint) 40%, transparent);
    outline-offset: 2px;
  }

  /* Under the text: whose share is done, a tap on one ticks it. */
  .doers {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: var(--space-2);
  }

  .doer {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1.5px dashed var(--separator-strong);
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    color: var(--label-tertiary);
    background: transparent;
    cursor: pointer;
  }

  .doer:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .doer[aria-pressed='true'] {
    border: 1.5px solid transparent;
    color: white;
    background: hsl(var(--hue) 55% 48%);
  }

  .task-mark[data-required] {
    border-color: var(--orange);
  }

  .task[data-done] .task-mark,
  .task-mark[aria-checked='true'] {
    color: white;
    background: var(--green);
    border-color: var(--green);
  }

  .task[data-done] .subhead {
    color: var(--label-secondary);
  }
</style>
