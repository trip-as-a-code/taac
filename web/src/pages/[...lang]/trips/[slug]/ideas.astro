---
import type { Idea } from '@taac/core'

import FilterBar from '@/components/FilterBar.astro'
import Icon from '@/components/Icon.astro'
import IdeaRow from '@/components/IdeaRow.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { ideaFacts } from '@/lib/facts'
import { tripPage, tripPaths } from '@/lib/paths'
import { anchor, ideasByArea, inBase, people } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, plural, dateRange } = i18n
const areas = [...ideasByArea(trip).entries()].sort(([a], [b]) => {
  // Areas in the order the trip visits them; ideas without one last.
  const first = (key: string) => trip.bases.find((base) => base.place === key)?.from ?? (key ? '9998' : '9999')
  return first(a).localeCompare(first(b))
})
// Ideas without a choice first, then each choice's alternatives together.
const choices = new Map(trip.choices.map((c) => [c.id, c]))
const items = new Map(trip.items.map((i) => [i.id, i]))
const groups = (ideas: Idea[]) => {
  const out: { choice?: (typeof trip.choices)[number]; ideas: Idea[] }[] = []
  const loose = ideas.filter((i) => !i.choice || !choices.has(i.choice))
  if (loose.length) out.push({ ideas: loose })
  for (const id of new Set(ideas.flatMap((i) => (i.choice && choices.has(i.choice) ? [i.choice] : []))))
    out.push({ choice: choices.get(id), ideas: ideas.filter((i) => i.choice === id) })
  return out
}
/** Plans have taken all a choice picks: its ideas are what wasn't chosen. */
const settled = (choice: (typeof trip.choices)[number]) => choice.settledBy.length >= choice.pick
// A starting point to copy, set in the first place the trip stays.
const firstArea = trip.bases[0] ? trip.places[trip.bases[0].place]?.name : undefined
const example = [
  'ideas:',
  `  - title: ${t('ideas.exampleTitle')}`,
  '    who: [everyone]',
  ...(firstArea ? [`    area: ${firstArea}`] : []),
  '    duration: halfDay',
].join('\n')
const visits = (area: string) =>
  trip.bases
    .filter((b) => inBase(trip, b, area))
    .sort((a, b) => a.from.localeCompare(b.from))
    .map((b) => ({ base: b, label: dateRange(b.from, b.to) }))
---

<TripLayout trip={trip} lang={lang} section="ideas">
  {trip.ideas.length === 0 ? (
    <div class="card card-pad none">
      <p class="secondary" set:html={t('ideas.none').replace(/`([^`]+)`/g, '<code>$1</code>')} />
      <pre class="example" lang="en"><code>{example}</code></pre>
    </div>
  ) : (
    <>
      <p class="lede secondary">{t('ideas.lede')}</p>
      <div class="toolbar">
        <FilterBar
          i18n={i18n}
          trip={trip}
          facts={trip.ideas.map((idea) => ideaFacts(trip, idea))}
          facets={['issue', 'priority', 'when', 'status', 'due', 'kind', 'cost', 'place', 'tag']}
          placeholder={t('filter.searchIdeas')}
        />
      </div>
      {areas.map(([area, ideas]) => {
        const place = area ? trip.places[area] : undefined
        const areaId = `area-${area ? anchor(area) : 'anywhere'}`
        return (
          <section class="section area" id={areaId} data-day-section>
            <div class="section-header">
              <h2 lang={trip.locale}>
                {place?.name ?? t('ideas.anywhere')}
                <a
                  class="anchor"
                  href={`#${areaId}`}
                  data-anchor
                  aria-label={t('item.copyLink')}
                  title={t('item.copyLink')}
                >
                  <Icon name="link" size={15} class="anchor-link" />
                  <Icon name="check" size={15} class="anchor-check" />
                </a>
              </h2>
              <span class="footnote secondary">{plural('ideas.count', ideas.length)}</span>
            </div>
            {area && visits(area).length > 0 && (
              <ul class="visits">
                {visits(area).map(({ base, label }) => (
                  <li class="footnote" data-presence data-people={people(base.members)}>
                    <Icon name="calendar" size={13} />
                    {label}
                  </li>
                ))}
              </ul>
            )}
            {/* A choice's alternatives sit together, to compare: how many to pick,
                and once plans settled it, what was chosen. */}
            {groups(ideas).map(({ choice, ideas: group }) => (
              <div class="card list" data-choice={choice?.id}>
                {choice && (
                  <header class="choice-head">
                    <p class="footnote choice-title" lang={trip.locale}>
                      ⇄{' '}
                      {settled(choice)
                        ? t('ideas.chosen', {
                            name: choice.name,
                            plans: choice.settledBy.map((id) => items.get(id)?.title ?? id).join(', '),
                          })
                        : t('ideas.pick', {
                            pick: choice.pick - choice.settledBy.length,
                            total: group.length,
                            name: choice.name,
                          })}
                    </p>
                    {!settled(choice) && <p class="footnote tertiary">{t('ideas.pickCounts')}</p>}
                  </header>
                )}
                {group.map((idea) => (
                  <IdeaRow
                    trip={trip}
                    idea={idea}
                    i18n={i18n}
                    grouped={Boolean(choice)}
                    notChosen={Boolean(choice && settled(choice))}
                  />
                ))}
              </div>
            ))}
          </section>
        )
      })}
      <p class="empty secondary" data-filter-empty hidden>
        {t('filter.empty')}
      </p>
    </>
  )}
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { revealTarget, setupFilters } from '@/scripts/filters'

  // An area with nothing left in view folds away.
  onPage('ideas', () => {
    setupFilters(() => {
      for (const section of document.querySelectorAll<HTMLElement>('[data-day-section]'))
        section.hidden = !section.querySelector('[data-item]:not([hidden])')
    })
    revealTarget()
  })
</script>

<style>
  .none {
    display: grid;
    gap: var(--space-3);
  }

  .example {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    background: var(--fill);
  }

  .lede {
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .area {
    margin-top: var(--space-8);
    scroll-margin-top: calc(var(--nav-height) + 64px);
  }

  .visits {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: -4px 0 var(--space-3);
    padding: 0;
  }

  .visits li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 999px;
    color: var(--tint);
    background: var(--tint-soft);
  }

  .list > :global(* + *) {
    border-top: 0.5px solid var(--separator);
  }

  .empty {
    padding: var(--space-12) 0;
    text-align: center;
  }

  .area .card + .card {
    margin-top: var(--space-3);
  }

  .choice-head {
    display: grid;
    gap: 2px;
    padding: 10px var(--space-4) 0;
  }

  .choice-head p {
    margin: 0;
  }

  .choice-title {
    font-weight: 600;
    color: var(--label-secondary);
  }

  /* A choice's whole card hides when the filters leave none of it. */
  .card.list:not(:has([data-item]:not([hidden]))) {
    display: none;
  }
</style>
