---
import Avatar from '@/components/Avatar.astro'
import Avatars from '@/components/Avatars.astro'
import Changes from '@/components/Changes.astro'
import Icon, { type IconName } from '@/components/Icon.astro'
import ItemRow from '@/components/ItemRow.astro'
import ProgressRing from '@/components/ProgressRing.astro'
import RouteStrip from '@/components/RouteStrip.astro'
import Skeleton from '@/components/Skeleton.astro'
import TodayCard from '@/components/TodayCard.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { isLabelled } from '@/lib/facts'
import { sourceHref, sourceLabel } from '@/lib/source'
import { tripPage, tripPaths } from '@/lib/paths'
import { bookable, groupLabel, homeOffset } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, plural, forms, path, number, date } = i18n
const base = `/trips/${trip.slug}`
const toBook = trip.items
  .filter((i) => i.booking.status === 'required')
  .sort((a, b) => (a.booking.deadline ?? '9999').localeCompare(b.booking.deadline ?? '9999'))
const needsBooking = bookable(trip)
const booked = needsBooking.filter((i) => i.booking.status === 'booked').length
// The soonest booking deadline still open, and how many fall on it.
const next = toBook.find((i) => i.booking.deadline)?.booking.deadline
const dueThen = toBook.filter((i) => i.booking.deadline === next).length
const placeCount = new Set(trip.items.flatMap((i) => i.places)).size
const currency = trip.currency?.base ?? 'EUR'
const offset = homeOffset(trip)
// Everything the validator flagged, plans first, in plan order.
const titles = new Map([...trip.items, ...trip.ideas, ...trip.tasks].map((i) => [i.id, i.title]))
const order = new Map(trip.items.map((i, n) => [i.id, n]))
// One snippet per entry: clashes with two blockers allow both at once.
function fixes(group: typeof trip.diagnostics) {
  const all = [...new Set(group.flatMap((d) => (d.fix ? [d.fix] : [])))]
  const allowed = all.map((f) => /^overrides: \[(.*)\]$/.exec(f)?.[1])
  return allowed.length > 1 && allowed.every(Boolean) ? [`overrides: [${allowed.join(', ')}]`] : all
}
// One entry per plan and kind of issue: a clash for two people is one clash.
const issues = [
  ...Map.groupBy(
    trip.diagnostics.toSorted((a, b) => (order.get(a.item ?? '') ?? Infinity) - (order.get(b.item ?? '') ?? Infinity)),
    (d) => `${d.item ?? ''}\u0000${d.code}${d.item ? '' : d.message}`,
  ).values(),
].map((group) => ({ ...group[0], all: group, fixes: fixes(group) }))
const sources = new Map([...trip.items, ...trip.ideas].map((i) => [i.id, i.source]))
// The interface's own words when the validator gave the specifics; its
// English message otherwise.
const detail = (d: (typeof trip.diagnostics)[number]) => {
  const key = `issue.${d.code}.detail`
  if (!d.params && !d.fix) return undefined
  if (!i18n.has(key)) return undefined
  const whose = d.params?.whose ? ` (${d.params.whose})` : ''
  // Dates read as dates, not ISO.
  const params = Object.fromEntries(
    Object.entries(d.params ?? {}).map(([k, v]) => [
      k,
      /^\d{4}-\d{2}-\d{2}$/.test(v) ? date(v, { day: 'numeric', month: 'long' }) : v,
    ]),
  )
  return t(key, { ...params, whose })
}
const issueLabel = (code: string) => (isLabelled(code) ? t(`issue.${code}`) : t('issue.other'))
const taskIds = new Set(trip.tasks.map((x) => x.id))
const issueHref = (id?: string) =>
  id && order.has(id)
    ? path(`${base}/itinerary/#item-${id}`)
    : id && taskIds.has(id)
      ? path(`${base}/tasks/#task-${id}`)
      : id && titles.has(id)
        ? path(`${base}/ideas/#idea-${id}`)
        : undefined

// Each file comes whole and per member or group (`<stem>-<who>.<ext>`); the
// page points at the one the people lens picks.
const files: { icon: IconName; label: string; stem: string; ext: string; one: string }[] = [
  { icon: 'calendar', label: t('trip.downloadIcs'), stem: 'calendar', ext: 'ics', one: t('trip.downloadIcsFor') },
  { icon: 'map', label: t('trip.downloadGeojson'), stem: 'map', ext: 'geojson', one: '' },
  { icon: 'wallet', label: t('trip.downloadBeancount'), stem: 'budget', ext: 'beancount', one: '' },
  { icon: 'note', label: t('trip.downloadMarkdown'), stem: 'itinerary', ext: 'md', one: '' },
]
const downloads = files.map((d) => ({ ...d, one: d.one || t('trip.exportFor', { label: d.label }) }))
---

<TripLayout trip={trip} lang={lang} section="overview">
  <TodayCard trip={trip} i18n={i18n} />
  <section class="intro">
    {trip.summary && (
      <p class="summary" lang={trip.locale}>
        {trip.summary}
      </p>
    )}
    {trip.startDate && trip.endDate && (
      <p
        class="status headline"
        data-trip-status
        data-start={trip.startDate}
        data-end={trip.endDate}
        data-before={t('trip.startsIn')}
        data-after={t('trip.endedOn')}
        data-during={t('trip.underway')}
      />
    )}
  </section>

  <section class="stats">
    <a class="stat card" href={path(`${base}/bookings/`)}>
      <Icon name="clock" size={20} />
      <span class="value tabular" data-fit data-stat="deadline">
        {next ? date(next, { day: 'numeric', month: 'short' }) : '—'}
      </span>
      <span
        class="label footnote secondary"
        data-stat="due"
        data-forms={forms('trip.nextDeadline')}
        data-none={t('trip.noDeadline')}
      >
        {next ? plural('trip.nextDeadline', dueThen) : t('trip.noDeadline')}
      </span>
    </a>
    <a class="stat card" href={path(`${base}/map/`)}>
      <Icon name="pin" size={20} />
      <span class="value tabular" data-fit data-stat="places">
        {number(placeCount)}
      </span>
      <span class="label footnote secondary">{plural('trip.places', placeCount).replace(/^[\d\s ]+/, '')}</span>
    </a>
    <a class="stat card" href={path(`${base}/bookings/`)}>
      <ProgressRing value={booked} total={needsBooking.length} />
      <span class="value tabular" data-fit>
        <span data-stat="booked">{booked}</span>
        <span class="of" data-stat="bookable">
          /{needsBooking.length}
        </span>
      </span>
      <span class="label footnote secondary">{t('trip.booked')}</span>
    </a>
    <a class="stat card" href={path(`${base}/budget/`)}>
      <Icon name="wallet" size={20} />
      {/* Totalled for whoever the people lens selects, once the script knows. */}
      <span class="value tabular" data-fit data-stat="budget" aria-busy="true">
        <Skeleton variant="inline" width="4.5em" height="0.9em" />
      </span>
      <span class="label footnote secondary">{t('trip.totalBudget')}</span>
    </a>
  </section>

  {issues.length > 0 && (
    <section class="section issues" id="issues">
      <div class="section-header">
        <h2>{t('issues.title')}</h2>
        <span class="badge" data-tone="orange">
          {issues.length}
        </span>
        <a class="subhead show" href={path(`${base}/itinerary/?issue=any`)}>
          {t('issues.show')}
        </a>
      </div>
      <p class="footnote secondary lede">{t('issues.lede')}</p>
      <ul class="card list">
        {issues.map((d, index) => {
          const href = issueHref(d.item)
          // Cards link here: the first entry of each plan is its anchor.
          const first = d.item && issues.findIndex((x) => x.item === d.item) === index
          const body = (
            <>
              <span class="issue-mark" data-severity={d.severity} aria-hidden="true">
                ⚠︎
              </span>
              <span class="issue-text">
                <span class="subhead">
                  {issueLabel(d.code)}
                  {d.item && titles.has(d.item) && (
                    <span class="secondary" lang={trip.locale}>
                      {' '}
                      · {titles.get(d.item)}
                    </span>
                  )}
                </span>
                {d.all.map((x) =>
                  detail(x) ? (
                    <span class="footnote secondary">{detail(x)}</span>
                  ) : (
                    <span class="footnote secondary" lang="en">
                      {x.message}
                    </span>
                  ),
                )}
              </span>
            </>
          )
          return (
            <li
              id={first ? `issue-${d.item}` : undefined}
              hidden={index >= 6 || undefined}
              data-more={index >= 6 ? '' : undefined}
            >
              {href ? (
                <a class="row issue" href={href}>
                  {body}
                </a>
              ) : (
                <div class="row issue">{body}</div>
              )}
              {(d.fixes.length > 0 || (d.item && sourceHref(sources.get(d.item)))) && (
                <div class="fix">
                  {d.fixes.map((fix) => (
                    <div class="snippet">
                      <pre lang="en"><code>{fix}</code></pre>
                      <button type="button" class="button button-plain copy" data-copy={fix}>
                        <Icon name="check" size={13} class="copied" />
                        <span data-label={t('issues.copy')} data-done={t('issues.copied')}>
                          {t('issues.copy')}
                        </span>
                      </button>
                    </div>
                  ))}
                  {d.item && sourceHref(sources.get(d.item)) && (
                    <a
                      class="footnote source"
                      href={sourceHref(sources.get(d.item))}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icon name="code" size={13} />
                      {t('issues.openSource', { file: sourceLabel(sources.get(d.item)!) })}
                    </a>
                  )}
                </div>
              )}
            </li>
          )
        })}
      </ul>
      {issues.length > 6 && (
        <button class="button button-plain more" type="button" data-issues-more>
          {t('issues.showAll', { n: issues.length })}
        </button>
      )}
    </section>
  )}

  <Changes trip={trip} i18n={i18n} />

  {trip.bases.length > 0 && (
    <section class="section">
      <div class="section-header">
        <h2>{t('trip.route')}</h2>
      </div>
      <RouteStrip trip={trip} i18n={i18n} />
    </section>
  )}

  <div class="columns">
    <section class="section">
      <div class="section-header">
        <h2>{t('trip.toBook')}</h2>
        {toBook.length > 0 && (
          <a class="subhead" href={path(`${base}/bookings/`)}>
            {t('trip.viewAll')}
          </a>
        )}
      </div>
      {toBook.length > 0 ? (
        <div class="card list">
          {toBook.slice(0, 4).map((item) => (
            <ItemRow trip={trip} item={item} i18n={i18n} withDate homeOffset={offset} />
          ))}
        </div>
      ) : (
        <p class="card card-pad all-booked">
          <Icon name="check" size={18} />
          {t('trip.allBooked')}
        </p>
      )}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>{t('trip.travellers')}</h2>
      </div>
      <ul class="card list people">
        {trip.members.map((member) => {
          const groups = trip.groups.filter((g) => g.members.includes(member.id))
          return (
            <li class="row">
              <Avatar member={member} />
              <div class="person">
                <span class="headline">{member.name}</span>
                {groups.length > 0 && (
                  <span class="footnote secondary">
                    {groups.map((g) => `${g.emoji ?? ''} ${groupLabel(trip, g, t('party.and'))}`.trim()).join(' · ')}
                  </span>
                )}
              </div>
              {member.links?.[0] && (
                <a class="link" href={member.links[0]} target="_blank" rel="noopener noreferrer">
                  <Icon name="link" size={16} />
                  <span class="visually-hidden">{member.name}</span>
                </a>
              )}
            </li>
          )
        })}
      </ul>
      {trip.groups.length > 0 && (
        <div class="groups">
          {trip.groups.map((group) => (
            <div class="group card card-pad">
              <div class="group-head">
                <span class="group-emoji">{group.emoji ?? '👥'}</span>
                <span class="headline">{groupLabel(trip, group, t('party.and'))}</span>
                <Avatars members={trip.members.filter((m) => group.members.includes(m.id))} size={22} />
              </div>
              {group.description && (
                <p class="footnote secondary" lang={trip.locale}>
                  {group.description}
                </p>
              )}
            </div>
          ))}
        </div>
      )}
    </section>
  </div>

  <section class="section">
    <div class="section-header">
      <h2>{t('trip.export')}</h2>
    </div>
    <div class="card list exports">
      <a
        class="row subscribe"
        href={`${base}/calendar.ics`}
        data-calendar-feed={trip.slug}
        data-subscribe
        data-export="calendar"
        data-ext="ics"
      >
        <span class="tile">
          <Icon name="calendar" size={18} />
        </span>
        <span class="export-text">
          <span class="headline" data-label-all={t('trip.subscribe')} data-label-one={t('trip.subscribeFor')}>
            {t('trip.subscribe')}
          </span>
          <span class="footnote secondary">{t('trip.subscribeHint')}</span>
        </span>
        <Icon name="chevronRight" size={16} class="chevron" />
      </a>
      {downloads.map((d) => (
        <a
          class="row"
          href={`${base}/${d.stem}.${d.ext}`}
          download={`${trip.slug}.${d.ext}`}
          data-calendar-feed={d.stem === 'calendar' ? trip.slug : undefined}
          data-export={d.stem}
          data-ext={d.ext}
        >
          <span class="tile muted">
            <Icon name={d.icon} size={18} />
          </span>
          <span class="export-text">
            <span data-label-all={d.label} data-label-one={d.one}>
              {d.label}
            </span>
          </span>
          <Icon name="download" size={16} class="chevron" />
        </a>
      ))}
    </div>
    {/* The files follow the people lens; say so, and say when a selection has none of its own. */}
    <p
      class="footnote secondary hint"
      data-export-hint
      data-pick={t('trip.exportPick')}
      data-for={t('trip.exportOnly')}
      data-none={t('trip.exportNone')}
    >
      {t('trip.exportPick')}
    </p>
    <p class="footnote tertiary hint">{t('trip.exportHint')}</p>
  </section>
  <script
    type="application/json"
    id="overview-data"
    set:html={JSON.stringify({
      currency,
      names: Object.fromEntries(trip.members.map((m) => [m.id, m.name])),
      // Selections with files of their own (`a`, `a~b` any of them, `a_b` together).
      exportKeys: Object.keys(trip.artifacts.byParty),
      together: t('lens.together').toLowerCase(),
      and: t('party.and'),
      items: trip.items.map((i) => ({
        people: i.members,
        places: i.places,
        status: i.booking.status,
        deadline: i.booking.deadline,
      })),
      days: trip.days.map((d) => ({
        people: [
          ...new Set([
            ...d.bases.flatMap((b) => b.members),
            ...d.items.flatMap((id) => trip.items.find((i) => i.id === id)?.members ?? []),
          ]),
        ],
      })),
      budget: { base: trip.budget.base, lines: trip.budget.lines, ideas: trip.budget.ideas },
    }).replace(/</g, '\\u003c')}
  />
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { revealTarget, setupFilters } from '@/scripts/filters'
  import { computeBudget, type BudgetData } from '@/scripts/budget'
  import { getLens, inLens, type Lens } from '@/scripts/lens'
  import { format, onMoney } from '@/scripts/money'
  import { renderRelativeDates, todayUTC } from '@/scripts/page'

  interface OverviewData {
    currency: string
    names: Record<string, string>
    exportKeys: string[]
    together: string
    and: string
    items: { people: string[]; places: string[]; status: string; deadline?: string }[]
    days: { people: string[] }[]
    budget: BudgetData
  }

  /** The stat tiles, route rows and calendar links for whoever the lens selects. */
  function follow(lens: Lens) {
    const raw = document.getElementById('overview-data')?.textContent
    if (!raw) return
    const data = JSON.parse(raw) as OverviewData
    const lang = document.documentElement.lang
    const items = data.items.filter((i) => inLens(i.people, lens))
    const set = (stat: string, text: string) => {
      const el = document.querySelector(`[data-stat="${stat}"]`)
      if (!el) return
      el.textContent = text
      el.removeAttribute('aria-busy')
    }
    const count = new Intl.NumberFormat(lang)
    const open = items.filter((i) => i.status === 'required' && i.deadline).map((i) => i.deadline!)
    const next = open.sort()[0]
    set(
      'deadline',
      next
        ? new Date(`${next}T00:00:00Z`).toLocaleDateString(lang, { day: 'numeric', month: 'short', timeZone: 'UTC' })
        : '—',
    )
    const due = document.querySelector<HTMLElement>('[data-stat="due"]')
    if (due) {
      const n = open.filter((d) => d === next).length
      const forms = JSON.parse(due.dataset.forms!) as Record<string, string>
      const form = forms[new Intl.PluralRules(lang).select(n)] ?? forms.other
      due.textContent = next ? form.replace('{n}', count.format(n)) : due.dataset.none!
    }
    set('places', count.format(new Set(items.flatMap((i) => i.places)).size))
    const bookable = items.filter((i) => i.status === 'booked' || i.status === 'required')
    const booked = bookable.filter((i) => i.status === 'booked').length
    set('booked', String(booked))
    set('bookable', `/${bookable.length}`)
    const ring = document.querySelectorAll<SVGCircleElement>('.ring circle')[1]
    if (ring) {
      const c = 2 * Math.PI * 9
      ring.setAttribute('stroke-dasharray', `${c * (bookable.length ? booked / bookable.length : 1)} ${c}`)
    }
    const budget = computeBudget(data.budget, lens, Object.keys(data.names))
    set('budget', `${budget.estimated ? '≈ ' : ''}${format(budget.planned, undefined, { maximumFractionDigits: 0 })}`)

    // Route rows read as "where is this person"; any overlap keeps a row.
    for (const el of document.querySelectorAll<HTMLElement>('[data-route-people]')) {
      const row = el.dataset.routePeople!.split(' ')
      el.hidden = lens.people.length > 0 && !lens.people.some((p) => row.includes(p))
    }

    // Whoever is selected, in either mode: their own files, where there are any.
    const order = Object.keys(data.names)
    const picked = order.filter((id) => lens.people.includes(id))
    const together = lens.mode === 'together' && picked.length > 1
    const key =
      picked.length === 1
        ? picked[0]!
        : picked.length === order.length && !together
          ? ''
          : picked.join(together ? '_' : '~')
    const whole = !picked.length || key === ''
    const party = !whole && data.exportKeys.includes(key) ? { id: key, label: '' } : undefined
    if (party) {
      const names = picked.map((id) => data.names[id] ?? id)
      party.label =
        (names.length > 1 ? `${names.slice(0, -1).join(', ')}${data.and}${names.at(-1)}` : names[0]!) +
        (together ? ` (${data.together})` : '')
    }
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-export]')) {
      const file = party
        ? `${link.dataset.export}-${party.id}.${link.dataset.ext}`
        : `${link.dataset.export}.${link.dataset.ext}`
      const url = new URL(link.href, location.href)
      url.protocol = location.protocol
      url.pathname = url.pathname.replace(/[^/]*$/, file)
      if (link.dataset.calendarKey) url.searchParams.set('key', link.dataset.calendarKey)
      link.href = link.hasAttribute('data-subscribe') ? url.href.replace(/^https?:/, 'webcal:') : url.href
      if (link.hasAttribute('download'))
        link.download = `${link.dataset.calendarFeed ?? document.querySelector<HTMLElement>('[data-calendar-feed]')?.dataset.calendarFeed ?? 'trip'}${party ? `-${party.id}` : ''}.${link.dataset.ext}`
      const label = link.querySelector<HTMLElement>('[data-label-all]')
      if (label)
        label.textContent = party ? label.dataset.labelOne!.replace('{name}', party.label) : label.dataset.labelAll!
    }
    const hint = document.querySelector<HTMLElement>('[data-export-hint]')
    if (hint)
      hint.textContent = whole
        ? hint.dataset.pick!
        : party
          ? hint.dataset.for!.replace('{name}', party.label)
          : hint.dataset.none!
  }

  function status() {
    const el = document.querySelector<HTMLElement>('[data-trip-status]')
    if (!el) return
    const { start, end, before, after, during } = el.dataset
    const today = todayUTC()
    const startMs = Date.parse(`${start}T00:00:00Z`)
    const endMs = Date.parse(`${end}T00:00:00Z`)
    el.dataset.phase = today < startMs ? 'before' : today > endMs ? 'after' : 'during'
    if (today < startMs) {
      el.dataset.relative = start
      el.dataset.template = before
    } else if (today > endMs) {
      el.dataset.relative = end
      el.dataset.template = after
    } else {
      el.textContent = during!.replace('{n}', String(Math.round((today - startMs) / 86_400_000) + 1))
      return
    }
    renderRelativeDates(el.parentElement!)
  }

  let offMoney: (() => void) | undefined

  /** The issues list: the rest folds open on request, or when a card links to an entry in it. */
  function issuesList() {
    const more = document.querySelector<HTMLButtonElement>('[data-issues-more]')
    const open = () => {
      for (const li of document.querySelectorAll<HTMLElement>('.issues [data-more]')) li.hidden = false
      more?.remove()
    }
    more?.addEventListener('click', open)
    const id = decodeURIComponent(location.hash.slice(1))
    const entry = id.startsWith('issue-') ? document.getElementById(id) : null
    if (!entry) return
    if (entry.hidden) open()
    entry.classList.remove('flash')
    void entry.offsetWidth
    entry.classList.add('flash')
    requestAnimationFrame(() => entry.scrollIntoView({ block: 'center' }))
  }

  /** Fix snippets copy with one tap. */
  function copyButtons() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('button.copy[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!)
        } catch {
          return
        }
        const label = button.querySelector<HTMLElement>('[data-label]')!
        button.classList.add('done')
        label.textContent = label.dataset.done!
        setTimeout(() => {
          button.classList.remove('done')
          label.textContent = label.dataset.label!
        }, 1600)
      })
    }
  }

  // Calendar keys arrive with the session, after the links were first set.
  document.addEventListener('taac:session', () => {
    if (document.querySelector<HTMLElement>('[data-section]')?.dataset.section === 'overview') follow(getLens())
  })

  onPage('overview', () => {
    status()
    copyButtons()
    // `webcal://` (set in follow) makes calendar apps subscribe, not import once.
    setupFilters((state) => follow(state.lens))
    issuesList()
    revealTarget()
    offMoney?.()
    offMoney = onMoney(() => follow(getLens()))
  })
</script>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    max-width: 68ch;
  }

  .summary {
    font-size: 19px;
    line-height: 1.45;
    color: var(--label-secondary);
  }

  /* A countdown is news, not an alarm: tinted only once the trip is on. */
  .status {
    color: var(--label-secondary);
  }

  .status[data-phase='during'] {
