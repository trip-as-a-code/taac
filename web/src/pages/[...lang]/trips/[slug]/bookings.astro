---
import type { Item } from '@taac/core'

import FilterBar from '@/components/FilterBar.astro'
import IdeaRow from '@/components/IdeaRow.astro'
import ItemRow from '@/components/ItemRow.astro'
import PassRow from '@/components/PassRow.astro'
import TripLayout from '@/layouts/TripLayout.astro'
import { ideaFacts, issuesOf, itemFacts } from '@/lib/facts'
import { tripPage, tripPaths } from '@/lib/paths'
import { bookable, homeOffset, passItem } from '@/lib/trip'

export const getStaticPaths = tripPaths

const { lang, i18n, trip } = tripPage(Astro.params, Astro.props)
const { t, plural, path, date } = i18n
const offset = homeOffset(trip)
const byDeadline = (a: (typeof trip.items)[number], b: (typeof trip.items)[number]) =>
  (a.booking.deadline ?? '9999').localeCompare(b.booking.deadline ?? '9999') || a.local.date.localeCompare(b.local.date)
const open = trip.items.filter((i) => i.booking.status === 'required').sort(byDeadline)
const dueGroups = [...Map.groupBy(open, (i) => i.booking.deadline ?? '').entries()]
const done = trip.items.filter((i) => i.booking.status === 'booked')
// Options that would need booking if chosen: decided before their deadline,
// not counted in the progress.
const options = trip.ideas
  .filter((i) => i.booking?.status === 'required')
  .sort((a, b) => (a.booking!.deadline ?? '9999').localeCompare(b.booking!.deadline ?? '9999'))
// Getting around: tickets and rentals, soonest first, with what they cost.
const firstDay = (pass: (typeof trip.passes)[number]) =>
  pass.shares.flatMap((share) => share.periods.map((p) => p.from)).sort()[0] ?? ''
const passes = trip.passes.toSorted((a, b) => firstDay(a).localeCompare(firstDay(b)))
const total = bookable(trip).length
const ratio = total ? done.length / total : 1
// Bookings the validator flagged: filter to them here, or read why in the list.
const flagged = [...open, ...done].filter((i) => issuesOf(trip, i.id).length > 0).length
---

<TripLayout trip={trip} lang={lang} section="bookings">
  {total === 0 ? (
    <p class="card card-pad secondary">{t('bookings.none')}</p>
  ) : (
    <>
      <section class="progress card card-pad">
        <div class="progress-head">
          <span class="title-2 tabular">{Math.round(ratio * 100)}%</span>
          <span class="subhead secondary">{t('bookings.progress', { done: done.length, total })}</span>
        </div>
        <div class="bar" role="progressbar" aria-valuemin={0} aria-valuemax={total} aria-valuenow={done.length}>
          <span style={`width:${ratio * 100}%`} />
        </div>
        {flagged > 0 && (
          <p class="attention footnote">
            <span class="flag">⚠︎ {plural('bookings.attention', flagged)}</span>
            <a href={path(`/trips/${trip.slug}/bookings/?issue=any`)}>{t('bookings.showFlagged')}</a>
            <a href={path(`/trips/${trip.slug}/#issues`)}>{t('issues.title')} →</a>
          </p>
        )}
      </section>

      <div class="toolbar">
        <FilterBar
          i18n={i18n}
          trip={trip}
          facts={[
            ...[...open, ...done].map((item) => itemFacts(trip, item)),
            ...options.map((idea) => ideaFacts(trip, idea)),
            ...passes.map((pass) => itemFacts(trip, passItem(pass, '') as Item)),
          ]}
          facets={['focus', 'issue', 'due', 'status', 'when', 'conflict', 'kind', 'cost', 'payer', 'place', 'tag']}
          placeholder={t('filter.searchPlans')}
        />
      </div>

      {open.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2>{t('bookings.open')}</h2>
            <span class="badge" data-tone="orange">
              {open.length}
            </span>
          </div>
          {/* The job here is "what do I book next": one group per deadline, soonest first. */}
          {dueGroups.map(([deadline, items]) => (
            <div class="due-group" data-due-group>
              <h3 class="due-head footnote">
                {deadline ? (
                  <>
                    <span class="tabular">
                      {t('bookings.by', { date: date(deadline, { day: 'numeric', month: 'long' }) })}
                    </span>
                    <time class="due-rel" data-relative={deadline} data-template="{rel}" />
                  </>
                ) : (
                  <span>{t('bookings.noDeadline')}</span>
                )}
                <span class="secondary tabular">{items.length}</span>
              </h3>
              <div class="card list">
                {items.map((item) => (
                  <ItemRow trip={trip} item={item} i18n={i18n} withDate homeOffset={offset} dueShown />
                ))}
              </div>
            </div>
          ))}
        </section>
      )}

      {options.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2>{t('bookings.options')}</h2>
            <span class="badge">{options.length}</span>
          </div>
          <div class="card list">
            {options.map((idea) => (
              <IdeaRow trip={trip} idea={idea} i18n={i18n} />
            ))}
          </div>
        </section>
      )}

      {passes.length > 0 && (
        <section class="section" id="passes">
          <div class="section-header">
            <h2>{t('passes.title')}</h2>
            <span class="badge">{passes.length}</span>
          </div>
          <div class="card list">
            {passes.map((pass) => (
              <PassRow trip={trip} pass={pass} i18n={i18n} />
            ))}
          </div>
        </section>
      )}

      {done.length > 0 && (
        <section class="section">
          <div class="section-header">
            <h2>{t('bookings.done')}</h2>
            <span class="badge" data-tone="green">
              {done.length}
            </span>
          </div>
          <div class="card list">
            {done.map((item) => (
              <ItemRow trip={trip} item={item} i18n={i18n} withDate homeOffset={offset} />
            ))}
          </div>
        </section>
      )}

      <p class="empty secondary" data-filter-empty hidden>
        {t('filter.empty')}
      </p>
    </>
  )}
</TripLayout>

<script>
  import { onPage } from '@/scripts/page'
  import { revealTarget, setupFilters } from '@/scripts/filters'

  onPage('bookings', () => {
    setupFilters(() => {
      for (const group of document.querySelectorAll<HTMLElement>('[data-due-group]'))
        group.hidden = !group.querySelector('[data-item]:not([hidden])')
      // Passes follow the people lens and step aside for any other filter.
      for (const section of document.querySelectorAll<HTMLElement>('.section'))
        section.hidden = !section.querySelector('[data-item]:not([hidden]), [data-presence]:not([hidden])')
    })
    revealTarget()
  })
</script>

<style>
  .progress {
    display: grid;
    gap: var(--space-3);
  }

  .progress-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .bar {
    height: 8px;
    border-radius: 999px;
    background: var(--fill);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--green), color-mix(in srgb, var(--green) 70%, var(--teal)));
    transition: width 600ms var(--ease-out);
  }

  .toolbar {
    margin-top: var(--space-6);
  }

  .section {
    margin-top: var(--space-6);
  }

  .toolbar + .section {
    margin-top: var(--space-8);
  }

  .list > :global(* + *) {
    border-top: 0.5px solid var(--separator);
  }

  .empty {
    padding: var(--space-12) 0;
    text-align: center;
  }

  .attention {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--space-4);
    margin: 0;
  }

  .attention .flag {
    font-weight: 600;
    color: var(--orange);
  }

  .attention a {
    font-weight: 600;
  }

  .due-group + .due-group {
    margin-top: var(--space-4);
  }

  .due-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    padding-inline: var(--space-4);
    font-weight: 600;
  }

  .due-rel {
    color: var(--orange);
  }

  .due-rel[data-days^='-'] {
    color: var(--red);
  }

  .due-head > :last-child {
    margin-left: auto;
  }
</style>
