---
import Icon from '@/components/Icon.astro'
import PushToggle from '@/components/PushToggle.astro'
import { langParams, localeFromParam, useI18n } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = () => langParams().map((params) => ({ params }))

const lang = localeFromParam(Astro.params.lang)
const { t, path } = useI18n(lang)
---

<BaseLayout
  lang={lang}
  title={t('notifications.allTitle')}
  navTitle={t('notifications.allTitle')}
  back={{ href: path('/'), label: t('nav.allTrips') }}
>
  <div class="container" data-notifications-page>
    <header class="hero">
      <h1 class="large-title" data-large-title>
        {t('notifications.allTitle')}
      </h1>
      {/* Two views of one page, so the back button moves between them. */}
      <nav class="segmented views" aria-label={t('notifications.allTitle')}>
        <a href="#" data-view="list" aria-current="page">
          {t('notifications.allTitle')}
        </a>
        <a href="#settings" data-view="settings">
          {t('notifications.settings')}
        </a>
      </nav>
    </header>
    <div class="view" data-view-panel="list">
      <div class="tools">
        <div class="segmented" role="group">
          <button type="button" data-filter="all" aria-pressed="true">
            {t('notifications.filterAll')}
          </button>
          <button type="button" data-filter="unread" aria-pressed="false">
            {t('notifications.filterUnread')}
          </button>
        </div>
        <button class="button button-plain" type="button" data-page-read-all hidden>
          <Icon name="check" size={16} />
          {t('notifications.readAll')}
        </button>
      </div>
      <div class="days" data-page-days></div>
      <p class="card card-pad secondary none" data-page-none hidden>
        {t('notifications.none')}
      </p>
      <button class="button more" type="button" data-page-more hidden>
        {t('notifications.more')}
      </button>
    </div>
    <div class="view" data-view-panel="settings" hidden>
      <section class="group">
        <h2 class="title-3">{t('settings.kinds')}</h2>
        <ul class="card list">
          {(['thread', 'reply', 'resolved', 'change'] as const).map((kind) => (
            <li class="row">
              <span class="grow" id={`kind-${kind}`}>
                {t(`settings.kind.${kind}`)}
              </span>
              <button
                class="switch"
                type="button"
                role="switch"
                aria-checked="true"
                aria-labelledby={`kind-${kind}`}
                data-kind-switch={kind}
              >
                <span class="knob" />
              </button>
            </li>
          ))}
        </ul>
        <p class="footnote secondary note">{t('settings.kindsNote')}</p>
      </section>
      <section class="group" data-push-section hidden>
        <h2 class="title-3">{t('settings.browser')}</h2>
        <div class="card">
          <PushToggle lang={lang} />
        </div>
        <p class="footnote secondary note">{t('notifications.device')}</p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { setupNotificationsPage } from '@/scripts/notifications'

  // `#settings` shows the settings, anything else the notifications.
  function showView() {
    const view = location.hash === '#settings' ? 'settings' : 'list'
    for (const panel of document.querySelectorAll<HTMLElement>('[data-view-panel]'))
      panel.hidden = panel.dataset.viewPanel !== view
    for (const tab of document.querySelectorAll<HTMLElement>('[data-view]'))
      if (tab.dataset.view === view) tab.setAttribute('aria-current', 'page')
      else tab.removeAttribute('aria-current')
  }

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-notifications-page]')) return
    showView()
    // The page router keeps same-page links to itself: switch here, in history too.
    for (const tab of document.querySelectorAll<HTMLAnchorElement>('[data-view]'))
      tab.addEventListener('click', (event) => {
        event.preventDefault()
        history.pushState(history.state, '', tab.dataset.view === 'settings' ? '#settings' : location.pathname)
        showView()
      })
    void setupNotificationsPage()
  })
  addEventListener('popstate', showView)
  addEventListener('hashchange', showView)
</script>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-12) var(--space-6);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  [hidden] {
    display: none !important;
  }

  .days {
    display: grid;
    gap: var(--space-8);
  }

  /* A day's notifications under its name, like the itinerary's days. */
  .days :global(.day),
  .day {
    display: grid;
    gap: var(--space-3);
  }

  .days :global(.day-title),
  .day-title {
    margin: 0;
  }

  .view {
    display: grid;
    gap: var(--space-6);
  }

  .views {
    justify-self: start;
  }

  .group {
    display: grid;
    gap: var(--space-3);
  }

  .group h2 {
    margin: 0;
  }

  .grow {
    flex: 1;
    min-width: 0;
  }

  .note {
    margin: 0;
    padding-inline: var(--space-4);
  }

  .more {
    justify-self: center;
    margin-top: var(--space-6);
  }

  .none {
    text-align: center;
  }

  .days :global(li) {
    position: relative;
  }

  .days :global(a) {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 2px var(--space-3);
    padding: 14px var(--space-4) 14px 40px;
    color: var(--label);
    text-decoration: none;
  }

  .days :global(a:hover) {
    background: var(--fill);
  }

  .days :global(.avatar) {
    grid-row: span 3;
    width: 44px;
    height: 44px;
    font-size: 17px;
  }

  .days :global(.title) {
    font-size: 17px;
    letter-spacing: -0.022em;
  }

  .days :global(li[data-unread] .title) {
    font-weight: 600;
  }

  .days :global(.text) {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--label-secondary);
  }

  /* The dot in the margin says unread, and is the switch: tap it to read; on
     a read one, a ring shows on hover to mark it unread again. */
  .days :global(.mark) {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 1;
    width: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .days :global(.mark)::after {
    content: '';
    position: absolute;
    top: 30px;
    left: 15px;
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--tint);
    border-radius: 50%;
    background: var(--tint);
    transition: opacity var(--duration) var(--ease);
  }

  .days :global(.mark[data-read])::after {
    background: transparent;
    opacity: 0;
  }

  .days :global(li:hover .mark[data-read])::after,
  .days :global(.mark[data-read]:focus-visible)::after {
    opacity: 0.6;
  }
</style>
