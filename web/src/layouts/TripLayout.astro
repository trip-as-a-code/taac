---
import type { TripExport } from '@taac/core'

import Avatars from '@/components/Avatars.astro'
import Icon, { type IconName } from '@/components/Icon.astro'
import CurrencyPicker from '@/components/CurrencyPicker.astro'
import PeopleLens from '@/components/PeopleLens.astro'
import { useI18n, type Locale } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { tripHue } from '@/lib/trip'

export type Section = 'overview' | 'itinerary' | 'ideas' | 'map' | 'bookings' | 'packing' | 'budget'

interface Props {
  trip: TripExport
  lang: Locale
  section: Section
  /** Full-bleed content (the map) without the trip header. */
  bare?: boolean
}

const { trip, lang, section, bare } = Astro.props
const i18n = useI18n(lang)
const { t, plural, dateRange, path } = i18n
const base = `/trips/${trip.slug}`
const sections: { id: Section; icon: IconName; href: string }[] = [
  { id: 'overview', icon: 'overview', href: path(`${base}/`) },
  { id: 'itinerary', icon: 'itinerary', href: path(`${base}/itinerary/`) },
  { id: 'map', icon: 'map', href: path(`${base}/map/`) },
  { id: 'bookings', icon: 'bookings', href: path(`${base}/bookings/`) },
  // Always there, even before the first idea: it explains what ideas are.
  { id: 'ideas', icon: 'sparkle', href: path(`${base}/ideas/`) },
  // Some things get bought before they can be packed: the budget comes last.
  { id: 'packing', icon: 'packing', href: path(`${base}/packing/`) },
  { id: 'budget', icon: 'budget', href: path(`${base}/budget/`) },
]
const current = t(`nav.${section}`)
---

<BaseLayout
  lang={lang}
  title={section === 'overview' ? trip.title : `${current} · ${trip.title}`}
  description={trip.summary}
  navTitle={trip.title}
  back={{ href: path('/'), label: t('nav.allTrips') }}
  wide={bare}
>
  <div class="trip" data-section={section} style={`--hue:${tripHue(trip)}`}>
    {!bare && (
      <header class:list={['container trip-header', { compact: section !== 'overview' }]}>
        <div class="cover-chip" transition:name={`cover-${trip.slug}`} aria-hidden="true">
          {trip.cover?.emoji ?? '🧭'}
        </div>
        <div class="heading">
          <h1 class="large-title" data-large-title lang={trip.locale}>
            {section === 'overview' ? trip.title : current}
          </h1>
          <p class="subhead secondary meta">
            {section !== 'overview' && <span lang={trip.locale}>{trip.title}</span>}
            <span class="dates">{dateRange(trip.startDate, trip.endDate)}</span>
            <span class="dates">{plural('trip.days', trip.days.length)}</span>
            <Avatars members={trip.members} size={22} />
          </p>
        </div>
      </header>
    )}
    <nav class="tabs" aria-label={t('nav.sections')}>
      <div class="container">
        <div class="segmented tab-bar">
          {sections.map((s) => (
            <a href={s.href} aria-current={s.id === section ? 'page' : undefined}>
              <Icon name={s.icon} size={16} />
              <span>{t(`nav.${s.id}`)}</span>
            </a>
          ))}
        </div>
        <div class="tools">
          <PeopleLens trip={trip} i18n={i18n} plans={['itinerary', 'bookings', 'map'].includes(section)} />
          <CurrencyPicker trip={trip} i18n={i18n} />
        </div>
      </div>
    </nav>
    <div class:list={[bare ? 'bare' : 'container content']}>
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .trip-header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-5);
    padding-block: var(--space-10) var(--space-6);
  }

  .cover-chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    font-size: 40px;
    background: linear-gradient(160deg, hsl(var(--hue) 85% 70%), hsl(calc(var(--hue) + 25) 75% 45%));
    box-shadow:
      0 10px 30px hsl(var(--hue) 60% 40% / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
  }

  .heading {
    min-width: 0;
  }

  .heading h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: var(--space-2);
  }

  .meta > span + span::before {
    content: '·';
    margin-right: 14px;
    color: var(--label-tertiary);
  }

  .tabs {
    position: sticky;
    top: calc(var(--nav-height) + env(safe-area-inset-top));
    z-index: 40;
    padding-block: var(--space-2);
    background: var(--material);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 0.5px solid var(--separator);
  }

  .tabs .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  /* One row at every width; it scrolls sideways rather than wrapping. The
     block padding keeps focus rings clear of the scroll clip. */
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    max-width: 100%;
    padding-block: 3px;
    margin-block: -3px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tools::-webkit-scrollbar {
    display: none;
  }

  .tools > :global(*) {
    flex: none;
  }

  .tab-bar {
    display: flex;
    width: max-content;
    max-width: 100%;
  }

  .tab-bar a {
    min-height: 32px;
    padding-inline: 14px;
    font-size: 14px;
  }

  .content {
    padding-top: var(--space-6);
  }

  @media (max-width: 640px) {
    .meta > span + span::before {
      display: none;
    }

    .trip-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      padding-top: var(--space-6);
    }

    .cover-chip {
      width: 60px;
      height: 60px;
      border-radius: 17px;
      font-size: 32px;
    }

    /* Sub-pages: the section is the title; the trip is one quiet line. */
    .trip-header.compact {
      padding-block: var(--space-5) var(--space-2);
    }

    .compact .cover-chip,
    .compact .meta :global(.avatars),
    .compact .meta .dates {
      display: none;
    }

    .compact .heading h1 {
      font-size: 32px;
    }

    .compact .meta span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* Phones: sections move to a bottom tab bar; the people and currency row
     scrolls with the page instead of eating the top of the screen. */
  @media (max-width: 760px) {
    .trip {
      padding-bottom: calc(60px + env(safe-area-inset-bottom));
    }

    .tabs {
      position: static;
      padding-block: var(--space-2) var(--space-3);
      background: transparent;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-bottom: 0;
    }

    .tools {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
    }

    .content {
      padding-top: var(--space-3);
    }

    .tab-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 55;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      width: auto;
      max-width: none;
      gap: 0;
      padding: 4px 4px calc(4px + env(safe-area-inset-bottom));
      border-radius: 0;
      background: var(--material-thick);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
      border-top: 0.5px solid var(--separator);
    }

    .tab-bar a,
    .tab-bar a[aria-current] {
      flex-direction: column;
      gap: 3px;
      min-height: 50px;
      padding: 5px 0 3px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--label-tertiary);
      background: transparent;
      box-shadow: none;
    }

    .tab-bar a[aria-current] {
      color: var(--tint);
    }

    .tab-bar a :global(svg) {
      width: 23px;
      height: 23px;
    }

    .tab-bar a span {
      display: block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Seven tabs on the narrowest phones: the labels tighten to fit. */
  @media (max-width: 360px) {
    .tab-bar {
      padding-inline: 2px;
    }

    .tab-bar a {
      font-size: 9.5px;
      letter-spacing: -0.15px;
    }

    :global(.toast) {
      bottom: calc(72px + env(safe-area-inset-bottom)) !important;
    }
  }
</style>
