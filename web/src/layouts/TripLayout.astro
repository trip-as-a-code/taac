---
import type { TripExport } from '@taac/core'

import Icon, { type IconName } from '@/components/Icon.astro'
import CurrencyPicker from '@/components/CurrencyPicker.astro'
import Discussions from '@/components/Discussions.astro'
import LensMode from '@/components/LensMode.astro'
import PeopleLens from '@/components/PeopleLens.astro'
import ShareLinks from '@/components/ShareLinks.astro'
import { useI18n, type Locale } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { changes } from '@/lib/build'
import { tripHue } from '@/lib/trip'

export type Section =
  'overview' | 'itinerary' | 'ideas' | 'map' | 'bookings' | 'tasks' | 'packing' | 'budget' | 'discussions'

interface Props {
  trip: TripExport
  lang: Locale
  section: Section
  /** Full-bleed content (the map) without the trip header. */
  bare?: boolean
}

const { trip, lang, section, bare } = Astro.props
const i18n = useI18n(lang)
const { t, plural, dateRange, path } = i18n
const base = `/trips/${trip.slug}`
const sections: { id: Section; icon: IconName; href: string }[] = [
  { id: 'overview', icon: 'overview', href: path(`${base}/`) },
  // The planning pipeline: ideas become plans, plans get booked, and the
  // budget adds it all up last. The map sits with the plans it shows.
  // Ideas are always there, even before the first one: the page explains them.
  { id: 'ideas', icon: 'sparkle', href: path(`${base}/ideas/`) },
  { id: 'itinerary', icon: 'itinerary', href: path(`${base}/itinerary/`) },
  { id: 'map', icon: 'map', href: path(`${base}/map/`) },
  { id: 'bookings', icon: 'bookings', href: path(`${base}/bookings/`) },
  // What to get done around the plans (a visa first), then what to pack.
  { id: 'tasks', icon: 'tasks', href: path(`${base}/tasks/`) },
  // Some things get bought before they can be packed: the budget comes last.
  { id: 'packing', icon: 'packing', href: path(`${base}/packing/`) },
  { id: 'budget', icon: 'budget', href: path(`${base}/budget/`) },
  // Talking it over, about any of the above.
  { id: 'discussions', icon: 'chat', href: path(`${base}/discussions/`) },
]
const current = t(`nav.${section}`)
// When each plan or idea last changed, for the "since your last visit" dots.
const changedAt: Record<string, string> = {}
for (const set of (changes[trip.slug] ?? []).toReversed())
  for (const e of set.events) if (e.kind !== 'removed' && e.kind !== 'ideaRemoved') changedAt[e.id] = set.date
---

<BaseLayout
  lang={lang}
  title={section === 'overview' ? trip.title : `${current} · ${trip.title}`}
  description={trip.summary}
  navTitle={trip.title}
  back={{ href: path('/'), label: t('nav.allTrips') }}
  wide={bare}
>
  <ShareLinks trip={trip} i18n={i18n} slot="nav" />
  <Discussions trip={trip} i18n={i18n} />
  <CurrencyPicker trip={trip} i18n={i18n} slot="nav" />
  <div class="trip" data-section={section} style={`--hue:${tripHue(trip)}`}>
    {!bare && (
      <header class:list={['container trip-header', { compact: section !== 'overview' }]}>
        <div class="cover-chip" transition:name={`cover-${trip.slug}`} aria-hidden="true">
          {trip.cover?.emoji ?? '🧭'}
        </div>
        <div class="heading">
          <h1 class="large-title" data-large-title lang={trip.locale}>
            {section === 'overview' ? trip.title : current}
          </h1>
          <p class="subhead secondary meta">
            {section !== 'overview' && <span lang={trip.locale}>{trip.title}</span>}
            <span class="dates">{dateRange(trip.startDate, trip.endDate)}</span>
            <span class="dates">{plural('trip.days', trip.days.length)}</span>
          </p>
        </div>
      </header>
    )}
    <nav class="tabs" aria-label={t('nav.sections')}>
      <div class="container">
        <div class="segmented tab-bar">
          {sections.map((s) => (
            <a
              href={s.href}
              aria-current={s.id === section ? 'page' : undefined}
              data-discussions-tab={s.id === 'discussions' ? '' : undefined}
            >
              <Icon name={s.icon} size={16} />
              <span>{t(`nav.${s.id}`)}</span>
              {s.id === 'discussions' && <span class="tab-count" data-discussions-count />}
            </a>
          ))}
        </div>
        <div class="tools">
          <PeopleLens trip={trip} i18n={i18n} plans={['ideas', 'itinerary', 'bookings', 'map'].includes(section)} />
        </div>
        <LensMode i18n={i18n} />
      </div>
    </nav>
    <div class:list={[bare ? 'bare' : 'container content']}>
      <slot />
    </div>
    <script
      type="application/json"
      data-changed-at={trip.slug}
      data-label={t('changes.since')}
      set:html={JSON.stringify(changedAt)}
    />
  </div>
</BaseLayout>

<script>
  import { sinceLastVisit } from '@/scripts/seen'

  // A dot on every plan and idea that changed since this browser's last visit.
  document.addEventListener('astro:page-load', () => {
    const data = document.querySelector<HTMLElement>('[data-changed-at]')
    if (!data) return
    const since = sinceLastVisit(data.dataset.changedAt!)
    if (!since) return
    const at = JSON.parse(data.textContent ?? '{}') as Record<string, string>
    for (const [id, when] of Object.entries(at)) {
      if (when <= since) continue
      for (const el of document.querySelectorAll<HTMLElement>(`#item-${CSS.escape(id)}, #idea-${CSS.escape(id)}`)) {
        el.dataset.changed = ''
        el.querySelector('h3')?.setAttribute('data-tip', data.dataset.label!)
      }
    }
  })
</script>

<style>
  .trip-header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-5);
    padding-block: var(--space-10) var(--space-6);
  }

  .cover-chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 22px;
    font-size: 40px;
    background: linear-gradient(160deg, hsl(var(--hue) 85% 70%), hsl(calc(var(--hue) + 25) 75% 45%));
    box-shadow:
      0 10px 30px hsl(var(--hue) 60% 40% / 0.3),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
  }

  .heading {
    min-width: 0;
  }

  /* Sub-pages: the section is the title, the trip a quiet line under it. */
  .trip-header.compact {
    padding-block: var(--space-6) var(--space-4);
  }

  .compact .cover-chip {
    width: 52px;
    height: 52px;
    border-radius: 15px;
    font-size: 28px;
  }

  .compact .heading h1 {
    font-size: clamp(26px, 3.4vw, 34px);
  }

  .heading h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: var(--space-2);
  }

  .meta > span + span::before {
    content: '·';
    margin-right: 14px;
    color: var(--label-tertiary);
  }

  .tabs {
    position: sticky;
    top: calc(var(--nav-height) + env(safe-area-inset-top));
    z-index: 40;
    padding-block: var(--space-2);
    background: var(--material);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 0.5px solid var(--separator);
  }

  .tabs .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  /* One row at every width; it scrolls sideways rather than wrapping. The
     block padding keeps focus rings clear of the scroll clip. */
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    max-width: 100%;
    padding-block: 3px;
    margin-block: -3px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tools::-webkit-scrollbar {
    display: none;
  }

  .tools > :global(*) {
    flex: none;
  }

  .tab-bar {
    display: flex;
    width: max-content;
    max-width: 100%;
  }

  .tab-bar a {
    min-height: 32px;
    padding-inline: 14px;
    font-size: 14px;
  }

  /* Open discussions on the Discussions tab. */
  .tab-bar a .tab-count {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--tint);
    color: var(--label-on-tint);
    font-size: 11px;
    font-weight: 600;
  }

  .tab-bar a .tab-count:empty {
    display: none;
  }

  .content {
    padding-top: var(--space-6);
  }

  @media (max-width: 640px) {
    .meta > span + span::before {
      display: none;
    }

    .trip-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      padding-top: var(--space-6);
    }

    .cover-chip {
      width: 60px;
      height: 60px;
      border-radius: 17px;
      font-size: 32px;
    }

    /* Sub-pages: one line, the section; the trip's name is in the nav bar. */
    .trip-header.compact {
      padding-block: var(--space-4) 0;
    }

    .compact .cover-chip,
    .compact .meta {
      display: none;
    }

    .compact .heading h1 {
      font-size: 26px;
    }
  }

  /* Phones: sections move to a bottom tab bar. */
  @media (max-width: 760px) {
    .trip {
      padding-bottom: calc(60px + env(safe-area-inset-bottom));
    }

    /* What's left up top is the people row: it stays in view, so the
       current selection is never a surprise further down. */
    .tabs {
      padding-block: var(--space-2);
      background: var(--bg);
      /* A backdrop filter would make it the bottom tab bar's containing block. */
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    /* Fades at the edge: there is more to swipe to. */
    .tools {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
    }

    .content {
      padding-top: var(--space-3);
    }

    .tab-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 55;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      width: auto;
      max-width: none;
      gap: 0;
      padding: 4px 4px calc(4px + env(safe-area-inset-bottom));
      border-radius: 0;
      background: var(--material-thick);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
      border-top: 0.5px solid var(--separator);
    }

    .tab-bar a,
    .tab-bar a[aria-current] {
      flex-direction: column;
      gap: 3px;
      min-height: 50px;
      padding: 5px 0 3px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--label-tertiary);
      background: transparent;
      box-shadow: none;
    }

    .tab-bar a[aria-current] {
      color: var(--tint);
    }

    .tab-bar a :global(svg) {
      width: 23px;
      height: 23px;
    }

    .tab-bar a span {
      display: block;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tab-bar a {
      position: relative;
    }

    .tab-bar a .tab-count {
      position: absolute;
      top: 2px;
      left: calc(50% + 6px);
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      font-size: 10px;
    }
  }

  /* Eight tabs on the narrowest phones: the labels tighten to fit. */
  @media (max-width: 360px) {
    .tab-bar {
      padding-inline: 2px;
    }

    .tab-bar a {
      font-size: 9.5px;
      letter-spacing: -0.15px;
    }

    :global(.toast) {
      bottom: calc(72px + env(safe-area-inset-bottom)) !important;
    }
  }
</style>
