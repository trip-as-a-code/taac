---
import { ClientRouter } from 'astro:transitions'

import PushPrompt from '@/components/PushPrompt.astro'
import NavBar from '@/components/NavBar.astro'
import UpdateToast from '@/components/UpdateToast.astro'
import { localeFromParam, localized, type Locale } from '@/i18n'
import { buildId, site } from '@/lib/build'
import '@/styles/global.css'

interface Props {
  lang: Locale
  title?: string
  description?: string
  /** Shown centred in the navigation bar once the large title scrolls away. */
  navTitle?: string
  back?: { href: string; label: string }
  /** Language of the trip's own text, when it differs from the UI. */
  contentLang?: string
  wide?: boolean
}

const { lang = localeFromParam(undefined), title, description, navTitle, back, wide } = Astro.props
const siteTitle = localized(site.site.title, lang)
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle
---

<!doctype html>
<html lang={lang} data-build={buildId} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="generator" content={Astro.generator} />
    {/*
      A remembered or linked filter is applied by scripts/filters.ts after the
      page shows: until then the trip's content stays invisible rather than
      showing everyone's plans for a moment (also after client navigation).
    */}
    <script is:inline>
      ;(() => {
        const check = () => {
          const slug = decodeURIComponent(location.pathname.match(/\/trips\/([^/]+)/)?.[1] ?? '')
          if (!slug) return
          let pending = [...new URLSearchParams(location.search).keys()].some((k) => k !== 'mode')
          if (!pending)
            try {
              const lens = JSON.parse(localStorage.getItem(`taac:lens:${slug}`) ?? 'null')
              pending = Boolean(lens?.people?.length || lens?.unassigned)
            } catch {
              // No storage: nothing remembered.
            }
          if (!pending) return
          const root = document.documentElement
          root.setAttribute('data-filter-pending', '')
          setTimeout(() => root.removeAttribute('data-filter-pending'), 1500)
        }
        check()
        document.addEventListener('astro:after-swap', check)
      })()
    </script>
    <script is:inline>
      // The theme is the viewer's choice (dark unless they pick light), set
      // before paint and again after each client-side page swap, which
      // replaces <html>'s attributes.
      ;(() => {
        const apply = () => {
          let theme = 'dark'
          try {
            theme = localStorage.getItem('taac:theme') === 'light' ? 'light' : 'dark'
          } catch {
            // Storage blocked: dark it is.
          }
          document.documentElement.dataset.theme = theme
          // Signed in (the session cookie itself is HttpOnly): the sign-out button shows at once.
          document.documentElement.toggleAttribute('data-auth', /(?:^|; )taac_signed_in=1/.test(document.cookie))
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', theme === 'dark' ? '#000000' : '#f5f5f7')
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    <script is:inline>
      // Without the edge worker (plain `astro dev`/static hosting) honour a
      // remembered language here; the worker redirects before HTML loads.
      ;(() => {
        try {
          const saved = document.cookie.match(/(?:^|; )taac_lang=(\w+)/)?.[1] ?? localStorage.getItem('taac_lang')
          const path = location.pathname
          const prefixed = /^\/ru(\/|$)/.test(path)
          if (saved === 'ru' && !prefixed && document.documentElement.lang === 'en')
            location.replace('/ru' + (path === '/' ? '/' : path) + location.search + location.hash)
        } catch {
          // Storage or cookies blocked: stay on the default locale.
        }
      })()
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content'}
    </a>
    <PushPrompt lang={lang} />
    <NavBar lang={lang} title={navTitle} back={back}>
      <slot name="nav" slot="tools" />
    </NavBar>
    <main id="main" class:list={{ wide }}>
      <slot />
    </main>
    <UpdateToast lang={lang} />
    {/*
      Static pages can't know today's date: fill the trip's phase, every
      relative date and what depends on the day while the page is still
      parsing, so they are right on the first paint.
    */}
    <script is:inline>
      ;(() => {
        const now = new Date()
        const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
        const day = (iso) => Date.parse(`${iso}T00:00:00Z`)
        const status = document.querySelector('[data-trip-status]')
        if (status) {
          const { start, end, before, after, during } = status.dataset
          status.dataset.phase = today < day(start) ? 'before' : today > day(end) ? 'after' : 'during'
          if (today < day(start)) Object.assign(status.dataset, { relative: start, template: before })
          else if (today > day(end)) Object.assign(status.dataset, { relative: end, template: after })
          else status.textContent = during.replace('{n}', String(Math.round((today - day(start)) / 86_400_000) + 1))
        }
        // What depends on the day: shown from (`data-show-from`) or until
        // (`data-show-until`) a date, such as a charge awaiting confirmation.
        const iso = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
        for (const el of document.querySelectorAll('[data-show-from]')) el.hidden = iso < el.dataset.showFrom
        for (const el of document.querySelectorAll('[data-show-until]')) el.hidden = iso >= el.dataset.showUntil
        const rtf = new Intl.RelativeTimeFormat(document.documentElement.lang, { numeric: 'auto' })
        for (const el of document.querySelectorAll('[data-relative]')) {
          const days = Math.round((day(el.dataset.relative) - today) / 86_400_000)
          const rel = Math.abs(days) >= 60 ? rtf.format(Math.round(days / 30), 'month') : rtf.format(days, 'day')
          el.textContent = (el.dataset.template ?? '{rel}').replace('{rel}', rel)
          el.dataset.days = String(days)
        }
      })()
    </script>
  </body>
</html>

<script>
  import { setupPage } from '@/scripts/page'

  document.addEventListener('astro:page-load', setupPage)
</script>

<style>
  .skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--tint);
    color: white;
    transition: top var(--duration) var(--ease);
  }

  .skip-link:focus {
    top: 10px;
  }

  main {
    /* Horizontal scrollers (day strip, route) must never widen the page;
       clip, unlike hidden, keeps sticky headers working. */
    overflow-x: clip;
    padding-bottom: calc(var(--space-16) + env(safe-area-inset-bottom));
  }

  main.wide {
    padding-bottom: 0;
  }
</style>
