{
  // Template for deploying your own taac site to Cloudflare Workers.
  // Copy to wrangler.jsonc next to your site.yaml, adjust the paths and name,
  // build the site (TAAC_SITE=path/to/site.yaml npm run build -w @taac/web),
  // then `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-trips",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-01",

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The worker sees every request first: it enforces passwords, so assets
    // must never be served around it.
    "run_worker_first": true,
  },

  // Throttles password attempts per IP and scope. Optional: without the
  // binding, logins are not rate-limited.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Passwords are optional and configured in site.yaml (`access.password.secret`
  // for the whole site, `trips[].access.password.secret` per trip). Each named
  // secret, plus SESSION_SECRET (`openssl rand -hex 32`, signs login cookies
  // and calendar keys), is set with:
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put SITE_PASSWORD
  // Secrets are never committed. For `wrangler dev`, put them in .dev.vars.
  // A deployment that names a password secret but lacks it refuses to serve.

  "vars": {
    // "true" adds noindex headers even without passwords (passwords imply it).
    "NOINDEX": "false",
  },

  // Serve on your own domain (the zone must be on your Cloudflare account):
  // "routes": [{ "pattern": "trips.example.com", "custom_domain": true }],
  // "workers_dev": false,
}
